---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Stefano Carlo Lambertenghi — Researcher at fortiss, PhD candidate at TUM',
  description = 'Researcher at fortiss, PhD candidate at TUM, and technical lead for the Fortuna autonomous-driving research vehicle.',
  image = '/social-card.svg',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Stefano Carlo Lambertenghi',
  url: Astro.site,
  jobTitle: 'Researcher / Technical Lead, Fortuna',
  affiliation: [
    { '@type': 'Organization', name: 'fortiss' },
    { '@type': 'CollegeOrUniversity', name: 'Technical University of Munich' },
  ],
  sameAs: [
    'https://github.com/steflamb',
    'https://dblp.org/pid/341/5500',
    'https://www.linkedin.com/in/stefano-carlo-lambertenghi-a30b9592/',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101311" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('has-js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
