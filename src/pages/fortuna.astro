---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publications } from '../data/site';

const realityGapPaper = publications.find((p) => p.title.startsWith('A Multi-Modality Evaluation'))!;
---

<BaseLayout
  title="Fortuna — Stefano Carlo Lambertenghi"
  description="The story and architecture of Fortuna, fortiss's full-scale autonomous-driving research vehicle."
>
  <section class="page-hero">
    <div class="page-hero-inner fortuna-hero-grid container-wide">
      <div>
        <h1 class="page-title">A street-legal <em>research vehicle.</em></h1>
      </div>
      <div>
        <div class="fortuna-photo">
          <img
            src="/images/fortuna-profile.png"
            alt="Fortuna, fortiss's modified Passat GTE, with its roof-mounted camera and LiDAR sensor rack"
            width="775"
            height="435"
            loading="eager"
          />
        </div>
        <div class="page-hero-copy">
          <p>
            When I started working with Fortuna in 2023, it had been inactive for more than a
            year. I took responsibility for bringing it back into operation and making it usable
            for research again.
          </p>
          <p>
            Today I lead the technical work around the vehicle. We use it for research on
            autonomous-driving testing, simulation, and real-world validation. Several students
            and researchers contribute to the platform and use it for their own work.
          </p>
          <div class="page-hero-meta">
            <span class="tag">2018 VW Passat Variant GTE</span>
            <span class="tag">Cameras + 3 LiDARs</span>
            <span class="tag">Drive-by-wire</span>
            <span class="tag">ROS</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="metrics-strip" aria-label="Fortuna platform summary">
    <div class="metric-card"><strong>5</strong><span>Cameras, for visual perception and end-to-end driving</span></div>
    <div class="metric-card"><strong>3</strong><span>LiDARs, for 360° coverage</span></div>
    <div class="metric-card"><strong>740+</strong><span>Experiments in the 2026 perturbation study</span></div>
    <div class="metric-card"><strong>48h+</strong><span>Of autonomous driving in that study</span></div>
  </div>

  <section class="section" aria-labelledby="breakdown-heading">
    <div class="container-wide">
      <div class="section-heading" data-reveal>
        <div>
          <h2 id="breakdown-heading" class="display-title">What I actually did.</h2>
          <p class="section-lede">
            I didn’t build Fortuna. I got it working again, then changed it so it could serve
            more than one project. Here is what was already there, what I did, and what was a
            shared effort.
          </p>
        </div>
      </div>
      <ol class="ledger">
        <li class="ledger-row" data-reveal>
          <div class="ledger-label">
            <span class="theme-number">01</span>
            <h3>Already there</h3>
            <p class="ledger-when">2016–21, fortiss for Providentia</p>
          </div>
          <div class="ledger-body">
            <p>
              fortiss built Fortuna as a 5G-connected automated-vehicle prototype for Providentia,
              a project on connected, automated driving along the A9 digital motorway test bed
              near Munich. That included the drive-by-wire retrofit, the cameras and LiDARs, the
              onboard compute, and an Apollo integration handling GPS/IMU, the CAN bus, and
              real-time control through a dSpace MicroAutoBox II. It ran on Apollo alone, for one
              project, and when Providentia ended in 2021, so did the car’s job.
            </p>
          </div>
        </li>
        <li class="ledger-row" data-reveal>
          <div class="ledger-label">
            <span class="theme-number">02</span>
            <h3>The starting point</h3>
            <p class="ledger-when">2023</p>
          </div>
          <div class="ledger-body">
            <p>
              The car had been inactive for more than a year. Before anyone could drive it again,
              parts of the architecture and the operating procedures had to be reconstructed.
            </p>
            <figure class="ledger-photo">
              <img
                src="/images/fortuna-recovery.jpg"
                alt="The rear compute rack inside Fortuna, exposed with its PCs, GPUs, and batteries during the 2023 recovery work"
                width="1400"
                height="1867"
                loading="lazy"
              />
              <figcaption class="video-frame-caption">The back of the car, mid-recovery, 2023.</figcaption>
            </figure>
          </div>
        </li>
        <li class="ledger-row" data-reveal>
          <div class="ledger-label">
            <span class="theme-number">03</span>
            <h3>What I did</h3>
            <p class="ledger-when">2023–25</p>
          </div>
          <div class="ledger-body">
            <p>
              Reassessed every subsystem, restored the communication paths between them, and made
              the vehicle inspectable and operable again. Then, rather than restore the
              single-purpose setup, rebuilt it as a modular ROS platform: a bridge machine runs the
              ROS master and an Apollo/ROS adapter, so the system under test can read sensor data
              and send control commands without touching Apollo. Both the driving stack and the
              computer running it can be swapped; any laptop or PC up to 1000 W connects over
              Ethernet.
            </p>
          </div>
        </li>
        <li class="ledger-row" data-reveal>
          <div class="ledger-label">
            <span class="theme-number">04</span>
            <h3>What we did together</h3>
            <p class="ledger-when">2024 onward</p>
          </div>
          <div class="ledger-body">
            <p>
              With students joining the project: modular and end-to-end driving stacks, sensor
              pipelines, simulation integration, and hardware-in-the-loop infrastructure. The
              small-scale Donkey Car platform and its mixed-reality lab grew alongside. I lead the
              technical work under the supervision of Prof. Andrea Stocco; the students behind
              specific parts are <a class="text-link" href="#people-heading">credited below</a>.
            </p>
          </div>
        </li>
        <li class="ledger-row" data-reveal>
          <div class="ledger-label">
            <span class="theme-number">05</span>
            <h3>What it made possible</h3>
            <p class="ledger-when">2026</p>
          </div>
          <div class="ledger-body">
            <p>
              For our ASE 2026 study, Matthias Weil and I compared 72 camera and LiDAR
              perturbations across offline analysis, hardware-in-the-loop execution, and
              closed-loop driving on Fortuna: more than 740 experiments and over 48 hours of
              autonomous driving. Recorded drives that Cam2Sim turns into closed-loop simulations.
              Several bachelor’s and master’s theses. The same question can now run offline, in the
              loop, and on the road, so we can{' '}
              <a class="text-link" href="/publications/">compare where the answer changes</a>.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section-dark" aria-labelledby="drive-heading">
    <div class="container-wide">
      <div class="section-heading" data-reveal>
        <div>
          <h2 id="drive-heading" class="display-title">Two ways to drive the same <em>car.</em></h2>
          <p class="section-lede">
            The driving stack can be an end-to-end model or a modular perception-planning-control
            pipeline. Bring your own laptop or PC, up to 1000 W, connect it over Ethernet, and
            start driving.
          </p>
        </div>
      </div>
      <div class="video-grid">
        <figure data-reveal>
          <div class="video-frame">
            <video
              src="/videos/fortuna-drive.mp4"
              poster="/images/fortuna-drive-poster.jpg"
              controls
              muted
              playsinline
              preload="none"
              aria-label="Dashcam footage from inside Fortuna running an end-to-end driving model during a closed-loop test drive in Munich"
            ></video>
          </div>
          <figcaption class="video-frame-caption">
            End-to-end model — camera in, steering and throttle out.
          </figcaption>
        </figure>
        <figure data-reveal>
          <div class="video-frame">
            <video
              src="/videos/fortuna-modular.mp4"
              poster="/images/modular-poster.jpg"
              controls
              muted
              playsinline
              preload="none"
              aria-label="Dashcam footage from inside Fortuna running a modular perception-planning-control pipeline during a closed-loop test drive in Munich"
            ></video>
          </div>
          <figcaption class="video-frame-caption">
            Modular pipeline — perception, planning, and control as separate stages.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="architecture-panel" aria-labelledby="architecture-heading">
    <div class="container-wide">
      <div class="architecture-copy architecture-copy-wide" data-reveal>
        <h2 id="architecture-heading">What’s on the car.</h2>
        <p>
          A retrofitted, street-legal 2018 Volkswagen Passat Variant GTE with five cameras, three
          LiDARs for 360° coverage, RTK localization, onboard compute, and real-time drive-by-wire
          control through the vehicle gateway.
        </p>
        <ol class="architecture-key">
          <li><span>01</span> Cameras for visual perception and end-to-end driving</li>
          <li><span>02</span> Three LiDARs for 360° geometry, obstacles, and modular stacks</li>
          <li><span>03</span> RTK localization and onboard ROS compute</li>
          <li><span>04</span> Real-time drive-by-wire actuation and control</li>
        </ol>
      </div>
      <div class="fortuna-photo architecture-photo-wide" data-reveal>
        <img
          src="/images/fortuna-sensors-compute.png"
          alt="Fortuna's sensors (3x360 LiDAR, IMU/GNSS, 5x cameras, and drive-by-wire control) mapped to their onboard compute: an Nvidia Drive PX2 for cameras, i7/GTX1050Ti PCs for LiDAR and localization, and a dSpace MicroAutoBox II for control"
          width="1600"
          height="554"
          loading="lazy"
        />
      </div>
      <div class="architecture-layout specs-pipeline">
        <div class="architecture-copy" data-reveal>
          <h3 class="specs-subhead">How the pieces talk.</h3>
          <p>
            Camera and LiDAR drivers publish over ROS from an Nvidia Drive PX2 and a dedicated PC.
            Apollo still owns GPS/IMU, the CAN bus, and the real-time control interface to the
            dSpace MicroAutoBox II. A bridge machine runs the ROS master and an Apollo/ROS adapter,
            so the system under test, on its own machine, subscribes to sensor data and publishes
            control commands without touching Apollo. Everything meets over Ethernet.
          </p>
        </div>
        <div class="diagram-plate" data-reveal>
          <img
            src="/images/fortuna-hw-scheme.jpg"
            alt="Hardware and software architecture diagram: camera and LiDAR drivers on an Nvidia Drive PX2 and PC1 publish over ROS; GPS/IMU, CAN bus, and control drivers run inside Apollo on PC1 and send control commands to a dSpace MicroAutoBox II; all machines connect over Ethernet to PC2, which runs the ROS master and an Apollo/ROS adapter, exposing data and control to an Intelligence node running the system under test and extra auxiliary modules"
            width="1600"
            height="900"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="donkey-heading">
    <div class="container-wide architecture-layout">
      <div class="architecture-copy" data-reveal>
        <h2 id="donkey-heading">Donkey Car, Fortuna’s <em>little brother.</em></h2>
        <p>
          Fortuna has a smaller sibling: a 1/16-scale Donkey Car with its own small-scale lab
          and a mixed-reality framework built around a digital twin of that lab. For our ASE
          2025 study, we used it to compare simulation, vehicle-in-the-loop, and mixed-reality
          testing against real driving—vehicle-in-the-loop reduced the actuation gap, and
          mixed-reality testing reduced the perception gap, compared to simulation alone.
        </p>
        <a class="text-link" href={realityGapPaper.paper} target="_blank" rel="noreferrer" style="margin-top: 1.5rem;">
          Read the ASE 2025 paper <span aria-hidden="true">↗︎</span>
        </a>
      </div>
      <div class="donkey-photo fortuna-photo" data-reveal>
        <img
          src="/images/donkey-car.png"
          alt="The Donkey Car, a 1/16-scale research vehicle with an onboard camera and compute stack"
          width="964"
          height="434"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="people-heading">
    <div class="container-wide">
      <div class="section-heading" data-reveal>
        <div>
          <h2 id="people-heading" class="display-title">Students who have driven this forward.</h2>
          <p class="section-lede">
            I lead the technical work around the platform under the supervision of Prof. Andrea
            Stocco, but the research around it is a shared effort. Here is some of the student
            projects that have grown around the platforms.
          </p>
        </div>
      </div>

      <ul class="contributor-list" aria-label="Students and collaborators">
        <li class="contributor-row" data-reveal>
          <div>
            <h3>Davide Jannussi</h3>
            <p>
              Davide built Cam2Sim, turning our recorded drives into playable, closed-loop CARLA
              scenarios.
            </p>
          </div>
          <a class="text-link" href="https://arxiv.org/abs/2607.04770" target="_blank" rel="noreferrer">Cam2Sim <span aria-hidden="true">↗︎</span></a>
        </li>
        <li class="contributor-row" data-reveal>
          <div>
            <h3>Xun Ma</h3>
            <p>
              Xun’s thesis studied how to adapt a model trained purely in simulation so it holds
              up in the real world.
            </p>
          </div>
        </li>
        <li class="contributor-row" data-reveal>
          <div>
            <h3>Matthias Weil</h3>
            <p>
              As a bachelor’s student, Matthias co-led the real-world perturbation study that
              became our ASE 2026 paper.
            </p>
          </div>
          <a class="text-link" href="https://arxiv.org/abs/2607.04953" target="_blank" rel="noreferrer">ASE 2026 <span aria-hidden="true">↗︎</span></a>
        </li>
        <li class="contributor-row" data-reveal>
          <div>
            <h3>Mirena Flores Valdez</h3>
            <p>
              Her master’s thesis became the ASE 2025 study comparing simulation,
              vehicle-in-the-loop, and mixed-reality testing on the small-scale platform.
            </p>
          </div>
          <a class="text-link" href="https://doi.org/10.1109/ASE63991.2025.00230" target="_blank" rel="noreferrer">ASE 2025 <span aria-hidden="true">↗︎</span></a>
        </li>
        <li class="contributor-row" data-reveal>
          <div>
            <h3>Skander Jneyeh</h3>
            <p>
              For his bachelor’s thesis, Skander built a physical, IoT-connected traffic-light
              system for the small-scale platform.
            </p>
          </div>
        </li>
        <li class="contributor-row" data-reveal>
          <div>
            <h3>Hannes Leonhard</h3>
            <p>
              As a bachelor's student, Hannes built PerturbationDrive, the image-perturbation
              framework for testing automated driving assistance systems.
            </p>
          </div>
          <a class="text-link" href="https://arxiv.org/abs/2603.23661" target="_blank" rel="noreferrer">PerturbationDrive <span aria-hidden="true">↗︎</span></a>
        </li>
        <li class="contributor-row" data-reveal>
          <div>
            <h3>Constantin Carste</h3>
            <p>
              Constantin's bachelor's thesis used Stable Diffusion and CARLA to reconstruct real
              driving scenarios and generate matching road layouts from recordings—the basis
              Cam2Sim was later built on.
            </p>
          </div>
        </li>
        <li class="contributor-row" data-reveal>
          <div>
            <h3>Gökce Sengün</h3>
            <p>
              Gökce's thesis extends the ICST 2024 quality-metrics study to system-level testing
              on a physical vehicle.
            </p>
          </div>
        </li>
      </ul>

      <p class="section-lede" style="margin-top: 3rem;">
        Several of these students came through a practicum course I help organize on testing
        autonomous driving systems.{' '}
        <a class="text-link" href="/teaching/">More on teaching <span aria-hidden="true">↗︎</span></a>
      </p>
    </div>
  </section>

  <section class="section section-dark" aria-labelledby="garage-teaser-heading">
    <div class="container-wide demo-showcase">
      <div class="video-frame" id="fortuna-3d-frame">
        <canvas id="fortuna-3d-preview" aria-label="Rotating 3D model of Fortuna"></canvas>
      </div>
      <div class="demo-showcase-copy">
        <h2 id="garage-teaser-heading">Race Fortuna, just for fun.</h2>
        <p>
          Race Gaussian-splat models of Fortuna and my motorcycle around a track, no research
          question required.
        </p>
        <a class="text-link" href="/garage/">
          Open it up <span aria-hidden="true">↗︎</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';

  const canvas = document.getElementById('fortuna-3d-preview') as HTMLCanvasElement | null;
  const frame = document.getElementById('fortuna-3d-frame') as HTMLElement | null;

  if (canvas && frame) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
    camera.position.set(3.4, 1.7, 4.6);
    camera.lookAt(0, 0.3, 0);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    scene.add(new THREE.HemisphereLight('#ffffff', '#1b1f1c', 1.1));
    const key = new THREE.DirectionalLight('#fff6e8', 2.2);
    key.position.set(4, 6, 3);
    scene.add(key);
    const rim = new THREE.DirectionalLight('#f05a28', 0.6);
    rim.position.set(-4, 2, -4);
    scene.add(rim);

    let model: THREE.Object3D | null = null;
    const dracoLoader = new DRACOLoader();
    dracoLoader.setDecoderPath('/draco/');
    const loader = new GLTFLoader();
    loader.setDRACOLoader(dracoLoader);
    loader.load('/models/fortuna.glb', (gltf) => {
      model = gltf.scene;
      const box = new THREE.Box3().setFromObject(model);
      const center = new THREE.Vector3();
      box.getCenter(center);
      model.position.sub(center);
      scene.add(model);
      requestRender();
    });

    function resize() {
      const w = frame!.clientWidth;
      const h = frame!.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      requestRender();
    }

    // Spin only while on screen; under reduced motion, draw a still frame.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    let frameId = 0;

    function tick() {
      frameId = 0;
      if (model && !reduceMotion.matches) model.rotation.y += 0.005;
      renderer.render(scene, camera);
      if (visible && !reduceMotion.matches) requestRender();
    }

    function requestRender() {
      if (!frameId) frameId = requestAnimationFrame(tick);
    }

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) requestRender();
    }).observe(frame);
    reduceMotion.addEventListener('change', requestRender);

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(frame);
    resize();
  }
</script>
