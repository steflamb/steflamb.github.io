---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publications } from '../data/site';

const realityGapPaper = publications.find((p) => p.title.startsWith('A Multi-Modality Evaluation'))!;
const perturbationBenchmarkPaper = publications.find((p) => p.title.startsWith('Benchmarking Image Perturbations'))!;
const perturbationDriveJournalPaper = publications.find((p) => p.title.startsWith('PerturbationDrive:'))!;
---

<BaseLayout
  title="Fortuna — Stefano Carlo Lambertenghi"
  description="The story and architecture of Fortuna, fortiss's full-scale autonomous-driving research vehicle."
>
  <section class="page-hero">
    <div class="page-hero-inner container-wide">
      <div>
        <p class="eyebrow">Fortuna / full-scale research platform</p>
        <h1 class="page-title">A street-legal <em>research vehicle.</em></h1>
      </div>
      <div>
        <div class="fortuna-photo">
          <img
            src="/images/fortuna-profile.png"
            alt="Fortuna, fortiss's modified Passat GTE, with its roof-mounted camera and LiDAR sensor rack"
            width="775"
            height="435"
            loading="eager"
          />
        </div>
        <div class="page-hero-copy">
          <p>
            When I started working with Fortuna in 2023, the vehicle had been inactive for more
            than a year. I took responsibility for bringing it back into operation. This involved
            reconstructing parts of the existing architecture and operating procedures, restoring
            the software and hardware components needed for autonomous driving, and gradually
            making the vehicle usable for research again.
          </p>
          <p>
            Today I lead the technical work around the vehicle. We use it for research on
            autonomous-driving testing, simulation, and real-world validation. Several students
            and researchers contribute to the platform and use it for their own work.
          </p>
          <div class="page-hero-meta">
            <span class="tag">2018 VW Passat Variant GTE</span>
            <span class="tag">Cameras + 3 LiDARs</span>
            <span class="tag">Drive-by-wire</span>
            <span class="tag">ROS</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="metrics-strip" aria-label="Fortuna platform summary">
    <div class="metric-card"><strong>2023</strong><span>Recovery and reintegration began</span></div>
    <div class="metric-card"><strong>48h+</strong><span>Real-world driving in the 2026 perturbation study</span></div>
    <div class="metric-card"><strong>Multiple</strong><span>Modular and end-to-end ADS architectures</span></div>
    <div class="metric-card"><strong>2</strong><span>Vehicle scales—a full-size Fortuna and a small-scale Donkey Car</span></div>
  </div>

  <section class="section section-dark" aria-labelledby="drive-heading">
    <div class="container-wide">
      <div class="section-heading" data-reveal>
        <p class="eyebrow eyebrow-light">Inside the vehicle</p>
        <div>
          <h2 id="drive-heading" class="display-title">Two ways to drive the same <em>car.</em></h2>
          <p class="section-lede">
            The driving stack can be an end-to-end model or a modular perception-planning-control
            pipeline. Bring your own laptop or PC, up to 1000 W, connect it over Ethernet, and
            start driving.
          </p>
        </div>
      </div>
      <div class="video-grid">
        <figure data-reveal>
          <div class="video-frame">
            <video
              src="/videos/fortuna-drive.mp4"
              poster="/images/fortuna-drive-poster.jpg"
              controls
              muted
              playsinline
              preload="none"
              aria-label="Dashcam footage from inside Fortuna running an end-to-end driving model during a closed-loop test drive in Munich"
            ></video>
          </div>
          <figcaption class="video-frame-caption">
            End-to-end model — camera in, steering and throttle out.
          </figcaption>
        </figure>
        <figure data-reveal>
          <div class="video-frame">
            <video
              src="/videos/fortuna-modular.mp4"
              poster="/images/modular-poster.jpg"
              controls
              muted
              playsinline
              preload="none"
              aria-label="Dashcam footage from inside Fortuna running a modular perception-planning-control pipeline during a closed-loop test drive in Munich"
            ></video>
          </div>
          <figcaption class="video-frame-caption">
            Modular pipeline — perception, planning, and control as separate stages.
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="platform-story-heading">
    <div class="container-wide story-centered" data-reveal>
      <p class="eyebrow">The platform</p>
      <h2 id="platform-story-heading" class="sr-only">The Fortuna platform</h2>
      <p>
        Fortuna is fortiss’s full-size autonomous-driving research vehicle: a retrofitted,
        street-legal Volkswagen Passat Variant GTE with five cameras, three LiDARs providing
        360° coverage, precise localization, onboard compute, and real-time access to steering
        and acceleration through the vehicle gateway.
      </p>
      <p>
        We use it to run the same research question across offline models, hardware-in-the-loop
        setups, and a complete moving vehicle, then compare where the answer changes.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="breakdown-heading">
    <div class="container-wide">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">Inherited, recovered, changed</p>
        <div>
          <h2 id="breakdown-heading" class="display-title">What I actually did.</h2>
        </div>
      </div>
      <div class="theme-grid breakdown-grid">
        <article class="theme-card breakdown-card" data-reveal>
          <span class="theme-number">01</span>
          <h3>Inherited</h3>
          <p>
            Drive-by-wire actuation and control, the camera and LiDAR hardware, and the Apollo
            integration with GPS/IMU and the CAN bus—built for Providentia between 2016 and 2021.
          </p>
        </article>
        <article class="theme-card breakdown-card" data-reveal>
          <span class="theme-number">02</span>
          <h3>Recovered</h3>
          <p>
            In 2023, after more than a year of inactivity: reassessed every subsystem, restored
            communication paths, and made the vehicle inspectable and operable again.
          </p>
        </article>
        <article class="theme-card breakdown-card" data-reveal>
          <span class="theme-number">03</span>
          <h3>Changed since 2023</h3>
          <p>
            A ROS bridge alongside Apollo so any laptop or PC can drive the car over Ethernet,
            modular and end-to-end driving stacks, simulation integration, hardware-in-the-loop
            infrastructure, and the small-scale Donkey Car platform.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="timeline-heading">
    <div class="container-wide">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">Recovery → research</p>
        <div>
          <h2 id="timeline-heading" class="display-title">From recovery to research.</h2>
          <p class="section-lede">
            Fortuna wasn’t built for me. It was fortiss’s automated-driving prototype for
            Providentia—then the project ended, and the car sat unused.
          </p>
        </div>
      </div>

      <ol class="timeline">
        <li class="timeline-item" data-reveal>
          <p class="timeline-year">2016–21</p><span class="timeline-dot" aria-hidden="true"></span>
          <div class="timeline-content">
            <h3>Built for Providentia</h3>
            <p>
              As fortiss’s 5G-connected automated-vehicle prototype, Fortuna gathered data
              alongside roadside sensor infrastructure for Providentia, a project researching
              connected, automated driving on Germany’s A9 digital motorway test bed near Munich.
              When the project ended in 2021, so did the car’s job.
            </p>
          </div>
        </li>
        <li class="timeline-item" data-reveal>
          <p class="timeline-year">2023</p><span class="timeline-dot" aria-hidden="true"></span>
          <div class="timeline-content">
            <h3>Understand and recover</h3>
            <p>
              I assessed each inactive subsystem, restored communication paths, and made the
              vehicle inspectable and operable again.
            </p>
          </div>
        </li>
        <li class="timeline-item" data-reveal>
          <p class="timeline-year">2024–25</p><span class="timeline-dot" aria-hidden="true"></span>
          <div class="timeline-content">
            <h3>Rebuild it modular</h3>
            <p>
              Rather than restore the original single-purpose setup, I rebuilt Fortuna as a
              modular, ROS-based platform: the driving stack can simply be swapped, and so can
              the compute behind it—any laptop or PC up to 1000 W, connected over Ethernet. With
              students joining the project, we integrated modular and end-to-end driving stacks,
              sensor pipelines, and simulation.
            </p>
          </div>
        </li>
        <li class="timeline-item" data-reveal>
          <p class="timeline-year">2026</p><span class="timeline-dot" aria-hidden="true"></span>
          <div class="timeline-content">
            <h3>Test at full scale</h3>
            <p>
              For our ASE 2026 study, I compared 72 camera and LiDAR perturbations across offline
              analysis, hardware-in-the-loop execution, and closed-loop driving on Fortuna: more
              than 740 experiments and over 48 hours of autonomous driving.
            </p>
          </div>
        </li>
        <li class="timeline-item" data-reveal>
          <p class="timeline-year">NEXT</p><span class="timeline-dot" aria-hidden="true"></span>
          <div class="timeline-content">
            <h3>Turn fieldwork into shared infrastructure</h3>
            <p>
              I keep connecting physical drives to reproducible scenarios, open tools, student
              projects, and research questions the next team can build on.
            </p>
          </div>
        </li>
      </ol>

      <figure class="timeline-photo" data-reveal>
        <img
          src="/images/fortuna-recovery.jpg"
          alt="The rear compute rack inside Fortuna, exposed with its PCs, GPUs, and batteries during the 2023 recovery work"
          width="1400"
          height="1867"
          loading="lazy"
        />
        <figcaption class="video-frame-caption">
          The back of the car, mid-recovery, 2023.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="architecture-panel" aria-labelledby="architecture-heading">
    <div class="container-wide">
      <div class="architecture-copy architecture-copy-wide" data-reveal>
        <p class="eyebrow">System anatomy</p>
        <h2 id="architecture-heading">Sensors, compute, and control.</h2>
        <ol class="architecture-key">
          <li><span>01</span> Cameras for visual perception and end-to-end driving</li>
          <li><span>02</span> Three LiDARs for 360° geometry, obstacles, and modular stacks</li>
          <li><span>03</span> RTK localization and onboard ROS compute</li>
          <li><span>04</span> Real-time drive-by-wire actuation and control</li>
        </ol>
      </div>
      <div class="fortuna-photo architecture-photo-wide" data-reveal>
        <img
          src="/images/fortuna-sensors-compute.png"
          alt="Fortuna's sensors (3x360 LiDAR, IMU/GNSS, 5x cameras, and drive-by-wire control) mapped to their onboard compute: an Nvidia Drive PX2 for cameras, i7/GTX1050Ti PCs for LiDAR and localization, and a dSpace MicroAutoBox II for control"
          width="1600"
          height="554"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section section-dark" aria-labelledby="hw-logic-heading">
    <div class="container-wide architecture-layout">
      <div class="architecture-copy" data-reveal>
        <p class="eyebrow eyebrow-light">Hardware and logic</p>
        <h2 id="hw-logic-heading">Hardware and distributed computing pipeline.</h2>
        <p>
          The original platform ran on Apollo alone. I expanded it into a distributed system:
          camera and LiDAR drivers publish over ROS from an Nvidia Drive PX2 and a dedicated PC,
          Apollo still owns GPS/IMU, the CAN bus, and the real-time control interface that talks
          to the dSpace MicroAutoBox II, and everything meets over Ethernet. A bridge machine
          runs the ROS master alongside an Apollo/ROS adapter, so a separate “intelligence” node
          (the system under test, plus whatever extra tooling a given experiment needs) can
          subscribe to sensor data and publish control commands without touching Apollo directly.
        </p>
      </div>
      <div class="diagram-plate">
        <img
          src="/images/fortuna-hw-scheme.jpg"
          alt="Hardware and software architecture diagram: camera and LiDAR drivers on an Nvidia Drive PX2 and PC1 publish over ROS; GPS/IMU, CAN bus, and control drivers run inside Apollo on PC1 and send control commands to a dSpace MicroAutoBox II; all machines connect over Ethernet to PC2, which runs the ROS master and an Apollo/ROS adapter, exposing data and control to an Intelligence node running the system under test and extra auxiliary modules"
          width="1600"
          height="900"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="donkey-heading">
    <div class="container-wide architecture-layout">
      <div class="architecture-copy" data-reveal>
        <p class="eyebrow">The small-scale platform</p>
        <h2 id="donkey-heading">Donkey Car, Fortuna’s <em>little brother.</em></h2>
        <p>
          Fortuna has a smaller sibling: a 1/16-scale Donkey Car with its own small-scale lab
          and a mixed-reality framework built around a digital twin of that lab. For our ASE
          2025 study, we used it to compare simulation, vehicle-in-the-loop, and mixed-reality
          testing against real driving—vehicle-in-the-loop reduced the actuation gap, and
          mixed-reality testing reduced the perception gap, compared to simulation alone.
        </p>
        <a class="text-link" href={realityGapPaper.paper} target="_blank" rel="noreferrer" style="margin-top: 1.5rem;">
          Read the ASE 2025 paper <span aria-hidden="true">↗︎</span>
        </a>
      </div>
      <div class="donkey-photo fortuna-photo" data-reveal>
        <img
          src="/images/donkey-car.png"
          alt="The Donkey Car, a 1/16-scale research vehicle with an onboard camera and compute stack"
          width="964"
          height="434"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="people-heading">
    <div class="container-wide">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">Not a one-person project</p>
        <div>
          <h2 id="people-heading" class="display-title">Students who have driven this forward.</h2>
          <p class="section-lede">
            I lead the technical work around the platform, under the research supervision of
            Andrea Stocco, and several students and researchers contribute to the work around it.
            Here is some of what they have built.
          </p>
        </div>
      </div>

      <div class="people-grid">
        <article class="person-card" data-reveal>
          <div class="person-photo" style="aspect-ratio: 1200 / 1135;">
            <img
              src="/images/davide-xun.jpg"
              alt="Davide Jannussi and Xun Ma next to Fortuna"
              width="1200"
              height="1135"
              loading="lazy"
            />
          </div>
          <div class="person-body">
            <p class="person-role">Master’s students</p>
            <h3>Davide Jannussi &amp; Xun Ma</h3>
            <p>
              Davide built Cam2Sim, turning our recorded drives into playable, closed-loop CARLA
              scenarios reconstructed with Gaussian Splatting. Xun’s thesis studied how to adapt
              a model trained purely in simulation so it holds up when tested in the real world.
            </p>
            <a class="text-link" href="https://arxiv.org/abs/2607.04770" target="_blank" rel="noreferrer">
              Read Davide’s paper <span aria-hidden="true">↗︎</span>
            </a>
          </div>
        </article>
        <article class="person-card" data-reveal>
          <div class="person-photo">
            <img
              src="/images/matthias-andrea-me.jpg"
              alt="Matthias Weil, Andrea Stocco, and Stefano Carlo Lambertenghi next to Fortuna"
              width="1400"
              height="1050"
              loading="lazy"
            />
          </div>
          <div class="person-body">
            <p class="person-role">Bachelor’s thesis</p>
            <h3>Matthias Weil</h3>
            <p>
              As a bachelor’s student, Matthias co-led the real-world perturbation study that
              became our ASE 2026 paper: 72 camera and LiDAR perturbations compared across
              offline analysis, hardware-in-the-loop execution, and 740+ closed-loop runs on the
              physical vehicle.
            </p>
            <a class="text-link" href="https://arxiv.org/abs/2607.04953" target="_blank" rel="noreferrer">
              Read the paper <span aria-hidden="true">↗︎</span>
            </a>
          </div>
        </article>
        <article class="person-card" data-reveal>
          <div class="person-photo" style="aspect-ratio: 1920 / 1080;">
            <img
              src="/images/mirena-work.jpg"
              alt="Mirena Flores Valdez, and a split view comparing the real fortiss Labs test room with its simulated digital twin"
              width="1920"
              height="1080"
              loading="lazy"
            />
          </div>
          <div class="person-body">
            <p class="person-role">Master’s thesis</p>
            <h3>Mirena Flores Valdez</h3>
            <p>
              Her master's thesis became the ASE 2025 study comparing simulation,
              vehicle-in-the-loop, and mixed-reality testing on the small-scale platform.
            </p>
            <a class="text-link" href={realityGapPaper.paper} target="_blank" rel="noreferrer">
              Read the paper <span aria-hidden="true">↗︎</span>
            </a>
          </div>
        </article>
        <article class="person-card" data-reveal>
          <div class="person-photo">
            <img
              src="/images/skander.jpg"
              alt="Skander Jneyeh presenting his bachelor's thesis alongside Stefano Carlo Lambertenghi and Andrea Stocco"
              width="1400"
              height="1050"
              loading="lazy"
            />
          </div>
          <div class="person-body">
            <p class="person-role">Bachelor’s thesis</p>
            <h3>Skander Jneyeh</h3>
            <p>
              For his bachelor’s thesis, Skander built a physical, IoT-connected traffic-light
              system for the small-scale platform, so the vehicle can detect and react to traffic
              lights through camera perception or direct communication.
            </p>
          </div>
        </article>
      </div>

      <ul class="contributor-list" aria-label="More collaborators">
        <li class="contributor-row" data-reveal>
          <div>
            <h3>Hannes Leonhard</h3>
            <p>
              As a bachelor's student, Hannes built PerturbationDrive, the image-perturbation
              framework for testing automated driving assistance systems.
            </p>
          </div>
          <div class="contributor-links">
            <a class="text-link" href={perturbationDriveJournalPaper.paper} target="_blank" rel="noreferrer">
              Journal paper <span aria-hidden="true">↗︎</span>
            </a>
            <a class="text-link" href={perturbationBenchmarkPaper.paper} target="_blank" rel="noreferrer">
              ICST 2025 paper <span aria-hidden="true">↗︎</span>
            </a>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="section section-dark" aria-labelledby="garage-teaser-heading">
    <div class="container-wide demo-showcase">
      <div class="video-frame" id="fortuna-3d-frame">
        <canvas id="fortuna-3d-preview" aria-label="Rotating 3D model of Fortuna"></canvas>
      </div>
      <div class="demo-showcase-copy">
        <p class="feature-kicker">Just for fun</p>
        <h2 id="garage-teaser-heading">I also scanned Fortuna into a 3D model.</h2>
        <p>
          You can take it for a lap around the track, no research question required.
        </p>
        <a class="text-link" href="/garage/">
          Open it up <span aria-hidden="true">↗︎</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';

  const canvas = document.getElementById('fortuna-3d-preview') as HTMLCanvasElement | null;
  const frame = document.getElementById('fortuna-3d-frame') as HTMLElement | null;

  if (canvas && frame) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
    camera.position.set(3.4, 1.7, 4.6);
    camera.lookAt(0, 0.3, 0);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    scene.add(new THREE.HemisphereLight('#ffffff', '#1b1f1c', 1.1));
    const key = new THREE.DirectionalLight('#fff6e8', 2.2);
    key.position.set(4, 6, 3);
    scene.add(key);
    const rim = new THREE.DirectionalLight('#ff6034', 0.6);
    rim.position.set(-4, 2, -4);
    scene.add(rim);

    let model: THREE.Object3D | null = null;
    const dracoLoader = new DRACOLoader();
    dracoLoader.setDecoderPath('/draco/');
    const loader = new GLTFLoader();
    loader.setDRACOLoader(dracoLoader);
    loader.load('/models/fortuna.glb', (gltf) => {
      model = gltf.scene;
      const box = new THREE.Box3().setFromObject(model);
      const center = new THREE.Vector3();
      box.getCenter(center);
      model.position.sub(center);
      scene.add(model);
    });

    function resize() {
      const w = frame!.clientWidth;
      const h = frame!.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(frame);
    resize();

    function tick() {
      requestAnimationFrame(tick);
      if (model) model.rotation.y += 0.005;
      renderer.render(scene, camera);
    }
    tick();
  }
</script>
