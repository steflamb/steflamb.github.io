---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Just for fun — Stefano Carlo Lambertenghi"
  description="Race Gaussian-splat models of Fortuna and my motorcycle on three circuits, Guerickestraße or any street on the map."
  noindex={true}
>
  <section class="garage" data-phase="intro">
    <canvas id="garage-canvas"></canvas>

    <div class="garage-intro" id="garage-intro">
      <div class="garage-door" aria-hidden="true">
        <span class="garage-door-sweep"></span>
      </div>
      <div class="garage-door-leak" aria-hidden="true"></div>
      <div class="garage-intro-copy">
        <h1 class="garage-intro-title">
          <span class="garage-intro-line">Stefano's</span>
          <span class="garage-intro-line">garage.</span>
        </h1>
        <p class="garage-intro-lede">Race Gaussian-splat models of Fortuna and my motorcycle, on three circuits or any street on the map.</p>
        <button type="button" class="garage-go garage-intro-start" id="garage-intro-start">Start Stefano's garage</button>
      </div>
    </div>

    <div class="garage-showroom" id="garage-showroom" data-step="vehicle">
      <h2>Just for fun.</h2>
      <p class="garage-instructions">
        Race Gaussian-splat models of Fortuna and my motorcycle. Pick one, pick a track, and
        take it for a lap. No research question required.
      </p>

      <div class="garage-step" id="garage-step-vehicle">
        <fieldset class="garage-choice">
          <legend>Vehicle</legend>
          <label><input type="radio" name="vehicle" value="fortuna" checked /><span><b>Fortuna</b><small>Research vehicle</small></span></label>
          <label><input type="radio" name="vehicle" value="gs" /><span><b>GS</b><small>My motorcycle</small></span></label>
        </fieldset>
        <p class="garage-hint garage-desktop-only">Drag the turntable to look around.</p>
        <button type="button" class="garage-go" id="garage-to-track">Choose a track</button>
      </div>

      <div class="garage-step" id="garage-step-track" hidden>
        <fieldset class="garage-choice garage-circuits">
          <legend>Track</legend>
          <label><input type="radio" name="circuit" value="cones" checked /><span><svg data-preview="cones" aria-hidden="true"></svg><b>Cone course</b></span></label>
          <label><input type="radio" name="circuit" value="monza" /><span><svg data-preview="monza" aria-hidden="true"></svg><b>Monza</b><small>Simplified</small></span></label>
          <label><input type="radio" name="circuit" value="spa" /><span><svg data-preview="spa" aria-hidden="true"></svg><b>Spa</b><small>Simplified</small></span></label>
          <label><input type="radio" name="circuit" value="guericke" disabled /><span><svg data-preview="guericke" aria-hidden="true"></svg><b>Guerickestraße</b><small>Munich, from the Cam2Sim drive</small></span></label>
          <label><input type="radio" name="circuit" value="custom" id="garage-custom" /><span><svg data-preview="custom" aria-hidden="true"></svg><b id="garage-custom-name">Any street</b><small id="garage-custom-note">Pick it on the map, rebuilt with our Cam2Sim street code</small></span></label>
        </fieldset>
        <div class="garage-options">
          <label>
            <span>Weather</span>
            <select id="garage-weather">
              <option value="clear">Clear</option>
              <option value="rain">Rain</option>
              <option value="fog">Fog</option>
              <option value="sun">Low sun</option>
              <option value="snow">Snow</option>
            </select>
          </label>
          <div class="garage-toggles">
            <label><input type="checkbox" id="garage-traffic" /> <span>Traffic</span></label>
            <label><input type="checkbox" id="garage-ghost" checked /> <span>Ghost of best lap</span></label>
          </div>
        </div>
        <p class="garage-result" id="garage-result" aria-live="polite" hidden></p>
        <div class="garage-actions">
          <button type="button" class="garage-back" id="garage-to-vehicle">Back</button>
          <button type="button" class="garage-go" id="garage-start">Start driving</button>
        </div>
        <p class="garage-storage">
          Best times, ghost laps and loaded streets are saved only in this browser's local storage
          (no cookies) and never leave your device.{' '}
          <button type="button" id="garage-clear">Clear saved data</button> ·{' '}
          <a href="/privacy/">Privacy</a>
        </p>
      </div>
    </div>

    <div class="garage-race-hud" id="garage-race-hud">
      <button type="button" class="garage-back" id="garage-exit">Back to the garage</button>
      <p class="garage-controls garage-desktop-only">Arrow keys or WASD to drive.</p>
    </div>

    <div class="garage-picker" id="garage-picker" role="dialog" aria-modal="true" aria-labelledby="garage-picker-title" hidden>
      <div class="garage-picker-map" id="garage-picker-map"></div>
      <div class="garage-picker-bar">
        <h2 id="garage-picker-title">Pick a street.</h2>
        <p class="garage-picker-lede">
          The street is rebuilt in 3D with the code from our Cam2Sim demo, the same code that
          recreates Guerickestraße from OpenStreetMap.
        </p>
        <div class="garage-picker-consent" id="garage-picker-consent" hidden>
          <p>
            This track is built from OpenStreetMap. To pick it, the page loads map tiles from the
            OpenStreetMap Foundation, and loading your route asks the public Overpass API
            (overpass-api.de) for the streets and buildings around it.
          </p>
          <p>
            Your browser then sends those services your IP address, its standard request details
            and the map area. No account, name or anything else is involved. Your choice is
            remembered in this browser until you clear saved data.{' '}
            <a href="/privacy/">Privacy</a>
          </p>
          <div class="garage-actions">
            <button type="button" class="garage-back" data-picker-cancel>Not now</button>
            <button type="button" class="garage-go" id="garage-picker-consent-yes">Load the map</button>
          </div>
        </div>
        <div class="garage-picker-pick" id="garage-picker-pick" hidden>
          <p class="garage-picker-status" id="garage-picker-status" aria-live="polite">Tap where the sprint starts, then where it finishes.</p>
          <div class="garage-actions">
            <button type="button" class="garage-back" data-picker-cancel>Cancel</button>
            <button type="button" class="garage-go" id="garage-picker-load" disabled>Load this route</button>
          </div>
          <p class="garage-picker-note">
            Loading the route sends the area around your two points to the Overpass API. Map
            data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap contributors</a>.
          </p>
        </div>
      </div>
    </div>

    <small class="garage-osm-credit" id="garage-osm-credit" hidden>
      Map data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap contributors</a>
    </small>

    <div class="garage-offtrack" id="garage-offtrack" aria-live="assertive" hidden>
      <p>Off track.</p>
      <small id="garage-offtrack-note">Back to the start</small>
    </div>

    <p class="garage-loading" id="garage-loading">Loading Fortuna…</p>
    <div class="garage-stats" id="garage-stats">
      <p id="garage-cone-stat">18 standing · 0 knocked over</p>
      <p id="garage-lap-stat">Drive through the start line to begin a lap</p>
    </div>
    <p class="garage-penalty-toast" id="garage-penalty-toast" aria-live="polite" hidden>Cone hit — +10s</p>

    <div class="garage-touch" id="garage-touch" aria-hidden="true">
      <button type="button" class="garage-btn" data-control="left" aria-label="Steer left">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><polygon points="16,4 16,20 6,12" /></svg>
      </button>
      <div class="garage-touch-col">
        <button type="button" class="garage-btn" data-control="forward" aria-label="Accelerate">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><polygon points="4,16 20,16 12,6" /></svg>
        </button>
        <button type="button" class="garage-btn" data-control="back" aria-label="Reverse">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><polygon points="4,8 20,8 12,18" /></svg>
        </button>
      </div>
      <button type="button" class="garage-btn" data-control="right" aria-label="Steer right">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><polygon points="8,4 8,20 18,12" /></svg>
      </button>
    </div>
  </section>
</BaseLayout>

<style>
  .garage {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background: #bfe3f2;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  #garage-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  /* The garage: the chosen vehicle on a turntable, then the track, then the drive. */
  .garage-showroom {
    position: absolute;
    z-index: 1;
    top: calc(5rem + clamp(1rem, 3vw, 2.5rem));
    bottom: clamp(1rem, 3vw, 2.5rem);
    left: clamp(1rem, 4vw, 4rem);
    display: flex;
    width: min(25rem, calc(100% - 2rem));
    flex-direction: column;
    color: var(--paper-bright);
  }

  .garage[data-phase='race'] .garage-showroom,
  .garage[data-phase='intro'] .garage-showroom {
    display: none;
  }

  /* The intro: the garage's roller door, closed. A headlight beam crosses it, light leaks
     from under it, and "Start" rolls it up onto the turntable. */
  .garage-intro {
    position: absolute;
    z-index: 5;
    inset: 0;
    overflow: hidden;
    display: grid;
    align-items: center;
    padding: 5rem clamp(1.25rem, 6vw, 6rem) 0;
    color: var(--paper-bright);
  }

  .garage-intro[hidden] {
    display: none;
  }

  .garage-door {
    position: absolute;
    inset: 0 0 1.25rem;
    overflow: hidden;
    background:
      linear-gradient(to bottom, rgba(255, 255, 255, 0.05) 0, rgba(255, 255, 255, 0) 0.5rem, rgba(0, 0, 0, 0.35) 0.5rem, rgba(0, 0, 0, 0) 0.75rem) 0 0 / 100% 2.75rem,
      linear-gradient(180deg, #232b34, #161c23 70%, #12171d);
    box-shadow: inset 0 -0.6rem 0 #0b0f13;
    transition: transform 1150ms cubic-bezier(0.7, 0, 0.2, 1);
  }

  /* A headlight passing outside, once, across the slats. */
  .garage-door-sweep {
    position: absolute;
    top: -20%;
    bottom: -20%;
    left: -40%;
    width: 40%;
    background: radial-gradient(closest-side, rgba(255, 244, 214, 0.22), rgba(255, 244, 214, 0));
    transform: skewX(-12deg);
    animation: garage-sweep 2600ms cubic-bezier(0.45, 0, 0.2, 1) 350ms both;
  }

  @keyframes garage-sweep {
    from {
      transform: translateX(0) skewX(-12deg);
    }
    to {
      transform: translateX(400%) skewX(-12deg);
    }
  }

  /* Warm light from inside, under the door: where the door has not quite met the floor. */
  .garage-door-leak {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 1.25rem;
    background: linear-gradient(to top, rgba(255, 207, 51, 0.35), rgba(255, 207, 51, 0.9));
    box-shadow: 0 0 3.5rem 1.2rem rgba(255, 207, 51, 0.28);
    animation: garage-leak 3.2s ease-in-out 1.2s infinite alternate;
  }

  @keyframes garage-leak {
    to {
      opacity: 0.65;
    }
  }

  .garage-intro-copy {
    position: relative;
    display: grid;
    justify-items: start;
    gap: clamp(1.6rem, 3vw, 2.4rem);
    max-width: 48rem;
    transition:
      transform 900ms cubic-bezier(0.7, 0, 0.2, 1),
      opacity 500ms ease;
  }

  .garage-intro-title {
    display: grid;
    gap: 0.04em;
    font-size: clamp(3.6rem, 12vw, 10rem);
    font-weight: 600;
    letter-spacing: -0.005em;
    line-height: 0.95;
  }

  .garage-intro-line {
    display: block;
    animation: garage-line 1100ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .garage-intro-line + .garage-intro-line {
    color: var(--lane);
    animation-delay: 140ms;
  }

  @keyframes garage-line {
    from {
      clip-path: inset(100% -0.2em -0.3em -0.2em);
      transform: translateY(0.3em);
    }
    to {
      clip-path: inset(-0.2em -0.2em -0.3em -0.2em);
    }
  }

  .garage-intro-lede {
    max-width: 30rem;
    color: #c9ced3;
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    line-height: 1.5;
    animation: hero-fade 700ms ease 650ms both;
  }

  .garage-intro-start {
    min-height: 3.5rem;
    padding: 0 1.8rem;
    font-size: 1.05rem;
    box-shadow: 0 0.6rem 2.4rem rgba(255, 207, 51, 0.25);
    animation: hero-fade 700ms ease 900ms both;
  }

  /* Start: the door rolls up, the copy goes with it, the garage is revealed behind. */
  .garage-intro.is-opening .garage-door {
    transform: translateY(-101%);
  }

  .garage-intro.is-opening .garage-intro-copy {
    transform: translateY(-60vh);
    opacity: 0;
  }

  .garage-intro.is-opening .garage-door-leak {
    animation: none;
    opacity: 0;
    transition: opacity 500ms ease;
  }

  @media (prefers-reduced-motion: reduce) {
    .garage-door-sweep,
    .garage-door-leak,
    .garage-intro-line,
    .garage-intro-lede,
    .garage-intro-start {
      animation: none;
    }

    .garage-door,
    .garage-intro-copy {
      transition: opacity 300ms ease;
    }

    .garage-intro.is-opening .garage-door,
    .garage-intro.is-opening .garage-intro-copy {
      transform: none;
      opacity: 0;
    }
  }

  .garage-result {
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--lane);
    background: rgba(255, 207, 51, 0.1);
    color: var(--paper-bright);
    font-size: 0.9rem;
  }

  .garage-result[hidden] {
    display: none;
  }

  .garage-picker-lede {
    color: var(--paper-bright);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .garage-showroom h2 {
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 560;
    letter-spacing: -0.02em;
    line-height: 0.9;
  }

  .garage-instructions {
    max-width: 22rem;
    margin-top: 1rem;
    color: #c9ced3;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .garage-step {
    display: grid;
    gap: 1.1rem;
    margin-top: auto;
    animation: garage-step-in 500ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .garage-step[hidden] {
    display: none;
  }

  @keyframes garage-step-in {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }
  }

  .garage-choice {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .garage-choice legend,
  .garage-options > label > span {
    margin-bottom: 0.5rem;
    color: var(--muted-dark);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .garage-choice label {
    position: relative;
    cursor: pointer;
  }

  .garage-choice input {
    position: absolute;
    opacity: 0;
  }

  .garage-choice span {
    display: grid;
    gap: 0.15rem;
    height: 100%;
    padding: 0.75rem 0.85rem;
    border: 1px solid rgba(250, 250, 248, 0.22);
    background: rgba(15, 23, 32, 0.55);
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }

  .garage-choice b {
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1;
  }

  .garage-choice small {
    color: var(--muted-dark);
    font-size: 0.78rem;
  }

  .garage-choice label:hover span {
    border-color: rgba(250, 250, 248, 0.6);
  }

  .garage-choice input:checked + span {
    border-color: var(--lane);
    background: rgba(255, 207, 51, 0.12);
  }

  .garage-choice input:checked + span b {
    color: var(--lane);
  }

  .garage-choice input:focus-visible + span {
    outline: 3px solid var(--signal);
    outline-offset: 3px;
  }

  /* The street gets a full row: its name is long and its shape is a line, not a loop. */
  .garage-circuits label:has(input[value='guericke']) {
    grid-column: 1 / -1;
  }

  .garage-circuits label:has(input[value='guericke']) span {
    grid-template-columns: 4.5rem minmax(0, 1fr);
    column-gap: 0.8rem;
    align-items: center;
  }

  .garage-circuits label:has(input[value='guericke']) svg {
    grid-row: span 2;
    margin-bottom: 0;
  }

  .garage-choice b,
  .garage-choice small {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .garage-circuits svg {
    width: 100%;
    height: 3.2rem;
    margin-bottom: 0.4rem;
    overflow: visible;
  }

  .garage-circuits svg :global(path) {
    fill: none;
    stroke: rgba(250, 250, 248, 0.55);
    stroke-width: 2.5;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }

  .garage-circuits input:checked + span svg :global(path) {
    stroke: var(--lane);
  }

  .garage-options {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 0.8rem 1.2rem;
  }

  .garage-options label {
    display: grid;
  }

  .garage-options select {
    width: 100%;
    min-width: 0;
    min-height: 2.75rem;
    padding: 0 0.6rem;
    border: 1px solid rgba(250, 250, 248, 0.35);
    border-radius: 0;
    background: rgba(15, 23, 32, 0.7);
    color: var(--paper-bright);
    font: inherit;
    font-size: 0.9rem;
  }

  .garage-toggles {
    display: grid;
    gap: 0.35rem;
    font-size: 0.85rem;
  }

  .garage-toggles label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
  }

  .garage-toggles input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--lane);
  }

  .garage-hint {
    color: var(--muted-dark);
    font-size: 0.8rem;
  }

  .garage-actions {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem;
  }

  .garage-go,
  .garage-back {
    min-height: 3rem;
    padding: 0 1.2rem;
    border: 1px solid var(--lane);
    border-radius: 0;
    background: var(--lane);
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .garage-go:hover {
    background: #ffd95c;
  }

  .garage-go:active,
  .garage-back:active {
    transform: scale(0.98);
  }

  .garage-back {
    border-color: rgba(250, 250, 248, 0.45);
    background: rgba(15, 23, 32, 0.6);
    color: var(--paper-bright);
  }

  .garage-back:hover {
    border-color: var(--paper-bright);
  }

  .garage-go:focus-visible,
  .garage-back:focus-visible,
  .garage-options select:focus-visible,
  .garage-toggles input:focus-visible {
    outline: 3px solid var(--signal);
    outline-offset: 3px;
  }

  /* Leaving the road: the world drains to grey in slow motion and the verdict lands. */
  #garage-canvas {
    transition: filter 600ms ease;
  }

  .garage.is-offtrack #garage-canvas {
    filter: grayscale(1) contrast(1.15) brightness(0.8);
  }

  .garage-offtrack {
    position: absolute;
    z-index: 3;
    top: 50%;
    right: 0;
    left: 0;
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    padding: 1.4rem 1rem 1.6rem;
    background: linear-gradient(90deg, transparent, rgba(15, 23, 32, 0.78) 20%, rgba(15, 23, 32, 0.78) 80%, transparent);
    color: var(--signal);
    text-align: center;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .garage-offtrack[hidden] {
    display: none;
  }

  .garage-offtrack p {
    font-family: var(--display);
    font-size: clamp(3.5rem, 11vw, 8rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 0.9;
    animation: garage-offtrack-in 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .garage-offtrack small {
    color: var(--paper-bright);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    animation: hero-fade 600ms ease 300ms both;
  }

  @keyframes garage-offtrack-in {
    from {
      opacity: 0;
      transform: scale(1.35);
      filter: blur(6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .garage-offtrack p,
    .garage-offtrack small {
      animation: none;
    }
  }

  .garage-circuits label:has(input[value='custom']) {
    grid-column: 1 / -1;
  }

  .garage-circuits label:has(input[value='custom']) span {
    grid-template-columns: 4.5rem minmax(0, 1fr);
    column-gap: 0.8rem;
    align-items: center;
  }

  .garage-circuits label:has(input[value='custom']) svg {
    grid-row: span 2;
    margin-bottom: 0;
  }

  /* The picker: a map over the garage, with the instructions and actions beside it. */
  .garage-picker {
    position: absolute;
    z-index: 4;
    inset: 5rem 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 24rem;
    background: var(--ink);
  }

  .garage-picker[hidden] {
    display: none;
  }

  .garage-picker-map {
    min-height: 0;
    background: #dfe3e0;
  }

  .garage-picker-bar {
    display: grid;
    align-content: start;
    gap: 1.1rem;
    padding: clamp(1.25rem, 3vw, 2rem);
    color: var(--paper-bright);
  }

  .garage-picker-bar h2 {
