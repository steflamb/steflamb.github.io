---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Just for fun — Stefano Carlo Lambertenghi"
  description="I also scanned Fortuna into a 3D model. Take it for a lap around the track, no research question required."
  noindex={true}
>
  <section class="garage">
    <canvas id="garage-canvas"></canvas>

    <div class="garage-hud" data-reveal>
      <p class="eyebrow eyebrow-light">Scanned in 3D</p>
      <h1>Just for fun.</h1>
      <p class="garage-instructions">
        I scanned Fortuna and my motorcycle into 3D models. Take either for a lap around the
        track, no research question required.
      </p>
      <details class="garage-settings" id="garage-settings" open>
        <summary>Race settings</summary>
        <fieldset class="garage-vehicle">
          <legend>Vehicle</legend>
          <label><input type="radio" name="vehicle" value="fortuna" checked /><span>Fortuna</span></label>
          <label><input type="radio" name="vehicle" value="gs" /><span>GS motorcycle</span></label>
        </fieldset>
        <div class="garage-options">
          <label>
            <span>Circuit</span>
            <select id="garage-circuit">
              <option value="cones">Cone course</option>
              <option value="monza">Monza, simplified</option>
              <option value="spa">Spa, simplified</option>
            </select>
          </label>
          <label>
            <span>Weather</span>
            <select id="garage-weather">
              <option value="clear">Clear</option>
              <option value="rain">Rain</option>
              <option value="fog">Fog</option>
              <option value="sun">Low sun</option>
              <option value="snow">Snow</option>
            </select>
          </label>
        </div>
        <div class="garage-toggles">
          <label><input type="checkbox" id="garage-traffic" /> <span>Traffic</span></label>
          <label><input type="checkbox" id="garage-ghost" checked /> <span>Ghost of best lap</span></label>
        </div>
      </details>
      <p class="garage-controls garage-desktop-only">Arrow keys or WASD to drive.</p>
      <p class="garage-controls garage-mobile-only">Use the on-screen controls to drive.</p>
      <a class="text-link text-link-light" href="/fortuna/">← Back to Fortuna</a>
    </div>

    <p class="garage-loading" id="garage-loading">Loading Fortuna…</p>
    <div class="garage-stats" id="garage-stats">
      <p id="garage-cone-stat">18 standing · 0 knocked over</p>
      <p id="garage-lap-stat">Drive through the start line to begin a lap</p>
    </div>
    <p class="garage-penalty-toast" id="garage-penalty-toast" aria-live="polite" hidden>Cone hit — +10s</p>

    <div class="garage-touch" id="garage-touch" aria-hidden="true">
      <button type="button" class="garage-btn" data-control="left" aria-label="Steer left">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><polygon points="16,4 16,20 6,12" /></svg>
      </button>
      <div class="garage-touch-col">
        <button type="button" class="garage-btn" data-control="forward" aria-label="Accelerate">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><polygon points="4,16 20,16 12,6" /></svg>
        </button>
        <button type="button" class="garage-btn" data-control="back" aria-label="Reverse">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><polygon points="4,8 20,8 12,18" /></svg>
        </button>
      </div>
      <button type="button" class="garage-btn" data-control="right" aria-label="Steer right">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><polygon points="8,4 8,20 18,12" /></svg>
      </button>
    </div>
  </section>
</BaseLayout>

<style>
  .garage {
    position: relative;
    min-height: calc(100svh - 5rem);
    overflow: hidden;
    background: #bfe3f2;
    -webkit-user-select: none;
    user-select: none;
    -webkit-touch-callout: none;
  }

  #garage-canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  .garage-hud {
    position: relative;
    z-index: 1;
    max-width: 26rem;
    margin: calc(5rem + clamp(1rem, 3vw, 2rem)) clamp(1rem, 3vw, 2rem) 0;
    padding: clamp(1.25rem, 3vw, 2rem);
    background: rgba(15, 23, 32, 0.82);
    color: var(--paper-bright);
  }

  .garage-hud h1 {
    margin-top: 1rem;
    max-width: 10ch;
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 540;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .garage-instructions {
    margin-top: 1.2rem;
    max-width: 22rem;
    font-size: 0.95rem;
    text-shadow: 0 1px 12px rgba(15, 23, 32, 0.5);
  }

  .garage-hud .text-link {
    margin-top: 1.5rem;
  }

  .garage-mobile-only {
    display: none;
  }

  .garage-settings {
    margin-top: 1rem;
  }

  .garage-settings summary {
    display: none;
  }

  .garage-options {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    margin-top: 0.9rem;
  }

  .garage-options label {
    display: grid;
    gap: 0.35rem;
    color: var(--muted-dark);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .garage-options select {
    min-height: 2.5rem;
    padding: 0 0.6rem;
    border: 1px solid rgba(250, 250, 248, 0.35);
    border-radius: 0;
    background: rgba(15, 23, 32, 0.6);
    color: var(--paper-bright);
    font: inherit;
    font-family: var(--sans);
    font-size: 0.85rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .garage-toggles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.1rem;
    margin-top: 0.8rem;
    font-size: 0.85rem;
  }

  .garage-toggles label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    -webkit-user-select: none;
    user-select: none;
  }

  .garage-toggles input {
    width: 1rem;
    height: 1rem;
    accent-color: var(--lane);
  }

  .garage-options select:focus-visible,
  .garage-toggles input:focus-visible,
  .garage-settings summary:focus-visible {
    outline: 3px solid var(--signal);
    outline-offset: 3px;
  }

  .garage-vehicle {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 1.1rem 0 0;
    padding: 0;
    border: 0;
  }

  .garage-vehicle legend {
    width: 100%;
    margin-bottom: 0.45rem;
    color: var(--muted-dark);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .garage-vehicle label {
    position: relative;
    cursor: pointer;
    -webkit-user-select: none;
    user-select: none;
  }

  .garage-vehicle input {
    position: absolute;
    opacity: 0;
  }

  .garage-vehicle span {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    padding: 0 0.85rem;
    border: 1px solid rgba(250, 250, 248, 0.35);
    font-size: 0.85rem;
  }

  .garage-vehicle input:checked + span {
    border-color: #ffcf33;
    background: #ffcf33;
    color: var(--ink);
  }

  .garage-vehicle input:focus-visible + span {
    outline: 3px solid var(--signal);
    outline-offset: 3px;
  }

  .garage-controls {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    opacity: 0.85;
    text-shadow: 0 1px 12px rgba(15, 23, 32, 0.5);
  }

  .garage-loading {
    position: absolute;
    z-index: 1;
    right: 1.5rem;
    bottom: 1.5rem;
    color: var(--paper-bright);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-shadow: 0 1px 12px rgba(15, 23, 32, 0.6);
  }

  .garage-loading[hidden] {
    display: none;
  }

  .garage-penalty-toast[hidden] {
    display: none;
  }

  .garage-stats {
    position: absolute;
    z-index: 1;
    right: 1.5rem;
    top: calc(5rem + 1.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.4rem;
    padding: 0.6rem 0.75rem;
    background: rgba(15, 23, 32, 0.82);
    text-align: right;
    color: var(--paper-bright);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-shadow: 0 1px 12px rgba(15, 23, 32, 0.6);
  }

  .garage-stats p {
    transition: color 0.15s ease;
  }

  .garage-stat-flash {
    animation: garage-stat-flash 0.9s ease;
  }

  @keyframes garage-stat-flash {
    0% {
      color: var(--paper-bright);
    }
    25% {
      color: #f05a28;
    }
    100% {
      color: var(--paper-bright);
    }
  }

  .garage-penalty-toast {
    position: absolute;
    z-index: 2;
    top: 32%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.9);
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(1.4rem, 4vw, 2.6rem);
    letter-spacing: 0.02em;
    color: #f05a28;
    text-shadow: 0 2px 20px rgba(15, 23, 32, 0.7);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .garage-toast-record {
    color: #ffcf33;
  }

  .garage-penalty-toast-show {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
    transition: opacity 0.15s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .garage-touch {
    position: absolute;
    z-index: 1;
    right: 1.25rem;
    bottom: 1.25rem;
    left: 1.25rem;
    display: none;
    align-items: flex-end;
    justify-content: space-between;
    touch-action: none;
  }

  .garage-touch-col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .garage-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.4rem;
    height: 3.4rem;
    border: 1px solid rgba(250, 250, 248, 0.5);
    border-radius: 50%;
    background: rgba(15, 23, 32, 0.45);
    color: var(--paper-bright);
    touch-action: none;
    -webkit-tap-highlight-color: transparent;
    -webkit-touch-callout: none;
    -webkit-user-select: none;
    user-select: none;
  }

  .garage-btn svg {
    pointer-events: none;
  }

  .garage-btn:active {
    background: rgba(255, 96, 52, 0.6);
  }

  @media (max-width: 54rem) {
    .garage-desktop-only {
      display: none;
    }

    .garage-mobile-only {
      display: block;
    }

    .garage-touch {
      display: flex;
    }

    .garage-stats {
      top: auto;
      bottom: 9rem;
      right: 1.25rem;
    }

    /* On phones the panel is a compact bar; settings open on demand over the track. */
    .garage-hud {
      max-width: none;
      margin: 5.6rem 0.6rem 0;
      padding: 0.7rem 0.9rem;
    }

    .garage-hud .eyebrow,
    .garage-instructions,
    .garage-controls,
    .garage-hud .text-link {
      display: none;
    }

    .garage-hud h1 {
      display: none;
    }

    .garage-settings {
      margin-top: 0;
    }

    .garage-settings summary {
      display: flex;
      min-height: 2.5rem;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
      font-weight: 600;
      list-style: none;
    }

    .garage-settings summary::-webkit-details-marker {
      display: none;
    }

    .garage-settings summary::after {
      content: '+';
      font-family: var(--mono);
    }

    .garage-settings[open] summary::after {
      content: '–';
    }
  }
</style>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';
  import { createPerturbationPass } from '../components/perturbation-pass';

  const canvas = document.getElementById('garage-canvas') as HTMLCanvasElement;
  const loadingEl = document.getElementById('garage-loading') as HTMLElement;
  const coneStatEl = document.getElementById('garage-cone-stat') as HTMLElement;
  const lapStatEl = document.getElementById('garage-lap-stat') as HTMLElement;
  const penaltyToastEl = document.getElementById('garage-penalty-toast') as HTMLElement;

  function flashStat(el: HTMLElement) {
    el.classList.remove('garage-stat-flash');
    void el.offsetWidth; // restart the animation even if it's already running
    el.classList.add('garage-stat-flash');
  }

  let penaltyToastTimeout: ReturnType<typeof setTimeout> | undefined;
  function showPenaltyToast(text: string, tone: 'penalty' | 'record' = 'penalty') {
    penaltyToastEl.textContent = text;
    penaltyToastEl.classList.toggle('garage-toast-record', tone === 'record');
    penaltyToastEl.hidden = false;
    penaltyToastEl.classList.remove('garage-penalty-toast-show');
    void penaltyToastEl.offsetWidth;
    penaltyToastEl.classList.add('garage-penalty-toast-show');
    clearTimeout(penaltyToastTimeout);
    penaltyToastTimeout = setTimeout(() => {
      penaltyToastEl.classList.remove('garage-penalty-toast-show');
      penaltyToastEl.hidden = true;
    }, 1400);
  }
  const section = canvas.closest('.garage') as HTMLElement;

  const scene = new THREE.Scene();
  const skyColor = new THREE.Color('#bfe3f2');
  scene.background = skyColor;
  scene.fog = new THREE.Fog(skyColor.getHex(), 70, 260);

  const camera = new THREE.PerspectiveCamera(55, 1, 0.1, 1000);

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFShadowMap;

  // Weather is drawn with PerturbationDrive's shaders; rain and snow also cost grip.
  const WEATHER: Record<string, { id: string; scale: number; grip: number } | undefined> = {
    rain: { id: 'dynamic_rain_filter', scale: 2, grip: 0.8 },
    fog: { id: 'fog_filter', scale: 3, grip: 1 },
    sun: { id: 'dynamic_sun_filter', scale: 2, grip: 1 },
    snow: { id: 'dynamic_snow_filter', scale: 2, grip: 0.6 },
  };
  let weather = 'clear';
  let weatherClock = 0;
  const pass = createPerturbationPass(renderer, camera);

  function resize() {
    const w = section.clientWidth;
    const h = section.clientHeight;
    renderer.setSize(w, h, false);
    pass.setSize(w, h);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }
  window.addEventListener('resize', resize);

  // --- Lights ---
  scene.add(new THREE.HemisphereLight('#ffffff', '#5b6a48', 1.0));
  const sun = new THREE.DirectionalLight('#fff6e8', 2.4);
  sun.position.set(40, 55, -25);
  sun.castShadow = true;
  sun.shadow.mapSize.set(2048, 2048);
  const shadowSize = 70;
  sun.shadow.camera.left = -shadowSize;
  sun.shadow.camera.right = shadowSize;
  sun.shadow.camera.top = shadowSize;
  sun.shadow.camera.bottom = -shadowSize;
  sun.shadow.camera.far = 220;
  sun.shadow.bias = -0.0015;
  scene.add(sun);

  // --- Ground ---
  function makeGroundTexture() {
    const size = 512;
    const cnv = document.createElement('canvas');
    cnv.width = cnv.height = size;
    const ctx = cnv.getContext('2d')!;
    ctx.fillStyle = '#4a8a4a';
    ctx.fillRect(0, 0, size, size);
    ctx.strokeStyle = 'rgba(255,255,255,0.10)';
    ctx.lineWidth = 2;
    const step = size / 8;
    for (let i = 0; i <= size; i += step) {
      ctx.beginPath();
      ctx.moveTo(i, 0);
      ctx.lineTo(i, size);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(0, i);
      ctx.lineTo(size, i);
      ctx.stroke();
    }
    const tex = new THREE.CanvasTexture(cnv);
    tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
    tex.repeat.set(80, 80);
    tex.anisotropy = 4;
    return tex;
  }

  const ground = new THREE.Mesh(
    new THREE.PlaneGeometry(3000, 3000),
    new THREE.MeshStandardMaterial({ map: makeGroundTexture(), roughness: 1 }),
  );
  ground.rotation.x = -Math.PI / 2;
  ground.receiveShadow = true;
  scene.add(ground);

  // --- Circuits. Each is a closed path of points with a tangent at each one; the road
  // mesh, dashes, cones, off-road test and lap-crossing math all derive from it, so
  // everything lines up with the actual shape of the road.
  const roadWidth = 9;
  type PathPoint = { x: number; z: number; tx: number; tz: number };

  // The original cone course: two straights joined by two turns.
  function stadiumPoints() {
    const straightLength = 44;
    const turnRadius = 15;
    const halfL = straightLength / 2;
    const segsPerTurn = 40;
    const straightSegs = Math.max(4, Math.round((segsPerTurn / (Math.PI * turnRadius)) * straightLength));
    const raw: { x: number; z: number }[] = [];
    for (let i = 0; i < straightSegs; i++) raw.push({ x: -halfL + (i / straightSegs) * straightLength, z: -turnRadius });
    for (let i = 0; i < segsPerTurn; i++) {
      const theta = -Math.PI / 2 + (i / segsPerTurn) * Math.PI;
      raw.push({ x: halfL + Math.cos(theta) * turnRadius, z: Math.sin(theta) * turnRadius });
    }
    for (let i = 0; i < straightSegs; i++) raw.push({ x: halfL - (i / straightSegs) * straightLength, z: turnRadius });
    for (let i = 0; i < segsPerTurn; i++) {
      const theta = Math.PI / 2 + (i / segsPerTurn) * Math.PI;
      raw.push({ x: -halfL + Math.cos(theta) * turnRadius, z: Math.sin(theta) * turnRadius });
    }
    return raw;
  }

  // Layouts after well-known circuits, simplified and scaled down: [east, north] in metres,
  // starting on the main straight.
  const LAYOUTS: Record<string, { points: number[][]; scale: number }> = {
    // Main straight, Rettifilo chicane, Curva Grande, Roggia, the two Lesmos, the back
    // straight with the Ascari chicane, and the Parabolica back onto the straight.
    monza: {
      scale: 0.75,
      points: [
        [0, -130], [0, 0], [0, 150], [7, 170], [-9, 187], [0, 205], [14, 250], [40, 292], [78, 316],
        [110, 320], [122, 311], [133, 327], [147, 318], [176, 312], [194, 292], [204, 262], [200, 232],
        [184, 170], [160, 90], [140, 20], [128, -30], [142, -50], [124, -72], [131, -95], [118, -150],
        [100, -200], [70, -230], [36, -232], [12, -210], [2, -175],
      ],
    },
    // Start straight into the La Source hairpin, down through Eau Rouge, the Kemmel straight,
    // Les Combes, Rivage, Pouhon, Stavelot, Blanchimont and the Bus Stop chicane.
    spa: {
      scale: 0.85,
      points: [
        [0, -40], [0, 30], [6, 62], [24, 76], [42, 66], [46, 40], [38, 14], [54, -8], [46, -32],
        [70, -72], [110, -136], [140, -180], [156, -196], [170, -198], [178, -214], [188, -240],
        [182, -266], [160, -264], [132, -250], [106, -262], [84, -286], [56, -292], [28, -282],
        [8, -256], [-12, -220], [-20, -170], [-14, -122], [-4, -100], [-14, -86], [-2, -72],
      ],
    },
  };

  function circuitPath(key: string): PathPoint[] {
    let raw: { x: number; z: number }[];
    if (key === 'cones') {
      raw = stadiumPoints();
    } else {
      const layout = LAYOUTS[key];
      const curve = new THREE.CatmullRomCurve3(
        layout.points.map(([e, n]) => new THREE.Vector3(e * layout.scale, 0, -n * layout.scale)),
        true,
        'centripetal',
      );
      raw = curve.getSpacedPoints(Math.round(curve.getLength())).slice(0, -1).map((v) => ({ x: v.x, z: v.z }));
    }
    const n = raw.length;
    return raw.map((p, i) => {
      const next = raw[(i + 1) % n];
      const prev = raw[(i - 1 + n) % n];
      const dx = next.x - prev.x;
      const dz = next.z - prev.z;
      const len = Math.hypot(dx, dz) || 1;
      return { x: p.x, z: p.z, tx: dx / len, tz: dz / len };
    });
  }

  let trackPath: PathPoint[] = [];
  let trackAlong: number[] = []; // distance along the path at each point
  let trackLength = 1;
  let startPoint: PathPoint;

  // Signed perpendicular distance of (x, z) from the track's centerline: 0 = dead
  // center, positive = toward the outer edge. Used both to draw the road and to
  // tell whether the car is still on it.
  function trackOffset(x: number, z: number) {
    let best = Infinity;
    let bestOffset = 0;
    for (const p of trackPath) {
      const dx = x - p.x;
      const dz = z - p.z;
      const distSq = dx * dx + dz * dz;
      if (distSq < best) {
        best = distSq;
        bestOffset = dx * p.tz - dz * p.tx; // dot with the outward normal (tz, -tx)
      }
    }
    return bestOffset;
  }

  // A point at distance s along the path, interpolated, with its tangent.
  function pathAt(s: number) {
    const d = ((s % trackLength) + trackLength) % trackLength;
    let lo = 0;
    let hi = trackAlong.length - 1;
    while (hi - lo > 1) {
      const mid = (lo + hi) >> 1;
      if (trackAlong[mid] <= d) lo = mid;
      else hi = mid;
    }
    const a = trackPath[lo];
    const b = trackPath[(lo + 1) % trackPath.length];
    const span = (lo + 1 < trackAlong.length ? trackAlong[lo + 1] : trackLength) - trackAlong[lo];
    const f = span > 0 ? (d - trackAlong[lo]) / span : 0;
    return { x: a.x + (b.x - a.x) * f, z: a.z + (b.z - a.z) * f, tx: a.tx, tz: a.tz };
  }

  function buildRoadGeometry(path: PathPoint[], width: number, y: number) {
    const n = path.length;
    const positions: number[] = [];
    const uvs: number[] = [];
    const indices: number[] = [];
    for (let i = 0; i < n; i++) {
      const p = path[i];
      const nx = p.tz;
      const nz = -p.tx;
      positions.push(p.x - nx * (width / 2), y, p.z - nz * (width / 2));
      positions.push(p.x + nx * (width / 2), y, p.z + nz * (width / 2));
      uvs.push(0, i, 1, i);
    }
    for (let i = 0; i < n; i++) {
      const a = i * 2;
      const b = i * 2 + 1;
      const c = ((i + 1) % n) * 2;
      const d = ((i + 1) % n) * 2 + 1;
      indices.push(a, b, d, a, d, c);
    }
    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
    geo.setAttribute('uv', new THREE.Float32BufferAttribute(uvs, 2));
    geo.setIndex(indices);
    geo.computeVertexNormals();
    return geo;
  }

  const roadMat = new THREE.MeshStandardMaterial({ color: '#45454b', roughness: 1, side: THREE.DoubleSide });
  const kerbMat = new THREE.MeshStandardMaterial({ color: '#d9d6cc', roughness: 1, side: THREE.DoubleSide });
  const dashGeo = new THREE.PlaneGeometry(1.6, 0.25);
  dashGeo.rotateX(-Math.PI / 2);
  const dashMat = new THREE.MeshStandardMaterial({ color: '#f5f2e8', roughness: 0.9 });
  const localXAxis = new THREE.Vector3(1, 0, 0);

  // Checkered start/finish line, at the start of the path, spanning the full road width.
  function makeCheckerTexture() {
    const size = 32;
    const cnv = document.createElement('canvas');
    cnv.width = cnv.height = size;
    const ctx = cnv.getContext('2d')!;
    ctx.fillStyle = '#f5f2e8';
    ctx.fillRect(0, 0, size, size);
    ctx.fillStyle = '#141614';
    ctx.fillRect(0, 0, size / 2, size / 2);
    ctx.fillRect(size / 2, size / 2, size / 2, size / 2);
    const tex = new THREE.CanvasTexture(cnv);
    tex.wrapS = tex.wrapT = THREE.RepeatWrapping;
    tex.repeat.set(2, 10);
    tex.magFilter = THREE.NearestFilter;
    return tex;
  }
  const finishLineGeo = new THREE.PlaneGeometry(1.6, roadWidth);
  finishLineGeo.rotateX(-Math.PI / 2);
  const finishLineMat = new THREE.MeshStandardMaterial({ map: makeCheckerTexture(), roughness: 0.9, side: THREE.DoubleSide });

  // --- Cones. Knock them over by driving into them.
  const coneHeight = 0.8;
  const coneGeo = new THREE.ConeGeometry(0.35, coneHeight, 12);
  coneGeo.translate(0, coneHeight / 2, 0); // pivot at the base, so it topples instead of sinking
  const coneMat = new THREE.MeshStandardMaterial({ color: '#f05a28', roughness: 0.8 });
  const coneMargin = roadWidth / 2 + 1.3;
  // Spacing for laying out the cones; hits use each vehicle's footprint instead.
  const carHitRadius = 1.5;
  const coneHitRadius = 0.5;
  const coneBaseRadius = 0.22;
  const knockSpeedThreshold = 0.6;
  type Cone = {
    mesh: THREE.Object3D;
    base: THREE.Vector3;
    knocked: boolean;
    progress: number;
    fallAxis: THREE.Vector3;
  };
  let cones: Cone[] = [];
  let coneModel: THREE.Object3D | null = null;
  // Each cone is a pivot at its base; it shows a simple cone until the scanned one loads.
  function spawnCone(x: number, z: number) {
    const cone = new THREE.Group();
    if (coneModel) {
      cone.add(coneModel.clone());
    } else {
      const placeholder = new THREE.Mesh(coneGeo, coneMat);
      placeholder.castShadow = true;
      cone.add(placeholder);
    }
    const base = new THREE.Vector3(x, 0, z);
    cone.position.copy(base);
    circuitGroup.add(cone);
    cones.push({ mesh: cone, base, knocked: false, progress: 0, fallAxis: new THREE.Vector3(1, 0, 0) });
  }

  {
    const coneDraco = new DRACOLoader();
    coneDraco.setDecoderPath('/draco/');
    const coneLoader = new GLTFLoader();
    coneLoader.setDRACOLoader(coneDraco);
    coneLoader.loadAsync('/models/cone.glb').then((gltf) => {
      // The scan is centred on its middle; scale it to the cone height and stand it on its base.
      const model = gltf.scene;
      const box = new THREE.Box3().setFromObject(model);
      const scale = coneHeight / (box.max.y - box.min.y);
      model.scale.setScalar(scale);
      model.position.y = -box.min.y * scale;
      model.traverse((o) => {
        if ((o as THREE.Mesh).isMesh) o.castShadow = true;
      });
      coneModel = model;
      for (const cone of cones) cone.mesh.clear().add(model.clone());
    });
  }

  // --- Building a circuit's world ---
  const circuitGroup = new THREE.Group();
  scene.add(circuitGroup);

  function buildCircuitWorld(key: string) {
    circuitGroup.traverse((o) => {
      const mesh = o as THREE.Mesh;
      if (mesh.isMesh && mesh.geometry !== dashGeo && mesh.geometry !== coneGeo && mesh.geometry !== finishLineGeo) mesh.geometry.dispose();
    });
    circuitGroup.clear();
    cones = [];

    trackPath = circuitPath(key);
    trackAlong = [0];
    for (let i = 1; i < trackPath.length; i++) {
      trackAlong.push(trackAlong[i - 1] + Math.hypot(trackPath[i].x - trackPath[i - 1].x, trackPath[i].z - trackPath[i - 1].z));
    }
    const last = trackPath[trackPath.length - 1];
    trackLength = trackAlong[trackAlong.length - 1] + Math.hypot(trackPath[0].x - last.x, trackPath[0].z - last.z);
    startPoint = trackPath[0];

    const kerbs = new THREE.Mesh(buildRoadGeometry(trackPath, roadWidth + 1.2, 0.04), kerbMat);
    kerbs.receiveShadow = true;
    const road = new THREE.Mesh(buildRoadGeometry(trackPath, roadWidth, 0.05), roadMat);
    road.receiveShadow = true;
    circuitGroup.add(kerbs, road);

    // Dashed centerline, each dash aligned to the road's tangent, about every 5 m.
    for (let s = 0; s < trackLength; s += 5) {
      const p = pathAt(s);
      const dash = new THREE.Mesh(dashGeo, dashMat);
      dash.position.set(p.x, 0.07, p.z);
      dash.quaternion.setFromUnitVectors(localXAxis, new THREE.Vector3(p.tx, 0, p.tz));
      dash.receiveShadow = true;
      circuitGroup.add(dash);
    }

    const finishLine = new THREE.Mesh(finishLineGeo, finishLineMat);
    finishLine.position.set(startPoint.x, 0.08, startPoint.z);
    finishLine.quaternion.setFromUnitVectors(localXAxis, new THREE.Vector3(startPoint.tx, 0, startPoint.tz));
    finishLine.receiveShadow = true;
    circuitGroup.add(finishLine);

    if (key === 'cones') {
      // Cones along the outer edge, a slalom and two gates.
      for (let i = 0; i < trackPath.length; i += 8) {
        const p = trackPath[i];
        spawnCone(p.x + p.tz * coneMargin, p.z - p.tx * coneMargin);
      }
      // A car needs its center at least carHitRadius + coneHitRadius from a cone to
      // clear it without knocking it over, and the road's usable half-width (before
      // "off road") is roughly roadWidth / 2 + 0.5. Both the slalom offsets and the
      // gate gap below are chosen to leave real clearance on that math, not just by eye.
      const minClearance = carHitRadius + coneHitRadius + 0.5;
      const pointAt = (frac: number) => {
        const p = trackPath[Math.floor(frac * trackPath.length) % trackPath.length];
        return { p, nx: p.tz, nz: -p.tx };
      };
      const slalomCount = 12;
      const slalomLateral = roadWidth / 4;
      for (let i = 0; i < slalomCount; i++) {
        const { p, nx, nz } = pointAt(0.06 + (i / (slalomCount - 1)) * 0.88);
        const lateral = (i % 2 === 0 ? 1 : -1) * slalomLateral;
        spawnCone(p.x + nx * lateral, p.z + nz * lateral);
      }
      const gateHalfGap = minClearance + 0.5;
      for (const frac of [0.35, 0.65]) {
        const { p, nx, nz } = pointAt(frac);
        spawnCone(p.x + nx * gateHalfGap, p.z + nz * gateHalfGap);
        spawnCone(p.x - nx * gateHalfGap, p.z - nz * gateHalfGap);
      }
    } else {
      // Race circuits: cones lining both edges, every 25 m.
      for (let s = 12; s < trackLength; s += 25) {
        const p = pathAt(s);
        for (const side of [1, -1]) spawnCone(p.x + p.tz * coneMargin * side, p.z - p.tx * coneMargin * side);
      }
    }
  }
  buildCircuitWorld('cones');

  function updateStats() {
    const knocked = cones.filter((c) => c.knocked).length;
    const standing = cones.length - knocked;
    coneStatEl.textContent = `${standing} standing · ${knocked} knocked over`;
  }
  updateStats();

  // Give every cone a clean slate at the start of each lap.
  function resetCones() {
    for (const cone of cones) {
      cone.knocked = false;
      cone.progress = 0;
      cone.mesh.position.copy(cone.base);
      cone.mesh.quaternion.identity();
    }
    updateStats();
  }

  function updateCones(dt: number) {
    for (const cone of cones) {
      if (!cone.knocked) {
        const dx = cone.base.x - car_state.x;
        const dz = cone.base.z - car_state.z;
        const distSq = dx * dx + dz * dz;
        // The vehicle's own footprint, a rectangle along its heading, against the cone's base.
        const along = dx * Math.sin(car_state.heading) + dz * Math.cos(car_state.heading);
        const across = dx * Math.cos(car_state.heading) - dz * Math.sin(car_state.heading);
        const touching =
          Math.abs(along) < vehicle.halfLength + coneBaseRadius && Math.abs(across) < vehicle.halfWidth + coneBaseRadius;
        if (touching && Math.abs(car_state.speed) > knockSpeedThreshold) {
          cone.knocked = true;
          const dist = Math.sqrt(distSq) || 1;
          // Tip over away from the car, perpendicular to the impact direction.
          cone.fallAxis.set(dz / dist, 0, -dx / dist);
          updateStats();
          flashStat(coneStatEl);
          applyConePenalty();
        }
        continue;
      }
      if (cone.progress < 1) {
        cone.progress = Math.min(1, cone.progress + dt * 3.2);
        cone.mesh.quaternion.setFromAxisAngle(cone.fallAxis, cone.progress * (Math.PI / 2));
        const slide = Math.sin(cone.progress * Math.PI * 0.5) * 0.25;
        cone.mesh.position.set(
          cone.base.x - cone.fallAxis.z * slide,
          cone.base.y,
          cone.base.z + cone.fallAxis.x * slide,
        );
      }
    }
  }

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // --- Vehicles: Fortuna and the GS, both scanned, both facing -Z, tyres on y = 0 ---
  type Vehicle = {
    url: string;
    model: THREE.Object3D | null;
    length: number;
    halfLength: number; // footprint for cone hits
    halfWidth: number;
    maxSpeed: number;
    accel: number;
    turnRate: number;
    leans: boolean;
  };
  const vehicles: Record<string, Vehicle> = {
    // Fortuna's body is about 1.83 m wide without mirrors; the GS is narrow at cone height.
    fortuna: { url: '/models/fortuna.glb', model: null, length: 4.6, halfLength: 2.35, halfWidth: 0.92, maxSpeed: 16, accel: 9, turnRate: 2.0, leans: false },
    gs: { url: '/models/gs.glb', model: null, length: 2.2, halfLength: 1.08, halfWidth: 0.3, maxSpeed: 22, accel: 11, turnRate: 2.4, leans: true },
  };
  let vehicle = vehicles.fortuna;
  let vehicleKey = 'fortuna';
  let circuitKey = 'cones';

  // rig: position and heading; leanPivot: roll about the tyres' contact line on the ground.
  const rig = new THREE.Group();
  const leanPivot = new THREE.Group();
  rig.add(leanPivot);
  scene.add(rig);
  let car: THREE.Object3D | null = null;
  let carLength = vehicle.length;
  // The models' fronts face -Z; add a half-turn so "forward" (+Z) drives nose-first.
  const carHeadingOffset = Math.PI;

  const dracoLoader = new DRACOLoader();
  dracoLoader.setDecoderPath('/draco/');
  const loader = new GLTFLoader();
  loader.setDRACOLoader(dracoLoader);

  function loadVehicle(v: Vehicle) {
    if (v.model) return Promise.resolve(v.model);
    loadingEl.hidden = false;
    loadingEl.textContent = 'Loading…';
    return loader.loadAsync(v.url).then((gltf) => {
      const model = gltf.scene;
      model.traverse((o) => {
        if ((o as THREE.Mesh).isMesh) {
          o.castShadow = true;
          o.receiveShadow = true;
        }
      });
      // Sit it on the ground, centred over its contact line.
      const box = new THREE.Box3().setFromObject(model);
      const size = box.getSize(new THREE.Vector3());
      v.length = Math.max(size.x, size.z);
      model.position.y -= box.min.y;
      v.model = model;
      loadingEl.hidden = true;
      return model;
    });
  }

  function useVehicle(key: string) {
    const v = vehicles[key];
    loadVehicle(v)
      .then((model) => {
        vehicle = v;
        vehicleKey = key;
        leanPivot.clear();
        leanPivot.add(model);
        car = rig;
        carLength = v.length;
        buildGhost(model);
        restartRace();
      })
      .catch((err) => {
        console.error('Failed to load the vehicle', err);
        loadingEl.hidden = false;
        loadingEl.textContent = 'Could not load the model.';
      });
  }
  useVehicle('fortuna');
  document.querySelectorAll<HTMLInputElement>('input[name="vehicle"]').forEach((radio) =>
    radio.addEventListener('change', () => {
      if (radio.checked) {
        useVehicle(radio.value);
        radio.blur();
      }
    }),
  );

  // --- Controls ---
  const input = { forward: false, back: false, left: false, right: false };

  const keyMap: Record<string, keyof typeof input> = {
    ArrowUp: 'forward',
    KeyW: 'forward',
    ArrowDown: 'back',
    KeyS: 'back',
    ArrowLeft: 'left',
    KeyA: 'left',
    ArrowRight: 'right',
    KeyD: 'right',
  };

  const inForm = (e: KeyboardEvent) => e.target instanceof HTMLSelectElement || e.target instanceof HTMLInputElement;
  window.addEventListener('keydown', (e) => {
    if (inForm(e)) return;
    const key = keyMap[e.code];
    if (key) {
      input[key] = true;
      e.preventDefault();
    }
    if (e.code === 'Space') {
      input.forward = false;
      input.back = false;
    }
  });
  window.addEventListener('keyup', (e) => {
    if (inForm(e)) return;
    const key = keyMap[e.code];
    if (key) {
      input[key] = false;
      e.preventDefault();
    }
  });

  document.querySelectorAll<HTMLButtonElement>('.garage-btn').forEach((btn) => {
    const key = btn.dataset.control as keyof typeof input;
    const press = (v: boolean) => (e: Event) => {
      e.preventDefault();
      input[key] = v;
    };
    btn.addEventListener('pointerdown', press(true));
    btn.addEventListener('pointerup', press(false));
    btn.addEventListener('pointerleave', press(false));
    btn.addEventListener('pointercancel', press(false));
  });

  // --- Simulation state ---
  // Spawn a few steps back along the path from the start line (still genuinely on the
  // road, mid-corner), facing the way the track actually points there, so driving
  // forward naturally brings the car up to, and then across, the start line.
  const spawnBehind = 6;
  const car_state = {
    x: startPoint.x - spawnBehind * startPoint.tx,
    z: startPoint.z - spawnBehind * startPoint.tz,
    heading: Math.atan2(startPoint.tx, startPoint.tz),
    speed: 0,
  };
  const maxReverse = 7;
  const friction = 5;
  let lean = 0;
  let showcase = true; // turn the vehicle slowly on the spot until the first input
  let showcaseAngle = 0;

  const timer = new THREE.Timer();
  timer.connect(document);
  // Frame the camera on the car's actual spawn point from the first frame, no catch-up pan.
  const spawnCamDistance = carLength * 1.9 + 4;
  const spawnCamHeight = carLength * 0.55 + 2.5;
  const camPos = new THREE.Vector3(
    car_state.x - Math.sin(car_state.heading) * spawnCamDistance,
    spawnCamHeight,
    car_state.z - Math.cos(car_state.heading) * spawnCamDistance,
  );
  camera.position.copy(camPos);
  const camTarget = new THREE.Vector3(
    car_state.x + Math.sin(car_state.heading) * 3,
    1.2,
    car_state.z + Math.cos(car_state.heading) * 3,
  );

  // --- Lap timer: crossing the checkered line while on the road starts or completes a
  // lap. "Crossing" is measured as signed distance along the start line's own tangent,
  // which works regardless of the track's shape. Driving off the road cancels the
  // lap in progress.
  function forwardOffset(x: number, z: number) {
    return (x - startPoint.x) * startPoint.tx + (z - startPoint.z) * startPoint.tz;
  }

  let lapPrevForward = forwardOffset(car_state.x, car_state.z);
  let lapStarted = false;
  let lapNumber = 0;
  let lapElapsed = 0;
  // The best lap survives a reload, so a returning driver has something to beat.
  // One record per circuit and vehicle; the original cone course keeps its old key.
  const bestLapKey = () =>
    circuitKey === 'cones' && vehicleKey === 'fortuna' ? 'garage-best-lap' : `garage-best-lap:${circuitKey}:${vehicleKey}`;
  function readBestLap() {
    try {
      const stored = Number.parseFloat(localStorage.getItem(bestLapKey()) ?? '');
      return Number.isFinite(stored) ? stored : null;
    } catch {
      return null;
    }
  }
  function saveBestLap(t: number) {
    try {
      localStorage.setItem(bestLapKey(), String(t));
    } catch {
      // Storage unavailable (private mode, blocked site data): the record lasts this visit.
    }
  }
  let bestLapTime: number | null = readBestLap();
  let lapCrossingCooldown = 0;
  let offRoad = false;

  // --- Ghost: the best lap, replayed as a see-through copy of the vehicle ---
  type Sample = [number, number, number, number]; // lap clock, x, z, heading
  let ghostLap: Sample[] | null = null;
  let recording: Sample[] = [];
  let lapClock = 0; // time on track this lap, without penalties
  let lastSample = -1;
  const ghostEnabled = document.getElementById('garage-ghost') as HTMLInputElement;
  const ghost = new THREE.Group();
  ghost.visible = false;
  scene.add(ghost);
  const ghostKey = () => `garage-ghost:${circuitKey}:${vehicleKey}`;
  function readGhost() {
    try {
      const stored = JSON.parse(localStorage.getItem(ghostKey()) ?? 'null');
      return Array.isArray(stored) ? (stored as Sample[]) : null;
    } catch {
      return null;
    }
  }
  function saveGhost(samples: Sample[]) {
    try {
      localStorage.setItem(ghostKey(), JSON.stringify(samples.map((p) => p.map((v) => Math.round(v * 100) / 100))));
    } catch {
      // Storage full or unavailable: the ghost lasts this visit.
    }
  }
  function buildGhost(model: THREE.Object3D) {
    ghost.clear();
    const copy = model.clone();
    const material = new THREE.MeshBasicMaterial({ color: '#ffcf33', transparent: true, opacity: 0.32, depthWrite: false });
    copy.traverse((o) => {
      const mesh = o as THREE.Mesh;
      if (mesh.isMesh) {
        mesh.material = material;
        mesh.castShadow = false;
      }
    });
    ghost.add(copy);
  }
  function updateGhost() {
    if (!ghostLap || !lapStarted || !ghostEnabled.checked || ghostLap.length < 2) {
      ghost.visible = false;
      return;
    }
    let i = 0;
    while (i < ghostLap.length - 2 && ghostLap[i + 1][0] < lapClock) i++;
    const a = ghostLap[i];
    const b = ghostLap[i + 1];
    if (lapClock > ghostLap[ghostLap.length - 1][0]) {
      ghost.visible = false;
      return;
    }
    const f = b[0] > a[0] ? THREE.MathUtils.clamp((lapClock - a[0]) / (b[0] - a[0]), 0, 1) : 0;
    const dh = Math.atan2(Math.sin(b[3] - a[3]), Math.cos(b[3] - a[3]));
    ghost.visible = true;
    ghost.position.set(a[1] + (b[1] - a[1]) * f, 0, a[2] + (b[2] - a[2]) * f);
    ghost.rotation.y = a[3] + dh * f + carHeadingOffset;
  }

  // --- Traffic: slower cars on both lanes, following the road ---
  type TrafficCar = { s: number; lane: number; v: number; target: number; mesh: THREE.Group; cooldown: number };
  let trafficCars: TrafficCar[] = [];
  const trafficEnabled = document.getElementById('garage-traffic') as HTMLInputElement;
  const trafficColours = ['#56606a', '#8d2f23', '#2c4a6b', '#d9d6cc', '#3f5a35'];
  function makeTrafficCar(colour: string) {
    const car = new THREE.Group();
    const paint = new THREE.MeshStandardMaterial({ color: colour, roughness: 0.5, metalness: 0.2 });
    const glass = new THREE.MeshStandardMaterial({ color: '#1b2229', roughness: 0.2 });
    const body = new THREE.Mesh(new THREE.BoxGeometry(1.85, 0.7, 4.4), paint);
    body.position.y = 0.6;
    const cabin = new THREE.Mesh(new THREE.BoxGeometry(1.6, 0.55, 2.3), glass);
    cabin.position.set(0, 1.2, 0.2);
    for (const m of [body, cabin]) {
      m.castShadow = true;
      car.add(m);
    }
    return car;
  }
  function spawnTraffic() {
    for (const t of trafficCars) scene.remove(t.mesh);
    trafficCars = [];
    if (!trafficEnabled.checked) return;
    const count = Math.max(3, Math.min(8, Math.round(trackLength / 90)));
    for (let i = 0; i < count; i++) {
      const target = 7 + ((i * 37) % 5);
      const mesh = makeTrafficCar(trafficColours[i % trafficColours.length]);
      scene.add(mesh);
      trafficCars.push({ s: 40 + (i * trackLength) / count, lane: i % 2 ? 2.1 : -2.1, v: target, target, mesh, cooldown: 0 });
    }
    updateTraffic(0);
  }
  const contactPenaltySeconds = 5;
  function updateTraffic(dt: number) {
    for (const t of trafficCars) {
      // Keep a gap to the car ahead in the same lane.
      let target = t.target;
      for (const o of trafficCars) {
        if (o === t || o.lane !== t.lane) continue;
        const gap = (((o.s - t.s) % trackLength) + trackLength) % trackLength;
        if (gap < 14) target = Math.min(target, o.v * 0.9);
      }
      t.v += THREE.MathUtils.clamp(target - t.v, -6 * dt, 2 * dt);
      t.s += t.v * dt;
      const p = pathAt(t.s);
      t.mesh.position.set(p.x + p.tz * t.lane, 0, p.z - p.tx * t.lane);
      t.mesh.rotation.y = Math.atan2(p.tx, p.tz);
      t.cooldown -= dt;

      // Contact with the player: the player's footprint against the traffic car's.
      const dx = t.mesh.position.x - car_state.x;
      const dz = t.mesh.position.z - car_state.z;
      const along = dx * Math.sin(car_state.heading) + dz * Math.cos(car_state.heading);
      const across = dx * Math.cos(car_state.heading) - dz * Math.sin(car_state.heading);
      if (Math.abs(along) < vehicle.halfLength + 2.2 && Math.abs(across) < vehicle.halfWidth + 0.95 && t.cooldown <= 0) {
        t.cooldown = 1.5;
        car_state.speed *= 0.35;
        const push = Math.sign(along) || 1;
        car_state.x -= Math.sin(car_state.heading) * push * 0.6;
        car_state.z -= Math.cos(car_state.heading) * push * 0.6;
        if (lapStarted && !offRoad) {
          lapElapsed += contactPenaltySeconds;
          flashStat(lapStatEl);
          showPenaltyToast(`Contact — +${contactPenaltySeconds}s`);
        }
      }
    }
  }
  trafficEnabled.addEventListener('change', () => {
    spawnTraffic();
    trafficEnabled.blur();
  });

  // Back to the grid: on a new circuit, a new vehicle, or traffic switched on.
  function restartRace() {
    car_state.x = startPoint.x - spawnBehind * startPoint.tx;
    car_state.z = startPoint.z - spawnBehind * startPoint.tz;
    car_state.heading = Math.atan2(startPoint.tx, startPoint.tz);
    car_state.speed = 0;
    camPos.set(
      car_state.x - Math.sin(car_state.heading) * (carLength * 1.9 + 4),
      carLength * 0.55 + 2.5,
      car_state.z - Math.cos(car_state.heading) * (carLength * 1.9 + 4),
    );
    camTarget.set(car_state.x + Math.sin(car_state.heading) * 3, 1.2, car_state.z + Math.cos(car_state.heading) * 3);
    lapPrevForward = forwardOffset(car_state.x, car_state.z);
    lapStarted = false;
    lapNumber = 0;
    lapElapsed = 0;
    lapClock = 0;
    recording = [];
    offRoad = false;
    bestLapTime = readBestLap();
    ghostLap = readGhost();
    resetCones();
    spawnTraffic();
    updateLapDisplay();
  }

  function formatLapTime(t: number) {
    return `${t.toFixed(1)}s`;
  }

  function updateLapDisplay() {
    if (offRoad) {
      lapStatEl.textContent = 'Out of road';
    } else if (!lapStarted) {
      lapStatEl.textContent =
        bestLapTime === null
          ? 'Drive through the start line to begin a lap'
          : `Your best: ${formatLapTime(bestLapTime)} · cross the start line to beat it`;
    } else if (bestLapTime === null) {
      lapStatEl.textContent = `Lap ${lapNumber} — ${formatLapTime(lapElapsed)}`;
    } else {
      lapStatEl.textContent = `Lap ${lapNumber} — ${formatLapTime(lapElapsed)} · best ${formatLapTime(bestLapTime)}`;
    }
  }
  updateLapDisplay();

  const conePenaltySeconds = 10;
  function applyConePenalty() {
    if (!lapStarted || offRoad) return;
    lapElapsed += conePenaltySeconds;
    updateLapDisplay();
    flashStat(lapStatEl);
    showPenaltyToast(`Cone hit — +${conePenaltySeconds}s`);
  }

  function updateLap(dt: number) {
    if (lapCrossingCooldown > 0) lapCrossingCooldown -= dt;

    const nowOffRoad = Math.abs(trackOffset(car_state.x, car_state.z)) > roadWidth / 2 + 0.5;
    if (nowOffRoad && !offRoad && lapStarted) {
      lapStarted = false;
      lapElapsed = 0;
    }
    offRoad = nowOffRoad;

    const forward = forwardOffset(car_state.x, car_state.z);
    if (!offRoad) {
      const crossedFinish = lapPrevForward < 0 && forward >= 0;
      if (crossedFinish && lapCrossingCooldown <= 0) {
        if (lapStarted && (bestLapTime === null || lapElapsed < bestLapTime)) {
          showPenaltyToast(
            bestLapTime === null ? `Lap set — ${formatLapTime(lapElapsed)}` : `Personal best — ${formatLapTime(lapElapsed)}`,
            'record',
          );
          bestLapTime = lapElapsed;
          saveBestLap(bestLapTime);
          ghostLap = recording;
          saveGhost(recording);
        }
        lapNumber += 1;
        lapStarted = true;
        lapElapsed = 0;
        lapClock = 0;
        lastSample = -1;
        recording = [];
        lapCrossingCooldown = 2;
        resetCones();
      }
    }
    lapPrevForward = forward;

    if (lapStarted) {
      lapElapsed += dt;
      lapClock += dt;
      if (lapClock - lastSample >= 0.05) {
        recording.push([lapClock, car_state.x, car_state.z, car_state.heading]);
        lastSample = lapClock;
      }
    }
    updateLapDisplay();
  }

  function tick() {
    requestAnimationFrame(tick);
    timer.update();
    const dt = Math.min(timer.getDelta(), 0.05);

    const grip = WEATHER[weather]?.grip ?? 1;
    const maxSpeed = vehicle.maxSpeed;
    const accel = vehicle.accel * grip;
    const maxTurnRate = vehicle.turnRate * (0.6 + 0.4 * grip);
    if (showcase && (input.forward || input.back || input.left || input.right)) showcase = false;
    if (input.forward) car_state.speed += accel * dt;
    else if (input.back) car_state.speed -= accel * dt;
    else {
      const decay = Math.sign(car_state.speed) * friction * dt;
      car_state.speed = Math.abs(decay) > Math.abs(car_state.speed) ? 0 : car_state.speed - decay;
    }
    car_state.speed = Math.max(-maxReverse, Math.min(maxSpeed, car_state.speed));

    const turnInput = (input.left ? 1 : 0) - (input.right ? 1 : 0);
    const speedFactor = Math.min(1, Math.abs(car_state.speed) / 4) * 0.85 + 0.15;
    const direction = car_state.speed >= 0 ? 1 : -1;
    const yawRate = turnInput * maxTurnRate * speedFactor * direction;
    car_state.heading += yawRate * dt;

    car_state.x += Math.sin(car_state.heading) * car_state.speed * dt;
    car_state.z += Math.cos(car_state.heading) * car_state.speed * dt;

    if (car) {
      car.position.x = car_state.x;
      car.position.z = car_state.z;
      if (showcase && !reduceMotion.matches) showcaseAngle += dt * 0.6;
      else showcaseAngle *= Math.max(0, 1 - dt * 6);
      car.rotation.y = car_state.heading + carHeadingOffset + showcaseAngle;
      // Lean into the turn from the lateral acceleration (v·ω/g), easing in and out.
      const target = vehicle.leans ? THREE.MathUtils.clamp(Math.atan((car_state.speed * yawRate) / 9.81), -0.75, 0.75) : 0;
      lean += (target - lean) * Math.min(1, dt * 5);
      leanPivot.rotation.z = lean;
    }

    updateCones(dt);
    updateLap(dt);
    updateTraffic(dt);
    updateGhost();

    const camDistance = carLength * 1.9 + 4;
    const camHeight = carLength * 0.55 + 2.5;
    const desiredCamPos = new THREE.Vector3(
      car_state.x - Math.sin(car_state.heading) * camDistance,
      camHeight,
      car_state.z - Math.cos(car_state.heading) * camDistance,
    );
    camPos.lerp(desiredCamPos, 1 - Math.pow(0.001, dt));
    camera.position.copy(camPos);

    const desiredTarget = new THREE.Vector3(
      car_state.x + Math.sin(car_state.heading) * 3,
      1.2,
      car_state.z + Math.cos(car_state.heading) * 3,
    );
    camTarget.lerp(desiredTarget, 1 - Math.pow(0.0005, dt));
    camera.lookAt(camTarget);

    weatherClock += dt;
    const conditions = WEATHER[weather];
    if (conditions) pass.render(scene, conditions.id, conditions.scale, weatherClock);
    else renderer.render(scene, camera);
  }

  // --- Settings panel ---
  const circuitSelect = document.getElementById('garage-circuit') as HTMLSelectElement;
  circuitSelect.addEventListener('change', () => {
    circuitKey = circuitSelect.value;
    buildCircuitWorld(circuitKey);
    restartRace();
    updateStats();
    circuitSelect.blur();
  });
  const weatherSelect = document.getElementById('garage-weather') as HTMLSelectElement;
  weatherSelect.addEventListener('change', () => {
    weather = weatherSelect.value;
    weatherSelect.blur();
  });
  ghostEnabled.addEventListener('change', () => ghostEnabled.blur());
  // On phones the settings start folded away so the track stays visible.
  if (window.matchMedia('(max-width: 54rem)').matches) {
    (document.getElementById('garage-settings') as HTMLDetailsElement).open = false;
  }

  resize();
  restartRace();
  tick();
</script>
