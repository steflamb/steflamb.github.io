---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchIcon from '../components/ResearchIcon.astro';
import { profileLinks, publications } from '../data/site';

const cam2simPaper = publications.find((p) => p.title.startsWith('Cam2Sim'))!;
const realityGapPaper = publications.find((p) => p.title.startsWith('A Multi-Modality Evaluation'))!;
const perturbationBenchmarkPaper = publications.find((p) => p.title.startsWith('Benchmarking Image Perturbations'))!;
const perturbationDriveJournalPaper = publications.find((p) => p.title.startsWith('PerturbationDrive:'))!;
const forecastingPaper = publications.find((p) => p.title.startsWith('Misbehavior Forecasting'))!;
const qualityMetricsPaper = publications.find((p) => p.title.startsWith('Assessing Quality Metrics'))!;

const paperLink = (p: (typeof publications)[number]) => ({
  meta: `${p.venue} · ${p.year}`,
  label: p.title,
  href: p.paper,
});

const realWorldPerturbationPaper = publications.find((p) => p.title.startsWith('Real-World Perturbation'))!;

// The research questions, in the order they build on each other. A paper can
// answer more than one. Demos and media live on /demos/.
const questions = [
  {
    icon: 'measure' as const,
    title: 'Measuring the gap',
    question:
      'How much does a system’s behavior change between simulation and a real vehicle, and how much of that is actuation and how much perception?',
    findings: [
      'Vehicle-in-the-loop testing reduced the actuation gap; mixed-reality testing reduced the perception gap.',
    ],
    links: [paperLink(realityGapPaper), paperLink(realWorldPerturbationPaper), paperLink(qualityMetricsPaper)],
  },
  {
    icon: 'understand' as const,
    title: 'Understanding failures',
    question: 'Which failures does a system have, and which ones does offline or simulated testing miss?',
    findings: [
      'Offline robustness was only weakly predictive of closed-loop failures on the real vehicle.',
      'Focusing the search around forecasted near misses found failures with a smaller testing budget.',
    ],
    links: [paperLink(perturbationBenchmarkPaper), paperLink(realWorldPerturbationPaper), paperLink(forecastingPaper), paperLink(qualityMetricsPaper)],
  },
  {
    icon: 'mitigate' as const,
    title: 'Mitigating the gap',
    question: 'Which techniques mitigate the gap, and when do they stop working?',
    findings: [
      'With Cam2Sim’s reconstructed camera view, the driving model completed every closed-loop run; with standard CARLA rendering it failed all three.',
      'Training on perturbed images improved robustness under adverse conditions.',
      'Standard image-quality metrics did not consistently track driving performance.',
    ],
    links: [paperLink(cam2simPaper), paperLink(perturbationBenchmarkPaper), paperLink(qualityMetricsPaper), paperLink(realityGapPaper)],
  },
];

// The tools the experiments run on, released for reuse.
const infrastructure = [
  {
    number: '01',
    title: 'Cam2Sim',
    copy: 'Turns recorded drives into closed-loop CARLA scenarios, with Gaussian Splatting for the camera view.',
    links: [paperLink(cam2simPaper), { meta: 'Code', label: 'ast-fortiss-tum/cam2sim', href: 'https://github.com/ast-fortiss-tum/cam2sim' }],
  },
  {
    number: '02',
    title: 'PerturbationDrive',
    copy: 'More than 30 image perturbations, applied offline or in closed loop across several simulators.',
    links: [paperLink(perturbationDriveJournalPaper), { meta: 'Code', label: 'ast-fortiss-tum/perturbation-drive', href: 'https://github.com/ast-fortiss-tum/perturbation-drive' }],
  },
  {
    number: '03',
    title: 'Small-scale mixed-reality framework',
    copy: 'A small-scale vehicle and its digital twin, so the same test runs in simulation, vehicle-in-the-loop, mixed reality, and real driving.',
    links: [paperLink(realityGapPaper), { meta: 'Code', label: 'ast-fortiss-tum/ROS-small-scale-vehicle', href: 'https://github.com/ast-fortiss-tum/ROS-small-scale-vehicle' }],
  },
];

// Which question each paper answers. Read down a column for a question, across for a paper.
const columns = [
  { key: 'measure', label: 'Measure', title: 'Measuring the gap' },
  { key: 'understand', label: 'Understand', title: 'Understanding failures' },
  { key: 'mitigate', label: 'Mitigate', title: 'Mitigating the gap' },
  { key: 'infrastructure', label: 'Infrastructure', title: 'Infrastructure' },
] as const;
const paperMap = [
  { paper: realWorldPerturbationPaper, short: 'Real-world perturbation testing', answers: ['measure', 'understand', 'mitigate'] },
  { paper: forecastingPaper, short: 'Foresee: misbehavior forecasting', answers: ['understand'] },
  { paper: cam2simPaper, short: 'Cam2Sim', answers: ['mitigate', 'infrastructure'] },
  { paper: perturbationDriveJournalPaper, short: 'PerturbationDrive framework', answers: ['understand', 'infrastructure'] },
  { paper: realityGapPaper, short: 'Multi-modality reality gap', answers: ['measure', 'mitigate', 'infrastructure'] },
  { paper: perturbationBenchmarkPaper, short: 'Image perturbation benchmark', answers: ['understand', 'mitigate'] },
  { paper: qualityMetricsPaper, short: 'Quality metrics for image translation', answers: ['measure', 'understand', 'mitigate'] },
];
---

<BaseLayout
  title="Research and publications — Stefano Carlo Lambertenghi"
  description="Research on the sim-to-real gap in autonomous driving: measuring it, understanding the failures it hides, and mitigating it, with selected publications."
>
  <section class="page-hero page-hero-light publications-hero">
    <div class="page-hero-inner research-hero-stacked container-wide">
      <div class="publications-hero-top">
        <div>
          <h1 class="page-title">Research.</h1>
        </div>
        <div class="page-hero-copy-col">
          <p class="page-hero-copy">
            I study what changes when an autonomous-driving test moves from simulation to a real
            vehicle: how to measure that gap, which failures it hides, and which techniques close
            part of it.
          </p>
          <div class="hero-actions">
            <a class="button-secondary" href={profileLinks.dblp} target="_blank" rel="noreferrer">
              DBLP profile
            </a>
            <a class="button-secondary" href="/demos/">See the demos</a>
          </div>
        </div>
      </div>
      <div class="diagram-plate research-hero-image-full">
        <img
          src="/images/whatido.png"
          alt="Diagram of the sim-to-real testing approach: a scenario runs through both physics and perception, is measured against real behavior, and mitigations feed back into the system"
          width="2400"
          height="1104"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="questions-heading">
    <div class="container-wide">
      <div class="section-heading theme-heading-centered" data-reveal>
        <div>
          <h2 id="questions-heading" class="display-title">Three questions.</h2>
          <p class="section-lede">
            One gap: a system that behaves one way in simulation and another on a real road.
            Measure it, find where it breaks things, then mitigate it.
          </p>
        </div>
      </div>

      <div class="theme-grid">
        {questions.map((q) => (
          <article class="theme-card" data-reveal>
            <ResearchIcon name={q.icon} class="theme-icon" />
            <h3>{q.title}</h3>
            <p class="theme-question">{q.question}</p>
            {q.findings.map((finding) => (
              <p class="theme-finding"><strong>Found:</strong> {finding}</p>
            ))}
            <div class="theme-papers" aria-label={`Related work on ${q.title}`}>
              {q.links.map((link) => (
                <a class="theme-paper" href={link.href} target={link.href.startsWith('/') ? undefined : '_blank'} rel={link.href.startsWith('/') ? undefined : 'noreferrer'}>
                  <span class="theme-paper-meta">{link.meta}</span>
                  <span class="theme-paper-title">{link.label} <span aria-hidden="true">↗︎</span></span>
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tight-top" aria-labelledby="infrastructure-heading">
    <div class="container-wide">
      <div class="section-heading section-heading-flush" data-reveal>
        <div>
          <h2 id="infrastructure-heading" class="display-title">What the experiments run on.</h2>
          <p class="section-lede">
            Three open-source tools built along the way, so the same test can run in more than
            one place.
          </p>
        </div>
      </div>

      <div class="theme-grid">
        {infrastructure.map((item) => (
          <article class="theme-card breakdown-card" data-reveal>
            <span class="theme-number">{item.number}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <div class="theme-papers" aria-label={`Related work on ${item.title}`}>
              {item.links.map((link) => (
                <a class="theme-paper" href={link.href} target={link.href.startsWith('/') ? undefined : '_blank'} rel={link.href.startsWith('/') ? undefined : 'noreferrer'}>
                  <span class="theme-paper-meta">{link.meta}</span>
                  <span class="theme-paper-title">{link.label} <span aria-hidden="true">↗︎</span></span>
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-tight-top" aria-labelledby="map-heading">
    <div class="container-wide">
      <div class="section-heading section-heading-flush" data-reveal>
        <div>
          <h2 id="map-heading" class="display-title">Which paper answers what.</h2>
          <p class="section-lede">
            Most papers answer more than one question. Read down a column for a question, or
            across a row for a paper. The last column marks papers that also built tooling others reuse.
          </p>
        </div>
      </div>
      <div class="paper-map-wrap" data-reveal>
        <table class="paper-map">
          <thead>
            <tr>
              <th scope="col">Paper</th>
              {columns.map((col) => (
                <th scope="col" title={col.title}>
                  <ResearchIcon name={col.key} class="paper-map-icon" />
                  <span class="paper-map-label">{col.label}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {paperMap.map((row) => (
              <tr>
                <th scope="row">
                  <a href={row.paper.paper} target="_blank" rel="noreferrer">
                    <span class="paper-map-meta">{row.paper.venue.split(' · ')[0]} · {row.paper.year}</span>
                    <span class="paper-map-title">{row.short}</span>
                  </a>
                </th>
                {columns.map((col) => (
                  <td>
                    {(row.answers as readonly string[]).includes(col.key)
                      ? <span class="paper-map-dot" role="img" aria-label="Yes"></span>
                      : <span class="sr-only">No</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section-tight-top" aria-labelledby="publications-heading">
    <div class="container-wide">
      <div class="section-heading section-heading-flush" data-reveal>
        <div>
          <h2 id="publications-heading" class="display-title">Selected publications.</h2>
          <p class="section-lede">
            Peer-reviewed papers, executable tools, and replication packages. A complete list is
            available on DBLP.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-tight-top" aria-label="Selected publications">
    <div class="container-wide">
      <ol class="publications-list">
        {publications.map((publication) => (
          <li class="publication-row" data-reveal>
            <span class="publication-row-year">{publication.year}</span>
            <span class="publication-row-venue">{publication.venue}</span>
            <article class="publication-row-content">
              <h2>{publication.title}</h2>
              <p class="publication-authors">{publication.authors}</p>
              <p class="publication-summary">{publication.summary}</p>
              {publication.note && <p class="publication-note">{publication.note}</p>}
            </article>
            <div class="publication-links">
              <a href={publication.paper} target="_blank" rel="noreferrer">Paper ↗︎</a>
              {publication.code && (
                <a href={publication.code} target="_blank" rel="noreferrer">Artifact ↗︎</a>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
  <section class="section section-signal" aria-labelledby="open-heading">
    <div class="container-wide two-column-story">
      <aside class="story-aside" data-reveal>
      </aside>
      <div class="story-copy" data-reveal>
        <h2 id="open-heading" class="sr-only">Open research</h2>
        <p>
          A result is more valuable when someone else can interrogate it. The work is accompanied
          wherever possible by <strong>code, datasets, replication packages, and executable
          examples</strong>—from PerturbationDrive to Cam2Sim and vehicle-level artifacts.
        </p>
        <div class="hero-actions">
          <a class="button button-dark" href={profileLinks.researchGroup} target="_blank" rel="noreferrer">
            Browse open-source work
          </a>
          <a class="button button-dark" href="/demos/">See the demos</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

