---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profileLinks } from '../data/site';

const journeyStops = [
  {
    name: 'Sondrio, Italy',
    note: 'Grew up here, until the third year of high school.',
    lat: 46.1707,
    lon: 9.8714,
  },
  {
    name: 'Mercer Island, WA, USA',
    note: 'Finished high school at Mercer Island High School.',
    lat: 47.5707,
    lon: -122.2221,
  },
  { name: 'Verona, Italy', note: 'Studied computer science.', lat: 45.4384, lon: 10.9916 },
  {
    name: 'Lugano, Switzerland',
    note: 'Studied artificial intelligence at USI—where I met Andrea Stocco.',
    lat: 46.0037,
    lon: 8.9511,
  },
  {
    name: 'Munich, Germany',
    note: 'fortiss and the Technical University of Munich, since 2023.',
    lat: 48.1372,
    lon: 11.5755,
  },
];
---

<BaseLayout
  title="About — Stefano Carlo Lambertenghi"
  description="About Stefano Carlo Lambertenghi, an autonomous-systems researcher working between software engineering, machine learning, and robotics."
>
  <section class="about-photo-section">
    <div class="about-portrait" data-reveal>
      <img
        class="about-portrait-photo"
        src="/images/me-and-fortuna.jpg"
        alt="Stefano Carlo Lambertenghi standing next to Fortuna"
        width="1400"
        height="1050"
        loading="eager"
      />
      <div class="about-portrait-scrim" aria-hidden="true"></div>
      <div class="about-portrait-label"><span>Munich, DE</span></div>
    </div>
  </section>

  <section class="page-hero page-hero-tight">
    <div class="page-hero-inner container-wide about-hero-compact">
      <div>
        <h1 class="page-title">About <em>me.</em></h1>
      </div>
      <p class="page-hero-copy">
        I’m Stefano, an autonomous-systems researcher working across software engineering,
        machine learning, and robotics.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-wide">
      <div class="about-copy" data-reveal>
        <h2>Background.</h2>
        <p>
          I’m Stefano, an Italian computer scientist and researcher currently living in Munich. I
          grew up in Sondrio, a small town in the Italian Alps, and studied computer science in
          Verona, Italy, before moving to Lugano, Switzerland, to study artificial intelligence at
          USI.
        </p>
        <p>
          While at USI, I met my current PhD supervisor, Andrea Stocco, at Formula USI, a
          hackathon he organized around the Donkey Car platform. That little car ended up being
          more important than I expected. When Andrea later offered a PhD position working on
          autonomous driving and testing, I followed him to Germany. We still use the same Donkey
          Car platform in our research today.
        </p>
        <p>
          Before moving to Munich, my main project at IDSIA was my Master’s thesis on autonomous
          nano-drones, which I continued for another year as an intern. I worked on fitting a
          relative-localization neural network onto a 40-gram quadrotor, allowing it to track
          another drone in real time using a single onboard camera and less than 100 mW of power.
          The work eventually became a paper at{' '}
          <a href="https://arxiv.org/abs/2303.01940" target="_blank" rel="noreferrer">IEEE ICRA 2023</a>.
        </p>
        <p>
          In 2023, I joined fortiss and the Technical University of Munich for my PhD. The robots
          became considerably larger. Today most of my work revolves around autonomous driving
          and, in particular, understanding what happens when systems tested in simulation are
          deployed in the real world.
        </p>
        <p>
          That has made my PhD much more hands-on than I originally expected. Alongside
          experimental design and research papers, I spend a lot of time working with ROS,
          sensors, vehicle interfaces, computers, cables, and whatever has decided not to work
          that morning. I am also the technical lead for Fortuna, our full-size autonomous
          research vehicle.
        </p>
        <p>
          There is probably a common thread through all of this. I like working on systems where
          software eventually has to interact with something physical. I’m interested in machine
          learning and simulation, but mostly in what happens when you actually deploy them and
          discover which assumptions were wrong.
        </p>
        <p>
          Outside research, I simply enjoy playing with hardware and building things. Fortuna’s
          recovery started as work and gradually became a bit of a hobby. Some of the less
          serious things I have built around it ended up in the{' '}
          <a href="/garage/">Just for fun</a> section.
        </p>
        <p>
          Growing up in the Alps also means I have been skiing for as long as I can remember. When
          there is no snow, I enjoy windsurfing. I also like travelling by motorcycle with my
          girlfriend, Francesca. Moving to Munich gave me a sufficiently good excuse to buy a BMW
          GS, which has since become our preferred way of disappearing somewhere for a few days.
        </p>

        <dl class="about-details">
          <div><dt>Current</dt><dd>Researcher at fortiss · Doctoral researcher at TUM</dd></div>
          <div><dt>Focus</dt><dd>Testing and validation of autonomous systems</dd></div>
          <div><dt>Methods</dt><dd>Simulation, mixed reality, field experiments, empirical software engineering</dd></div>
          <div><dt>Platforms</dt><dd>Fortuna (full-size) and a small-scale Donkey Car research vehicle</dd></div>
        </dl>

        <div class="hero-actions">
          <a
            class="button button-dark js-email-link"
            href="#"
            data-email-user={profileLinks.emailUser}
            data-email-domain={profileLinks.emailDomain}
          >
            Email me
          </a>
          <a class="button button-dark" href={profileLinks.github} target="_blank" rel="noreferrer">GitHub</a>
          <a class="button button-dark" href="/cv/">View CV</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-dark" aria-labelledby="places-heading">
    <div class="container-wide">
      <div class="section-heading" data-reveal>
        <div>
          <h2 id="places-heading" class="display-title">Where I’ve lived.</h2>
          <p class="section-lede">Five stops so far, roughly in order. Click a pin on the map.</p>
        </div>
      </div>

      <div class="journey-map-wrap" data-reveal>
        <div
          id="journey-map"
          class="journey-map"
          aria-label="Map of places Stefano has lived"
          data-stops={JSON.stringify(journeyStops)}
        ></div>
        <button type="button" class="journey-reset" id="journey-reset" hidden>Show whole journey</button>
        <div class="journey-consent" id="journey-consent" hidden>
          <p>
            The map loads from OpenStreetMap, so your browser will send your IP address to the
            OpenStreetMap Foundation's servers. <a href="/privacy/">Privacy</a>
          </p>
          <button type="button" class="button" id="journey-consent-yes">Show the map</button>
        </div>
      </div>

      <ol class="journey-list">
        {journeyStops.map((stop, i) => (
          <li>
            <span class="journey-list-index">{i + 1}</span>
            <span>
              <strong>{stop.name}</strong> — {stop.note}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>
</BaseLayout>

<style>
  .journey-map-wrap {
    position: relative;
    margin-top: 3rem;
  }

  .journey-consent {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1.2rem;
    padding: 1.5rem;
    background: var(--paper-bright);
    text-align: center;
  }

  .journey-consent[hidden] {
    display: none;
  }

  .journey-consent p {
    max-width: 30rem;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .journey-consent a {
    color: var(--ink);
  }

  .journey-map {
    width: 100%;
    height: 26rem;
    border-radius: 4px;
    background: var(--ink);
  }

  :global(.journey-tiles) {
    filter: invert(1) grayscale(1) brightness(0.95) contrast(1.05);
  }

  .journey-reset {
    position: absolute;
    z-index: 500;
    top: 0.75rem;
    right: 0.75rem;
    border: 1px solid rgba(250, 250, 248, 0.5);
    border-radius: 4px;
    background: rgba(15, 23, 32, 0.75);
    color: var(--paper-bright);
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
  }

  .journey-reset:hover {
    background: var(--signal);
    border-color: var(--signal);
  }

  .journey-list {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-dark);
    display: grid;
    gap: 0.9rem;
  }

  .journey-list li {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    color: var(--muted-dark);
    font-size: 0.92rem;
  }

  .journey-list strong {
    color: var(--paper-bright);
    font-weight: 600;
  }

  .journey-list-index {
    flex: none;
    width: 1.6rem;
    height: 1.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--signal);
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
  }

  :global(.journey-pin) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--signal);
    border: 2px solid var(--paper-bright);
    color: var(--ink);
    font-family: var(--mono);
    font-weight: 700;
    font-size: 13px;
  }

  :global(.leaflet-popup-content-wrapper) {
    background: var(--ink);
    color: var(--paper-bright);
    border-radius: 4px;
  }

  :global(.leaflet-popup-tip) {
    background: var(--ink);
  }

  :global(.leaflet-popup-content strong) {
    display: block;
    margin-bottom: 0.25rem;
  }

  :global(.leaflet-container a.leaflet-popup-close-button) {
    color: var(--muted-dark);
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import { giveMapConsent, hasMapConsent } from '../components/map-consent';

  const container = document.getElementById('journey-map');
  function showJourneyMap(container: HTMLElement) {
    document.getElementById('journey-reset')!.hidden = false;
    const stopsData = JSON.parse(container.dataset.stops || '[]') as Array<{
      name: string;
      note: string;
      lat: number;
      lon: number;
    }>;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const map = L.map(container, { scrollWheelZoom: false });

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
      subdomains: 'abc',
      maxZoom: 19,
      className: 'journey-tiles',
    }).addTo(map);

    const route = L.polyline(
      stopsData.map((s) => [s.lat, s.lon] as [number, number]),
      { color: '#f05a28', weight: 2, opacity: 0.9, interactive: false },
    ).addTo(map);

    const markers = stopsData.map((stop, i) => {
      const icon = L.divIcon({
        className: 'journey-pin-wrap',
        html: `<div class="journey-pin">${i + 1}</div>`,
        iconSize: [28, 28],
        iconAnchor: [14, 14],
      });
      const marker = L.marker([stop.lat, stop.lon], { icon }).addTo(map);
      marker.bindPopup(`<strong>${stop.name}</strong>${stop.note}`);
      marker.on('click', () => map.flyTo([stop.lat, stop.lon], 11, { duration: 0.8, animate: !reduceMotion.matches }));
      return marker;
    });

    const bounds = L.latLngBounds(stopsData.map((s) => [s.lat, s.lon] as [number, number]));
    map.fitBounds(bounds, { padding: [40, 40] });

    // First time the map is seen, trace the journey in order: the route draws itself
    // and each pin lands as the line reaches it.
    function traceJourney() {
      const path = route.getElement() as SVGPathElement | undefined;
      if (!path) return;
      const total = path.getTotalLength();
      const points = stopsData.map((s) => map.latLngToLayerPoint([s.lat, s.lon]));
      let travelled = 0;
      const arrivals = points.map((p, i) => (i === 0 ? 0 : (travelled += p.distanceTo(points[i - 1]))));
      const duration = 1800;
      const ease = 'cubic-bezier(0.45, 0, 0.25, 1)';

      path.style.strokeDasharray = `${total}`;
      path
        .animate([{ strokeDashoffset: total }, { strokeDashoffset: 0 }], { duration, easing: ease, fill: 'both' })
        .finished.then(() => {
          // Leaflet redraws the path on zoom; drop the dash so it never truncates.
          path.style.strokeDasharray = '';
          path.getAnimations().forEach((a) => a.cancel());
        });

      markers.forEach((marker, i) => {
        const pin = marker.getElement()?.querySelector('.journey-pin');
        pin?.animate(
          [
            { opacity: 0, transform: 'translateY(-10px) scale(0.6)' },
            { opacity: 1, transform: 'none' },
          ],
          {
            duration: 420,
            delay: (arrivals[i] / (travelled || 1)) * duration * 0.85,
            easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
            fill: 'backwards',
          },
        );
      });
    }

    if (!reduceMotion.matches && 'animate' in Element.prototype) {
      new IntersectionObserver(
        ([entry], observer) => {
          if (!entry.isIntersecting) return;
          observer.disconnect();
          traceJourney();
        },
        { threshold: 0.4 },
      ).observe(container);
    }

    document.getElementById('journey-reset')?.addEventListener('click', () => {
      map.closePopup();
      map.flyToBounds(bounds, { padding: [40, 40], duration: 0.8, animate: !reduceMotion.matches });
    });
  }

  // Map tiles come from OpenStreetMap, so they load only once the visitor agrees.
  if (container) {
    const gate = document.getElementById('journey-consent') as HTMLElement;
    if (hasMapConsent()) showJourneyMap(container);
    else {
      gate.hidden = false;
      document.getElementById('journey-consent-yes')!.addEventListener('click', () => {
        giveMapConsent();
        gate.hidden = true;
        showJourneyMap(container);
      });
    }
  }
</script>
