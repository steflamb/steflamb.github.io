---
import BaseLayout from '../layouts/BaseLayout.astro';
import { profileLinks, publications } from '../data/site';

const nanodronePaper = publications.find((p) => p.title.startsWith('Ultra-Low Power'))!;
---

<BaseLayout
  title="CV — Stefano Carlo Lambertenghi"
  description="A concise web CV for Stefano Carlo Lambertenghi, autonomous-systems researcher at fortiss and TUM."
>
  <article class="cv-sheet">
    <header class="cv-heading">
      <img class="cv-photo" src="/images/me.jpg" alt="Stefano Carlo Lambertenghi" width="600" height="601" loading="eager" />
      <div>
        <p class="eyebrow">Curriculum vitae / web edition</p>
        <h1>Stefano Carlo Lambertenghi</h1>
      </div>
      <p>
        Autonomous-systems researcher working across software testing, simulation, and physical
        vehicle experiments in Munich.
      </p>
    </header>

    <section class="cv-block">
      <h2>Current work</h2>
      <div>
        <article class="cv-entry">
          <h3>Scientific Researcher</h3>
          <p class="cv-entry-meta"><a href="https://www.fortiss.org/" target="_blank" rel="noreferrer">fortiss GmbH</a> · Munich · Jun 2023–Now</p>
          <p>
            Responsible for the development, deployment, operation, and maintenance of Fortuna, a
            Volkswagen Passat adapted and certified for autonomous driving on public roads.
            Restored the platform to full operational status and lead its use for research and
            testing.
          </p>
          <p>
            Designed and ran nearly 100 hours of autonomous-driving experiments on public roads;
            deployed and adapted Autoware and Apollo, including trajectory-planning changes for
            narrow two-way urban roads, and end-to-end models from NVIDIA DAVE-2 to recent CARLA
            Leaderboard agents.
          </p>
        </article>
        <article class="cv-entry">
          <h3>Doctoral Candidate</h3>
          <p class="cv-entry-meta"><a href="https://www.tum.de/" target="_blank" rel="noreferrer">Technical University of Munich</a> · Jun 2023–Now</p>
          <p>
            Topic: measuring and mitigating the sim-to-real gap in testing of cyber-physical
            systems.
          </p>
        </article>
      </div>
    </section>

    <section class="cv-block">
      <h2>Earlier experience</h2>
      <div>
        <article class="cv-entry">
          <h3>Intern</h3>
          <p class="cv-entry-meta"><a href="https://www.idsia.ch/" target="_blank" rel="noreferrer">IDSIA, Dalle Molle Institute for AI</a> · Lugano · Sep 2022–Jun 2023</p>
          <p>
            Developed ultra-low-power deep-learning-based monocular relative localization for
            nano-quadrotors, enabling real-time onboard inference on resource-constrained embedded
            hardware.
          </p>
        </article>
        <article class="cv-entry">
          <h3>Intern</h3>
          <p class="cv-entry-meta"><a href="https://www.embeddedvisionsystems.it/" target="_blank" rel="noreferrer">eVs Embedded Vision Systems</a> · Verona · May–Aug 2019</p>
          <p>
            Developed FPGA-based vehicle classification algorithms using support vector machines
            for intelligent guidance systems.
          </p>
        </article>
      </div>
    </section>

    <section class="cv-block">
      <h2>Research platforms</h2>
      <div>
        <article class="cv-entry">
          <h3>Fortuna · Full-size autonomous-driving research vehicle</h3>
          <p class="cv-entry-meta">Platform recovery, integration, validation, and operation</p>
          <p>
            Work across drive-by-wire control, ROS, camera and LiDAR systems, modular and
            end-to-end driving stacks, simulation integration, and repeatable real-world
            experiments.
          </p>
        </article>
        <article class="cv-entry">
          <h3>Donkey Car · Small-scale research vehicle</h3>
          <p class="cv-entry-meta">Digital-twin testing across simulation, VIL, and mixed reality</p>
          <p>
            An open-source small-scale platform with its own Unity digital twin, used to compare
            simulation, vehicle-in-the-loop, and mixed-reality testing against real driving before
            validating results on Fortuna at full scale.
          </p>
        </article>
      </div>
    </section>

    <section class="cv-block">
      <h2>Education</h2>
      <div>
        <article class="cv-entry">
          <h3>Doctoral Candidate</h3>
          <p class="cv-entry-meta"><a href="https://www.tum.de/" target="_blank" rel="noreferrer">TUM, Technical University of Munich</a> · Munich · Jun 2023–Now</p>
        </article>
        <article class="cv-entry">
          <h3>MSc in Artificial Intelligence</h3>
          <p class="cv-entry-meta"><a href="https://www.usi.ch/" target="_blank" rel="noreferrer">USI, Università della Svizzera Italiana</a> · Lugano · Oct 2020–Sep 2022</p>
          <p>
            Thesis: drone-to-drone on-board relative pose estimation and control of nano-class
            autonomous UAVs. GPA 9.21, summa cum laude.
          </p>
        </article>
        <article class="cv-entry">
          <h3>Bachelor’s in IT Science and Technology</h3>
          <p class="cv-entry-meta"><a href="https://www.univr.it/" target="_blank" rel="noreferrer">UNIVR, Università di Verona</a> · Verona · Oct 2016–Jul 2020</p>
          <p>Thesis: interactive holographic displays for advertisement. GPA 97/110.</p>
        </article>
      </div>
    </section>

    <section class="cv-block">
      <h2>Selected publications</h2>
      <div>
        {publications.slice(0, 5).map((publication) => (
          <article class="cv-entry">
            <h3><a href={publication.paper}>{publication.title}</a></h3>
            <p class="cv-entry-meta">{publication.venue} · {publication.year}</p>
            {publication.note && <p>{publication.note}</p>}
          </article>
        ))}
        <article class="cv-entry">
          <h3><a href={nanodronePaper.paper}>{nanodronePaper.title}</a></h3>
          <p class="cv-entry-meta">{nanodronePaper.venue} · {nanodronePaper.year}</p>
        </article>
      </div>
    </section>

    <section class="cv-block">
      <h2>Skills</h2>
      <dl class="about-details">
        <div><dt>Programming</dt><dd>Python, C/C++/C#, Java, Swift, MATLAB</dd></div>
        <div><dt>Frameworks &amp; tools</dt><dd>PyTorch, TensorFlow, OpenCV, ROS, Docker, Unity, Blender, Autoware, Apollo</dd></div>
        <div><dt>Languages</dt><dd>Italian (native), English (C1)</dd></div>
      </dl>
    </section>

    <section class="cv-block">
      <h2>Profiles</h2>
      <div class="cv-entry">
        <h3>Research and code</h3>
        <p>
          <a href={profileLinks.scholar} target="_blank" rel="noreferrer">Google Scholar</a>{' '}
          · <a href={profileLinks.dblp}>DBLP</a> · <a href={profileLinks.github}>GitHub</a>{' '}
          · <a href={profileLinks.researchGroup}>fortiss/TUM research group</a>{' '}
          · <a href={profileLinks.linkedin}>LinkedIn</a>
        </p>
      </div>
    </section>

    <div class="cv-actions">
      <a class="button button-dark" href={profileLinks.cvPdf} target="_blank" rel="noreferrer">
        Open CV (PDF)
      </a>
    </div>
  </article>
</BaseLayout>
