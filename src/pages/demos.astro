---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConceptLab from '../components/ConceptLab.astro';
import Cam2SimDrive from '../components/Cam2SimDrive.astro';
import PertovReplay from '../components/PertovReplay.astro';
import PaperSource from '../components/PaperSource.astro';
import StepPlayer, { type Step } from '../components/StepPlayer.astro';
import { publications } from '../data/site';

const realWorldPerturbationPaper = publications.find((p) => p.title.startsWith('Real-World Perturbation Testing'))!;
const cam2simPaper = publications.find((p) => p.title.startsWith('Cam2Sim'))!;
const realityGapPaper = publications.find((p) => p.title.startsWith('A Multi-Modality Evaluation'))!;
const perturbationBenchmarkPaper = publications.find((p) => p.title.startsWith('Benchmarking Image Perturbations'))!;
const perturbationDriveJournalPaper = publications.find((p) => p.title.startsWith('PerturbationDrive:'))!;
const forecastingPaper = publications.find((p) => p.title.startsWith('Misbehavior Forecasting'))!;
const nanodronePaper = publications.find((p) => p.title.startsWith('Ultra-Low Power'))!;
const qualityMetricsPaper = publications.find((p) => p.title.startsWith('Assessing Quality Metrics'))!;

// Foresee's pipeline, mapped onto the talk animation (seconds into foresee-steps.mp4).
const foreseeSteps: Step[] = [
  { label: 'Monitor', start: 3.5, end: 5, rate: 1, note: 'Track the agents around the ego vehicle and forecast where each one is heading.' },
  { label: 'Classify', start: 9.5, end: 29.25, rate: 2, note: 'Label every agent by risk, from minimal to high, from how close its forecast comes to the ego vehicle.' },
  { label: 'Rank', start: 30.25, end: 31.25, rate: 1, note: 'Order the risky agents, so the most promising near miss comes first.' },
  { label: 'Clip', start: 36.25, end: 37.25, rate: 1, note: 'Cut the scenario down to the window around that near miss.' },
  { label: 'Fuzz', start: 41, end: 62.05, rate: 2, note: 'Mutate the clipped scenario, swapping an NPC or changing its path, to push the near miss toward a failure.' },
  { label: 'Empirical study', start: 62.25, end: 64.5, rate: 1, hold: 5, row: 2, note: 'Evaluated in the CARLA simulator on 5 scenarios and 120 routes, with two driving systems, InterFuser and TransFuser, and 12 Foresee configurations over 3 parameters.' },
];

// The ICST 2024 talk, by research question (seconds into icst-steps.mp4: the talk's slides,
// then its translation examples, with the closing and backup slides cut).
// The ASE 2025 talk, by chapter (seconds into ase2025-steps.mp4, which starts at the
// talk's "Motivation" card and ends before its closing card).
const ase2025Steps: Step[] = [
  { label: 'Motivation', start: 0, end: 138.4, note: 'Real-world testing is realistic but costly and risky; simulation is cheap but only approximates reality. The difference in sensors, physics, and scenarios is the reality gap.' },
  { label: 'Execution levels', start: 138.5, end: 217.4, note: 'Four ways to run the same test, mixing simulated and real sensors and actuation. The goal: see how far SiL, ViL, and MR mitigate the behaviour, actuation, and perception gaps.' },
  { label: 'Our platform', start: 217.5, end: 358.9, note: 'The small-scale lab, the Donkey Car, and the digital twin built from a 3D scan of the lab.' },
  { label: 'Systems under test', start: 359, end: 428.4, note: 'Two driving systems: a modular perception–planning–control pipeline and an end-to-end model (DAVE-2).' },
  { label: 'Framework', start: 428.5, end: 495.4, note: 'How the levels are compared, on lane keeping, obstacle avoidance, and adaptive cruise control.' },
  { label: 'SiL', start: 495.5, end: 517.8, row: 2, note: 'Simulator-in-the-loop: simulated sensors, simulated actuation.' },
  { label: 'ViL', start: 517.9, end: 544.1, row: 2, note: 'Vehicle-in-the-loop: simulated sensors, real actuation.' },
  { label: 'MR', start: 544.2, end: 570.4, row: 2, note: 'Mixed reality: mixed sensors, real actuation.' },
  { label: 'RW', start: 570.5, end: 596.7, row: 2, note: 'Real world: real sensors, real actuation.' },
  { label: 'Research questions', start: 597, end: 637.9, row: 3, note: 'RQ1: the behaviour gap. RQ2: the actuation gap. RQ3: the perception gap.' },
];

const icstSteps: Step[] = [
  { label: 'Problem', start: 5.05, end: 38.95, rate: 1, note: 'Simulators don’t reproduce real camera images. Image-to-image translation makes simulated frames look real, and image-quality metrics are meant to say whether it worked.' },
  { label: 'Method', start: 39.05, end: 68.95, rate: 1, note: '2 perception-based driving tasks, 3 driving-behaviour metrics, 2 translation architectures (CycleGAN and pix2pix), and 13 image-quality metrics.' },
  { label: 'Transferability', start: 69.05, end: 103.95, rate: 1, note: 'RQ1: does translation mitigate the gap equally across tasks? Pix2pix failed on vehicle detection, confidence was not a suitable metric, and attention error always improved.' },
  { label: 'Correlation', start: 104.05, end: 148.95, rate: 1, note: 'RQ2: do image-quality metrics track driving behaviour? IS and FID were inconsistent across tasks while KID was consistent; single-image metrics had weak or negligible correlation, several in the wrong direction.' },
  { label: 'Fine-tuning', start: 149.05, end: 178.95, rate: 1, note: 'RQ3: fine-tuning a semantic-segmentation metric for the task made it correlate on both domains. OC-TSS was the only metric with moderate correlation.' },
  { label: 'pix2pix · full scale', start: 195.05, end: 252.25, row: 2, note: 'Vehicle detection on real driving data: simulated frame (top), pix2pix translation (middle), and the real frame (bottom).' },
  { label: 'CycleGAN · full scale', start: 252.4, end: 297.9, row: 2, note: 'Vehicle detection on real driving data: simulated frame (top), CycleGAN translation (middle), and the real frame (bottom).' },
  { label: 'pix2pix · small scale', start: 309.65, end: 330.75, row: 2, note: 'Lane keeping on the small-scale track: simulated frame (top), pix2pix translation (middle), and the real frame (bottom).' },
  { label: 'CycleGAN · small scale', start: 330.85, end: 351.9, row: 2, note: 'Lane keeping on the small-scale track: simulated frame (top), CycleGAN translation (middle), and the real frame (bottom).' },
];
---

<BaseLayout
  title="Demos — Stefano Carlo Lambertenghi"
  description="Interactive demos and talks: perturb a driving camera feed, drive a Gaussian-splat reconstruction of a Munich street, and see the reality gap across execution levels."
>
  <section class="page-hero page-hero-light">
    <div class="page-hero-inner container-wide">
      <div>
        <h1 class="page-title">Demos.</h1>
        <p class="page-hero-copy">
          Papers describe the method. These show what it actually looks like, some of it running
          live in your browser.
        </p>
      </div>
    </div>
  </section>

  <section class="section section-tight-top" aria-label="Demos">
    <div class="container-wide">
      <div class="demo-showcase-list">
        <Cam2SimDrive>
          <h3>Real drives, replayed in simulation.</h3>
          <p>
            Cam2Sim started from a practical problem. We had many hours of real driving
            recordings, but once an experiment was finished we could only replay the recorded
            sensor data. We wanted to turn these recordings into environments in which the
            driving system could interact again. Cam2Sim reconstructs the recorded environment
            in CARLA and uses Gaussian Splatting for the camera view. The reconstruction is not
            a complete replacement for the real environment, but it allows us to reuse real
            experiments for closed-loop simulation.
          </p>
          <p>
            Drive one of those recordings above: a simple simulator on Guerickestraße in Munich,
            with the road traced from the recorded drive, and beside it the camera view for the
            car's current pose, generated from a Gaussian-splat reconstruction trained on that
            drive's camera frames, in three segments. Below it is the Cam2Sim demo video.
          </p>
          <div class="video-frame demo-inline-video">
            <iframe
              src="https://www.youtube-nocookie.com/embed/KmZ74l1__lI"
              title="Cam2Sim demo video"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div slot="link"><PaperSource papers={[cam2simPaper]} /></div>
        </Cam2SimDrive>

        <div class="demo-showcase" data-reveal>
          <StepPlayer
            src="/videos/ase2025-steps.mp4"
            poster="/images/ase2025-steps-poster.jpg"
            width={1280}
            height={684}
            label="ASE 2025 talk on the reality gap"
            steps={ase2025Steps}
            prompt="A narrated talk, so turn your sound on. Pick a step to play that part."
            sound
            youtube="https://www.youtube.com/watch?v=-YGdyNXgKb8"
          />
          <div class="demo-showcase-copy">
            <h3>The same reality gap, across four execution levels.</h3>
            <p>
              An open-source small-scale vehicle and its Unity digital twin, compared against
              Fortuna at full scale, across simulation, vehicle-in-the-loop, mixed-reality, and
              real-world testing.
            </p>
            <PaperSource papers={[realityGapPaper]} />
          </div>
        </div>

        <ConceptLab>
          <h3>The same perturbation, any simulator.</h3>
          <p>
            PerturbationDrive generates camera perturbations—like rain, or a corrupted
            feed—and applies them through a simulator adapter, so the same scenario runs
            unchanged across Udacity's simulator, a small-scale digital twin, or a full driving
            stack. Here it runs on the camera following a scan of Fortuna round a test track:
            pick any of the library's perturbations and the scale it is applied at.
          </p>
          <div slot="link"><PaperSource papers={[perturbationDriveJournalPaper, perturbationBenchmarkPaper]} /></div>
        </ConceptLab>

        <PertovReplay>
          <h3>The same perturbations, on a real vehicle.</h3>
          <p>
            We injected PerturbationDrive's camera perturbations online while the driving model
            steered the vehicle along Guerickestraße in Munich. Pick a perturbation and the
            intensity it was driven at to see the recorded trajectory against the nominal run
            and how the run ended.
          </p>
          <div slot="link"><PaperSource papers={[realWorldPerturbationPaper]} /></div>
        </PertovReplay>

        <div class="demo-showcase" data-reveal>
          <StepPlayer
            src="/videos/foresee-steps.mp4"
            poster="/images/foresee-steps-poster.jpg"
            width={1600}
            height={864}
            label="Foresee pipeline animation"
            steps={foreseeSteps}
            prompt="Pick a step to see what Foresee does there."
          />
          <div class="demo-showcase-copy">
            <h3>Forecasting near misses to focus fuzzing.</h3>
            <p>
              Foresee monitors nearby agents, classifies and ranks the riskiest ones, then clips
              and fuzzes the scenario around them—so testing time goes where failures are most
              likely to surface.
            </p>
            <PaperSource papers={[forecastingPaper]} />
          </div>
        </div>

        <div class="demo-showcase" data-reveal>
          <StepPlayer
            src="/videos/icst-steps.mp4"
            poster="/images/icst-steps-poster.jpg"
            width={1024}
            height={552}
            label="ICST 2024 talk on image-quality metrics"
            steps={icstSteps}
            prompt="Pick a step to walk through the study."
          />
          <div class="demo-showcase-copy">
            <h3>Do image-quality metrics track what actually matters?</h3>
            <p>
              The ICST 2024 talk on assessing quality metrics for neural
              reality-gap input mitigation—testing whether standard image-quality metrics track
              how neural image translation affects a driving system's perception and control.
            </p>
            <PaperSource papers={[qualityMetricsPaper]} />
          </div>
        </div>

        <div class="demo-showcase" data-reveal>
          <div class="video-frame">
            <iframe
              src="https://www.youtube-nocookie.com/embed/pUGL1qu3Z1k"
              title="Nano-drone relative localization demo video"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          </div>
          <div class="demo-showcase-copy">
            <h3>Fitting a neural network onto a 40-gram nano-drone.</h3>
            <p>
              Before autonomous cars, I worked on autonomous nano-drones. At the Dalle Molle
              Institute for Artificial Intelligence (IDSIA) in Lugano, I helped fit a
              relative-localization neural network onto a 40-gram nano-quadrotor: a single onboard
              camera and under 100 mW of power, enough to track a peer drone in real time
              (IEEE ICRA 2023). The platform changed; the question didn’t: what has to be true for a
              learned model to work outside the lab it was trained in?
            </p>
            <PaperSource papers={[nanodronePaper]} />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

