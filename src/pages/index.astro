---
// The home page: one fixed canvas, the camera travels through each section as you scroll, with a
// CRT / fisheye / glitch post-process. Phones and tablets are sent to the classic page (/classic/).
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-500.css';
import '@fontsource/barlow/latin-400.css';
import { navItems, profileLinks } from '../data/site';

const stops = [
  {
    title: 'Research',
    description:
      'What changes when an autonomous-driving test moves from simulation to a real vehicle: how to measure that gap, which failures it hides, and which techniques close part of it.',
    href: '/publications/',
    linkLabel: 'Explore the research',
    facts: [
      'Measure: vehicle-in-the-loop testing reduced the actuation gap; mixed reality reduced the perception gap.',
      'Understand: offline robustness was only weakly predictive of failures on the real vehicle, across 740+ experiments.',
      'Mitigate: with Cam2Sim’s reconstructed camera view the driving model finished every closed-loop run; with standard CARLA rendering it failed all three.',
      '8 papers at ICSE, ASE, ICST and ICRA and in Science of Computer Programming, including an ICST 2025 Distinguished Paper Award.',
    ],
    image: '/images/reality-gap.jpg',
  },
  {
    title: 'Fortuna',
    description:
      'A full-size, street-legal Volkswagen Passat used for camera- and LiDAR-based autonomous-driving research, brought back into operation.',
    href: '/fortuna/',
    linkLabel: 'Meet Fortuna',
    facts: [
      'A retrofitted 2018 VW Passat Variant GTE: 5 cameras, 3 LiDARs, RTK localisation, drive-by-wire.',
      'Inactive for over a year when I took it on in 2023; rebuilt from Apollo-only to a modular ROS platform.',
      'Any laptop or PC up to 1000 W can now drive it over Ethernet, with any driving stack.',
      'Our ASE 2026 study ran 740+ experiments and 48+ hours of autonomous driving on it.',
    ],
    image: '/images/fortuna-profile.png',
    // The panel shows the 3D model (the textured, grey one), turning, instead of the flat picture (the picture is the fallback).
    models: ['/models/fortuna-hd.glb'],
  },
  {
    title: 'Teaching',
    description: 'A practicum course on testing autonomous-driving systems, and the student projects I have supervised around it.',
    href: '/teaching/',
    linkLabel: 'See the projects',
    facts: [
      'A practicum on testing automated driving, co-organised with Xingcheng Chen and Lev Sorokin, supervised by Andrea Stocco.',
      'Student teams test deep-learning lane keeping in simulation and on small-scale vehicles.',
      'Several theses became papers: PerturbationDrive, the ASE 2025 and ASE 2026 studies, and Cam2Sim.',
    ],
    image: '/images/matthias-andrea-me.jpg',
  },
  {
    title: 'Demos',
    description: 'Perturb a driving camera feed, drive a reconstructed Munich street, and see the reality gap across four execution levels.',
    href: '/demos/',
    linkLabel: 'Try the demos',
    facts: [
      'Drive a Gaussian-splat reconstruction of a Munich street, in your browser.',
      'Apply PerturbationDrive’s camera perturbations live, at any intensity.',
      'Replay real perturbed drives on Fortuna, and step through the Foresee, ICST 2024 and ASE 2025 talks.',
    ],
    image: '/images/whatido.png',
  },
  {
    title: 'About',
    description: 'Where I grew up, how I ended up here, and what I do outside research.',
    href: '/about/',
    linkLabel: 'Read more',
    facts: [
      'Grew up in Sondrio, in the Italian Alps; studied in Verona and at USI in Lugano.',
      'Master’s thesis at IDSIA on nano-drones, which became an ICRA 2023 paper.',
      'PhD at fortiss and TUM since 2023, supervised by Andrea Stocco.',
      'Outside work: skiing, windsurfing, and motorcycle trips on a BMW GS.',
    ],
    image: '/images/me.jpg',
  },
  {
    title: 'Take a spin',
    description: 'Race a Blender model of Fortuna and a Gaussian-splat model of my motorcycle, on three circuits.',
    href: '/garage/',
    linkLabel: 'Open it up',
    facts: [
      'Fortuna is modelled in Blender; my BMW GS is a Gaussian-splat model.',
      'A cone course, and simplified versions of Monza and Spa.',
      'Weather, traffic, and a ghost of your best lap.',
    ],
    image: '/images/fortuna-drive-poster.jpg',
    // Just for fun: Fortuna and the motorcycle on one turntable, at their real sizes.
    models: ['/models/fortuna-hd.glb', '/models/gs.glb'],
  },
];

// The hero: the same photo, further from reality at each step (as on the home page).
const gapLayers = [
  { src: '/images/me-and-fortuna-sim.jpg', label: 'Simulation' },
  { src: '/images/me-and-fortuna-lowpoly.jpg', label: 'Low poly' },
  { src: '/images/me-and-fortuna-wireframe.jpg', label: 'Wireframe' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#06090c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Stefano Carlo Lambertenghi</title>
    <meta name="description" content="Stefano Carlo Lambertenghi: researcher at fortiss and doctoral candidate at TUM, working on the gap between simulated and real autonomous driving, and technical lead for the Fortuna research vehicle." />
    <link rel="canonical" href="https://steflamb.github.io/" />
    <!-- Phones and tablets get the classic home page: the fly-through is built for a mouse and a big screen. -->
    <script is:inline>
      // Add ?fly to the address to see the fly-through on a phone anyway.
      if (!new URLSearchParams(window.location.search).has('fly') && window.matchMedia('(max-width: 54rem), (pointer: coarse)').matches)
        window.location.replace('/classic/');
      document.documentElement.classList.add('has-js');
    </script>
  </head>
  <body>
    <canvas id="gl" aria-hidden="true"></canvas>

    <section class="gaphero" id="gaphero" aria-label="Introduction">
      <div class="gh-visual" id="gh-visual">
        <img class="gh-base" src="/images/me-and-fortuna.jpg" alt="Stefano Carlo Lambertenghi standing next to Fortuna" width="1400" height="1050" loading="eager" />
        {
          gapLayers.map((layer) => (
            <div class="gh-layer" aria-hidden="true">
              <img src={layer.src} alt="" width="1400" height="1050" loading="eager" decoding="async" draggable="false" />
            </div>
          ))
        }
        <div class="gh-edge" id="gh-edge" aria-hidden="true"></div>
        <span class="gh-tag gh-tag-real" id="gh-real" aria-hidden="true">Reality</span>
        <span class="gh-tag gh-tag-sim" id="gh-stage" aria-hidden="true">{gapLayers[0].label}</span>
      </div>
      <div class="gh-copy">
        <h1>Stefano Carlo <em>Lambertenghi.</em></h1>
        <p>
          I like taking systems apart to see why they break, then putting them back together better. Fortuna, the research vehicle on the right, is the biggest thing I
          have taken apart so far.
        </p>
        <p>Researcher at fortiss, doctoral candidate at TUM, and technical lead for Fortuna, our autonomous-driving research vehicle.</p>
      </div>
      <p class="gh-cue" aria-hidden="true"><span>Scroll to cross the gap</span><i><b id="gh-fill"></b></i></p>
    </section>

    <div class="hud">

      <aside class="index" id="index" aria-label="Sections">
        <p class="index-label">Selected</p>
        <ol>
          {
            stops.map((stop, i) => (
              <li>
                <button type="button" data-index={i}>
                  <span class="dot" aria-hidden="true" />[{String(i + 1).padStart(2, '0')}] {stop.title}
                </button>
              </li>
            ))
          }
        </ol>
      </aside>

      <main id="main">

        <section class="cta" id="cta">
          <p>Let's talk about<br />your next experiment.</p>
          <a
            class="js-email-link"
            href="#"
            data-email-user={profileLinks.emailUser}
            data-email-domain={profileLinks.emailDomain}>&gt; Send me an email</a
          >
        </section>
      </main>

    </div>

    <header class="top">
      <a class="brand" href="/">S. C. Lambertenghi</a>
      <div class="top-right">
        <a
          class="js-email-link"
          href="#"
          data-email-user={profileLinks.emailUser}
          data-email-domain={profileLinks.emailDomain}>Let's talk</a
        >
        <button type="button" id="menu-toggle" aria-expanded="false" aria-controls="menu">Menu ☰</button>
      </div>
    </header>

    <p class="model-loading" id="model-loading" role="status" hidden>Loading 3D model…</p>

    <article class="card" id="card" aria-live="polite">
      <h2 class="card-title" id="cap-title"></h2>
      <p class="card-desc" id="cap-desc"></p>
      <ul class="card-facts" id="cap-facts"></ul>
      <a class="card-button" id="cap-link" href="/"><span></span> <b aria-hidden="true">→</b></a>
    </article>

    <nav class="menu" id="menu" aria-label="Primary" hidden>
      <ol>
        {
          navItems.map((item, i) => (
            <li>
              <a href={item.href}>
                <span>{String(i + 1).padStart(2, '0')}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ol>
      <ul class="menu-social">
        <li><a href={profileLinks.github} target="_blank" rel="noreferrer">&gt; GitHub</a></li>
        <li><a href={profileLinks.linkedin} target="_blank" rel="noreferrer">&gt; LinkedIn</a></li>
        <li><a href={profileLinks.scholar} target="_blank" rel="noreferrer">&gt; Scholar</a></li>
      </ul>
    </nav>

    <!-- Fallback when WebGL is unavailable -->
    <section class="fallback" aria-label="Sections">
      <h2>Explore</h2>
      <ul>
        {stops.map((stop) => <li><a href={stop.href}>{stop.title} — {stop.linkLabel}</a></li>)}
      </ul>
    </section>

    <div id="spacer" aria-hidden="true"></div>
    <script id="stops-data" type="application/json" set:html={JSON.stringify(stops)} />
  </body>
</html>

<style is:global>
  :root {
    --dark: #06090c;
    --light: #e9ebe6;
    --mono: 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Consolas, monospace;
  }
  * {
    box-sizing: border-box;
  }
  html {
    background: var(--dark);
  }
  body {
    margin: 0;
    min-height: 100vh;
    background: var(--dark);
    color: #fff;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.55;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-align: left;
  }
  :focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 4px;
  }

  #gl {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Difference blending keeps the overlay legible over both the light and the dark scenes. */
  .hud {
    position: fixed;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    mix-blend-mode: difference;
    color: #fff;
  }
  .hud a,
  .hud button {
    pointer-events: auto;
  }

  /* Outside the blended HUD: over the photo, difference blending broke the letters up.
     Solid dark chips read the same over the photo, the light scenes and the dark ones. */
  .top {
    position: fixed;
    z-index: 13;
    inset: 1rem clamp(1rem, 2.5vw, 2rem) auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    pointer-events: none;
  }
  .top-right {
    display: flex;
    gap: 0.5rem;
  }
  .top a,
  .top button {
    pointer-events: auto;
    padding: 0.5rem 0.8rem;
    background: rgba(6, 9, 12, 0.82);
    backdrop-filter: blur(8px);
    color: #f3f4f1;
    transition: background 150ms ease, color 150ms ease;
  }
  .top a:hover,
  .top button:hover,
  .top a:focus-visible,
  .top button:focus-visible {
    background: #ffcf33;
    color: #06090c;
  }

  .index {
    position: absolute;
    left: clamp(1rem, 3vw, 3rem);
    right: clamp(1rem, 3vw, 3rem);
    bottom: 1.6rem;
    display: flex;
    align-items: center;
    gap: 1.4rem;
    opacity: 0;
    transition: opacity 400ms ease;
  }
  .index.is-on {
    opacity: 1;
  }
  .index-label {
    margin: 0;
    opacity: 0.6;
  }
  .index ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .index button {
    display: block;
    opacity: 0.5;
    transition: opacity 200ms ease;
  }
  .index button:hover,
  .index button.is-active {
    opacity: 1;
  }
  .index .dot {
    display: inline-block;
    width: 0.4rem;
    height: 0.4rem;
    margin-right: 0.4rem;
    background: currentColor;
    opacity: 0;
  }
  .index button.is-active .dot {
    opacity: 1;
  }

  /* The hero: photo, then the simulator, low poly and wireframe wiping in over it as you scroll. */
  .gaphero {
    position: fixed;
    inset: 0;
    z-index: 5;
    overflow: hidden;
    background: var(--dark);
    pointer-events: none;
    will-change: opacity;
  }
  .gh-visual {
    position: absolute;
    inset: 0;
  }
  .gh-visual img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 24% 32%;
  }
  .gh-base {
    position: absolute;
    inset: 0;
  }
  .gh-layer {
    position: absolute;
    inset: 0;
    clip-path: inset(0 0 0 var(--x, 100%));
  }
  .gh-edge {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--x, 100%);
    z-index: 2;
    border-left: 2px dotted #fff;
    filter: drop-shadow(0 0 3px rgba(0, 0, 0, 0.7));
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .gh-edge.is-wiping {
    opacity: 1;
  }
  .gh-tag {
    position: absolute;
    z-index: 2;
    bottom: 1.25rem;
    padding: 0.4rem 0.6rem;
    background: rgba(15, 23, 32, 0.82);
    transition: opacity 300ms ease;
  }
  .gh-tag-real {
    right: 1.25rem;
  }
  .gh-tag-sim {
    right: 1.25rem;
    color: #ffcf33;
    opacity: 0;
  }
  .gh-visual.is-simulated .gh-tag-sim {
    opacity: 1;
  }
  .gh-visual.is-simulated .gh-tag-real {
    opacity: 0;
  }
  /* Top-left, wide and short, so the whole block stays above the face in the photo. */
  .gh-copy {
    position: absolute;
    left: clamp(1rem, 2.5vw, 2rem);
    top: clamp(4.2rem, 9vh, 5.5rem);
    z-index: 2;
    max-width: min(44rem, 52vw);
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.7);
  }
  .gh-copy::before {
    position: absolute;
    inset: -4rem -6rem -1.5rem -3rem;
    z-index: -1;
    background: radial-gradient(closest-side, rgba(6, 9, 12, 0.6), transparent);
    content: '';
  }
  .gh-copy h1 {
    margin: 0 0 1rem;
    font-size: clamp(1.4rem, 3vw, 2.4rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.1;
  }
  .gh-copy em {
    font-style: normal;
  }
  .gh-copy p {
    margin: 0 0 0.7rem;
    opacity: 0.85;
  }
  /* The yellow line fills as you scroll through the hero. */
  .gh-cue {
    position: absolute;
    left: clamp(1rem, 2.5vw, 2rem);
    bottom: 2rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 0;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.7);
  }
  .gh-cue i {
    position: relative;
    width: 7rem;
    height: 2px;
    background: rgba(255, 255, 255, 0.28);
  }
  .gh-cue b {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: #ffcf33;
  }
  html.no-gl .gaphero {
    display: none;
  }

  /* The info card for each section: on the left, solid, outside the blended HUD so it stays
     legible over both the light and the dark scenes. */
  .model-loading {
    position: fixed;
    z-index: 11;
    transform: translate(-50%, -50%);
    margin: 0;
    padding: 0.6rem 0.9rem;
    background: rgba(6, 9, 12, 0.78);
    color: #f3f4f1;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .model-loading[hidden] {
    display: none;
  }

  .card {
    position: fixed;
    z-index: 12;
    left: clamp(1rem, 3vw, 3rem);
    top: 50%;
    width: min(34rem, 42vw);
    max-height: calc(100vh - 9rem);
    overflow-y: auto;
    padding: clamp(1.4rem, 2.4vw, 2.2rem);
    background: rgba(6, 9, 12, 0.86);
    backdrop-filter: blur(10px);
    color: #f3f4f1;
    font-family: 'Barlow', system-ui, -apple-system, 'Segoe UI', sans-serif;
    letter-spacing: 0;
    text-transform: none;
    opacity: 0;
    pointer-events: none;
    transform: translate(-0.8rem, -50%);
    transition:
      opacity 350ms ease,
      transform 350ms ease;
  }
  .card.is-on {
    opacity: 1;
    pointer-events: auto;
    transform: translate(0, -50%);
  }
  .card-title {
    margin: 0 0 0.9rem;
    font-family: var(--mono);
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1;
    text-transform: uppercase;
  }
  .card-desc {
    margin: 0 0 1.1rem;
    font-size: clamp(1.05rem, 1.25vw, 1.2rem);
    line-height: 1.5;
  }
  .card-facts {
    display: grid;
    gap: 0.6rem;
    margin: 0 0 1.6rem;
    padding: 1.1rem 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    list-style: none;
    color: #c9ced3;
    font-size: 0.98rem;
    line-height: 1.45;
  }
  .card-facts li {
    position: relative;
    padding-left: 1.1rem;
  }
  .card-facts li::before {
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.4rem;
    height: 0.4rem;
    background: #ffcf33;
    content: '';
  }
  .card-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 1.3rem;
    background: #ffcf33;
    color: #06090c;
    font-family: var(--mono);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transition: background 150ms ease;
  }
  .card-button b {
    font-size: 1.3rem;
    font-weight: 400;
    transition: transform 150ms ease;
  }
  .card-button:hover,
  .card-button:focus-visible {
    background: #fff;
  }
  .card-button:hover b {
    transform: translateX(0.3rem);
  }
  body.menu-open .card {
    visibility: hidden;
  }
  html.no-gl .card {
    display: none;
  }
  /* Over a 3D model or picture you can click through to the page. */
  #gl.is-link {
    cursor: pointer;
  }

  .cta {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: 1.4rem;
    text-align: center;
    opacity: 0;
    transition: opacity 500ms ease;
  }
  .cta.is-on {
    opacity: 1;
  }
  .cta p {
    margin: 0;
    font-size: clamp(1.3rem, 3.6vw, 2.8rem);
    letter-spacing: 0.02em;
    line-height: 1.2;
  }
  .cta a {
    justify-self: center;
  }
  .cta a:hover {
    opacity: 0.6;
  }

  .menu {
    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2.5rem;
    padding: 5rem clamp(1rem, 6vw, 6rem) 3rem;
    background: var(--dark);
    color: #fff;
  }
  .menu[hidden] {
    display: none;
  }
  .menu ol,
  .menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu ol a {
    display: inline-block;
    padding: 0.25rem 0;
    font-size: clamp(1.4rem, 4vw, 2.6rem);
    letter-spacing: 0.02em;
  }
  .menu ol a span {
    margin-right: 1rem;
    font-size: 0.72rem;
    vertical-align: 0.9em;
    opacity: 0.5;
  }
  .menu a:hover {
    opacity: 0.6;
  }
  .menu-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2rem;
  }
  /* Keep the header's menu button reachable over the open menu. */
  body.menu-open .top {
    z-index: 60;
    mix-blend-mode: normal;
  }
  body.menu-open .hud {
    z-index: 60;
    mix-blend-mode: normal;
  }
  body.menu-open .hud > :not(.top) {
    visibility: hidden;
  }

  .fallback {
    display: none;
  }
  html.no-gl #gl,
  html.no-gl .hud > :not(.top),
  html.no-gl #spacer {
    display: none;
  }
  html.no-gl .fallback {
    display: block;
    padding: 7rem clamp(1rem, 6vw, 6rem) 3rem;
  }
  html.no-gl .fallback ul {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  html.no-gl .fallback li {
    padding: 0.4rem 0;
  }
  html.no-gl .fallback h2 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 400;
  }

  @media (max-width: 40rem) {
    .index {
      display: none;
    }
    .gh-copy {
      top: 30%;
      right: 1rem;
      max-width: none;
    }
    .gh-copy p:last-child {
      display: none;
    }
    .card {
      width: auto;
      right: 1rem;
    }
  }
</style>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';
  import { RoomEnvironment } from 'three/addons/environments/RoomEnvironment.js';

  type Stop = { title: string; description: string; href: string; linkLabel: string; image: string; models?: string[]; facts?: string[] };

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stops: Stop[] = JSON.parse(document.getElementById('stops-data')!.textContent || '[]');
  const N = stops.length;

  // --- Contact link, assembled here so the address is not in the markup ---
  document.querySelectorAll<HTMLAnchorElement>('.js-email-link').forEach((link) => {
    const { emailUser, emailDomain } = link.dataset;
    if (emailUser && emailDomain) link.href = `mailto:${emailUser}@${emailDomain}`;
  });

  // --- Menu ---
  const menu = document.getElementById('menu') as HTMLElement;
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement;
  function setMenu(open: boolean) {
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.textContent = open ? 'Close ✕' : 'Menu ☰';
    document.body.classList.toggle('menu-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  }
  toggle.addEventListener('click', () => setMenu(menu.hidden));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      setMenu(false);
      toggle.focus();
    }
  });

  // --- WebGL scene ---
  const canvas = document.getElementById('gl') as HTMLCanvasElement;
  let renderer: THREE.WebGLRenderer;
  try {
    renderer = new THREE.WebGLRenderer({ canvas, antialias: false, powerPreference: 'high-performance' });
  } catch {
    document.documentElement.classList.add('no-gl');
    throw new Error('WebGL unavailable');
  }

  const DARK = new THREE.Color('#06090c');
  const LIGHT = new THREE.Color('#e9ebe6');
  const bg = LIGHT.clone();

  const SPACING = 14;
  const CAM_START = 8;
  const scene = new THREE.Scene();
  scene.background = bg;
  scene.fog = new THREE.Fog(bg, 16, 46);
  const camera = new THREE.PerspectiveCamera(45, 1, 0.1, 100);
  camera.position.set(0, 0, CAM_START);

  const target = new THREE.WebGLRenderTarget(1, 1, { type: THREE.HalfFloatType, samples: 4 });

  const post = new THREE.ShaderMaterial({
    uniforms: {
      tDiffuse: { value: target.texture },
      uTime: { value: 0 },
      uVel: { value: 0 },
      uWarp: { value: 0.1 },
      uRes: { value: new THREE.Vector2(1, 1) },
      uBg: { value: bg },
    },
    vertexShader: /* glsl */ `
      varying vec2 vUv;
      void main() { vUv = uv; gl_Position = vec4(position.xy, 0.0, 1.0); }
    `,
    fragmentShader: /* glsl */ `
      uniform sampler2D tDiffuse;
      uniform float uTime, uVel, uWarp;
      uniform vec2 uRes;
      uniform vec3 uBg;
      varying vec2 vUv;
      float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
      // A plain pass: the scene, anti-aliased, with no warp, glitch, fringing, scanlines or grain.
      void main() {
        gl_FragColor = vec4(texture2D(tDiffuse, vUv).rgb, 1.0);
        #include <colorspace_fragment>
      }
    `,
    depthTest: false,
    depthWrite: false,
  });
  const postScene = new THREE.Scene();
  postScene.add(new THREE.Mesh(new THREE.PlaneGeometry(2, 2), post));
  const postCamera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

  // Dust: a slow field of specks along the whole flight path, for depth and speed.
  const dustCount = 320;
  const dustPos = new Float32Array(dustCount * 3);
  for (let i = 0; i < dustCount; i++) {
    dustPos[i * 3] = (Math.random() - 0.5) * 22;
    dustPos[i * 3 + 1] = (Math.random() - 0.5) * 12;
    dustPos[i * 3 + 2] = 6 - Math.random() * (SPACING * (N + 2));
  }
  const dustGeo = new THREE.BufferGeometry();
  dustGeo.setAttribute('position', new THREE.BufferAttribute(dustPos, 3));
  const dustMat = new THREE.PointsMaterial({ size: 0.05, color: 0x8fa3b3, transparent: true, opacity: 0.35, depthWrite: false });
  scene.add(new THREE.Points(dustGeo, dustMat));

  // Light for the 3D models (the flat panels, dust and points are unlit and ignore it). A studio
  // environment gives the paint, chrome and glass something to reflect.
  const pmrem = new THREE.PMREMGenerator(renderer);
  scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
  scene.environmentIntensity = 0.9;
  scene.add(new THREE.HemisphereLight(0xffffff, 0x5a6672, 0.8));
  const sun = new THREE.DirectionalLight(0xffffff, 2.0);
  sun.position.set(4, 6, 5);
  scene.add(sun);

  const PAPER = 0xe9ebe6;
  const gltfLoader = new GLTFLoader();
  const draco = new DRACOLoader();
  draco.setDecoderPath('/draco/');
  gltfLoader.setDRACOLoader(draco);

  // Panels: one per stop, strung along the camera's path. Each sits in the space right of the
  // info card (see layout below): a picture, or a 3D model on a turntable.
  type Panel = {
    mesh: THREE.Mesh;
    mat: THREE.MeshBasicMaterial;
    backMat: THREE.MeshBasicMaterial;
    z: number;
    /** picture width / height, once loaded */
    aspect: number;
    /** a 3D model instead of a picture: it turns, and grows in instead of fading (fading a lit model shows its insides) */
    model?: THREE.Group;
    /** at scale 1: the model's reach from its turning axis, and its half height */
    reach: number;
    halfHeight: number;
    /** its model is still downloading */
    loading: boolean;
  };
  const panels: Panel[] = [];
  const texLoader = new THREE.TextureLoader();
  stops.forEach((stop, i) => {
    const mat = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0 });
    const mesh = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), mat);
    const z = -SPACING * (i + 1);
    mesh.position.set(0, 0, z);
    mesh.rotation.set(0, -0.12, 0);
    scene.add(mesh);
    // Pictures with a transparent background (the diagrams) would show the dark or pale scene through them and lose their
    // black lines: an opaque sheet of paper sits right behind every picture.
    const backMat = new THREE.MeshBasicMaterial({ color: PAPER, transparent: true, opacity: 0, depthWrite: false });
    const back = new THREE.Mesh(new THREE.PlaneGeometry(1, 1), backMat);
    back.position.z = -0.02;
    mesh.add(back);
    const panel: Panel = { mesh, mat, backMat, z, aspect: 1.5, reach: 1, halfHeight: 1, loading: false };
    panels.push(panel);

    const loadPicture = () =>
      texLoader.load(stop.image, (tex) => {
        tex.colorSpace = THREE.SRGBColorSpace;
        tex.anisotropy = 4;
        const { width, height } = tex.image as HTMLImageElement;
        panel.aspect = width / height;
        mat.map = tex;
        mat.needsUpdate = true;
      });

    if (stop.models?.length) {
      panel.loading = true;
      Promise.all(stop.models.map((url) => gltfLoader.loadAsync(url)))
        .then((gltfs) => {
          // Decals (the fortiss lettering) sit 1.5 mm off the paint: blend them for smooth edges,
          // and pull them forward in depth so they never flicker into the body.
          gltfs.forEach((g) =>
            g.scene.traverse((o) => {
              const m = (o as THREE.Mesh).material as THREE.MeshStandardMaterial | undefined;
              if (!m) return;
              // Only materials the model marks as see-through (the decals): the motorcycle is
              // textured all over and must stay solid.
              if (m.map && m.transparent) {
                m.map.anisotropy = renderer.capabilities.getMaxAnisotropy();
                m.depthWrite = false;
                m.polygonOffset = true;
                m.polygonOffsetFactor = -2;
                m.polygonOffsetUnits = -2;
                (o as THREE.Mesh).renderOrder = 2;
              } else if (m.transparent) {
                m.depthWrite = false; // glass: see the interior through it
                (o as THREE.Mesh).renderOrder = 1;
              }
              m.needsUpdate = true;
            }),
          );
          // Side by side along their width, a small gap apart, so they read as one group parked
          // next to each other.
          const turntable = new THREE.Group();
          const gap = 0.3;
          let x = 0;
          gltfs.forEach((g) => {
            const box = new THREE.Box3().setFromObject(g.scene);
            const size = box.getSize(new THREE.Vector3());
            const w = Math.min(size.x, size.z);
            // Turn each model so its length runs along z; then they stand side by side in x.
            if (size.x > size.z) g.scene.rotation.y = Math.PI / 2;
            g.scene.updateMatrixWorld(true);
            const turned = new THREE.Box3().setFromObject(g.scene);
            const tc = turned.getCenter(new THREE.Vector3());
            g.scene.position.set(x + w / 2 - tc.x, -turned.min.y, -tc.z);
            x += w + gap;
            turntable.add(g.scene);
          });
          // Centre the group, then measure how far it reaches from the vertical axis it turns
          // about: that, not its current width, is what has to fit on screen.
          const box = new THREE.Box3().setFromObject(turntable);
          const centre = box.getCenter(new THREE.Vector3());
          turntable.children.forEach((c) => c.position.sub(centre));
          const half = box.getSize(new THREE.Vector3()).multiplyScalar(0.5);
          panel.reach = Math.hypot(half.x, half.z);
          panel.halfHeight = half.y;
          const pivot = new THREE.Group();
          pivot.add(turntable);
          pivot.position.set(0, 0, z);
          pivot.visible = false;
          scene.add(pivot);
          panel.model = pivot;
        })
        .catch(loadPicture) // no model: show the picture
        .finally(() => {
          panel.loading = false;
          updateLoading();
        });
    } else {
      loadPicture();
    }
  });

  // --- Layout, scroll and per-frame update ---
  const spacer = document.getElementById('spacer') as HTMLElement;
  const gaphero = document.getElementById('gaphero') as HTMLElement;
  const ghVisual = document.getElementById('gh-visual') as HTMLElement;
  const ghLayers = [...ghVisual.querySelectorAll<HTMLElement>('.gh-layer')];
  const ghEdge = document.getElementById('gh-edge') as HTMLElement;
  const ghStage = document.getElementById('gh-stage') as HTMLElement;
  const ghFill = document.getElementById('gh-fill') as HTMLElement;
  const GH_LABELS = ['Simulation', 'Low poly', 'Wireframe'];
  // Where in the hero's scroll each wipe runs, with a pause on every image between them.
  const WIPES = [
    [0.06, 0.3],
    [0.38, 0.62],
    [0.7, 0.94],
  ];
  const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
  const ease = (v: number) => (v < 0.5 ? 4 * v * v * v : 1 - Math.pow(-2 * v + 2, 3) / 2);
  const HERO_SCREENS = 3.2; // how many screens of scrolling the hero takes before the flight starts
  const heroPx = () => HERO_SCREENS * window.innerHeight;

  function renderHero(p: number) {
    ghFill.style.width = `${p * 100}%`;
    let wiping = -1;
    let shown = -1;
    WIPES.forEach(([a, b], k) => {
      const w = ease(clamp01((p - a) / (b - a)));
      ghLayers[k]?.style.setProperty('--x', `${(1 - w) * 100}%`);
      if (w > 0 && w < 1) {
        wiping = k;
        ghEdge.style.setProperty('--x', `${(1 - w) * 100}%`);
      }
      if (w >= 0.5) shown = k;
    });
    ghEdge.classList.toggle('is-wiping', wiping !== -1);
    ghStage.textContent = GH_LABELS[Math.max(0, shown)];
    ghVisual.classList.toggle('is-simulated', shown >= 0);
    // Once the last wipe is done the hero lifts away and the flight begins.
    const out = 1 - smooth(0.96, 1.0, p);
    gaphero.style.opacity = String(out);
    gaphero.style.visibility = out < 0.01 ? 'hidden' : 'visible';
  }

  const indexEl = document.getElementById('index') as HTMLElement;
  const card = document.getElementById('card') as HTMLElement;
  const capFacts = document.getElementById('cap-facts') as HTMLElement;
  const capTitle = document.getElementById('cap-title') as HTMLElement;
  const capDesc = document.getElementById('cap-desc') as HTMLElement;
  const capLink = document.getElementById('cap-link') as HTMLAnchorElement;
  const cta = document.getElementById('cta') as HTMLElement;
  const indexButtons = [...indexEl.querySelectorAll<HTMLButtonElement>('button')];

  const dpr = Math.min(window.devicePixelRatio || 1, 1.75);
  const layout = { x: 2, y: 0, w: 5, h: 4 };
  const modelLoading = document.getElementById('model-loading') as HTMLElement;
  // Shown while the section on screen is waiting for its 3D model.
  function updateLoading() {
    modelLoading.hidden = !(active >= 0 && active < N && panels[active].loading);
  }

  function resize() {
    const w = window.innerWidth;
    const h = window.innerHeight;
    renderer.setPixelRatio(dpr);
    renderer.setSize(w, h, false);
    target.setSize(Math.floor(w * dpr), Math.floor(h * dpr));
    post.uniforms.uRes.value.set(w * dpr, h * dpr);
    const aspect = w / h;
    camera.aspect = aspect;
    // On tall screens, widen the field of view so the panels still fit.
    camera.fov = aspect < 1.3 ? THREE.MathUtils.radToDeg(2 * Math.atan(8.5 / aspect / 2 / CAM_START)) : 45;
    camera.updateProjectionMatrix();
    spacer.style.height = `${(N + 1) * 110 + 100 + HERO_SCREENS * 100}vh`;
    // Where pictures and models go: the space between the card's right edge and the screen's,
    // above the index row, measured at the distance the camera stops from each panel.
    const halfH = Math.tan(THREE.MathUtils.degToRad(camera.fov / 2)) * CAM_START;
    const halfW = halfH * aspect;
    const cardRight = card.getBoundingClientRect().left + card.offsetWidth;
    const left = ((2 * cardRight) / w - 1) * halfW + 0.4;
    const right = halfW * 0.9;
    layout.x = (left + right) / 2;
    layout.w = Math.max(1, right - left);
    layout.h = halfH * 2 * 0.7;
    layout.y = halfH * 0.06;
    // The loading message sits where the model will appear.
    modelLoading.style.left = `${((layout.x / halfW + 1) / 2) * w}px`;
    modelLoading.style.top = `${((1 - layout.y / halfH) / 2) * h}px`;
  }
  resize();
  window.addEventListener('resize', resize);

  const mouse = { x: 0, y: 0, tx: 0, ty: 0 };
  window.addEventListener('pointermove', (e) => {
    mouse.tx = (e.clientX / window.innerWidth - 0.5) * 2;
    mouse.ty = (e.clientY / window.innerHeight - 0.5) * 2;
  });

  const smooth = (a: number, b: number, x: number) => {
    const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
    return t * t * (3 - 2 * t);
  };

  /** Scroll position as the fly-through's t (0 until the hero is done, then 0..N+1). */
  function scrollT() {
    const hp = heroPx();
    const max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight - hp);
    return (Math.max(0, window.scrollY - hp) / max) * (N + 1);
  }
  function scrollHero() {
    return clamp01(window.scrollY / heroPx());
  }

  indexButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const i = Number(btn.dataset.index);
      const hp = heroPx();
      const max = document.documentElement.scrollHeight - window.innerHeight - hp;
      window.scrollTo({ top: hp + ((i + 1) / (N + 1)) * max, behavior: reduceMotion ? 'auto' : 'smooth' });
    }),
  );

  // Clicking the active section's picture or model opens its page, like the card's button.
  const raycaster = new THREE.Raycaster();
  const pointer = new THREE.Vector2();
  function hitActive(e: PointerEvent | MouseEvent) {
    if (active < 0 || active >= N || !card.classList.contains('is-on')) return false;
    pointer.set((e.clientX / window.innerWidth) * 2 - 1, -(e.clientY / window.innerHeight) * 2 + 1);
    raycaster.setFromCamera(pointer, camera);
    const p = panels[active];
    if (p.model) {
      const r = p.reach * p.model.scale.x;
      return raycaster.ray.intersectsSphere(new THREE.Sphere(p.model.position, r * 0.8));
    }
    return raycaster.intersectObject(p.mesh, false).length > 0;
  }
  canvas.addEventListener('pointermove', (e) => canvas.classList.toggle('is-link', hitActive(e)));
  canvas.addEventListener('click', (e) => {
    if (hitActive(e)) window.location.href = stops[active].href;
  });

  let t = scrollT();
  let hp = scrollHero();
  let active = -2;
  let last = performance.now();
  let vel = 0;

  function setActive(i: number) {
    if (i === active) return;
    active = i;
    const onStop = i >= 0 && i < N;
    indexButtons.forEach((b, k) => b.classList.toggle('is-active', k === i));
    card.classList.toggle('is-on', onStop);
    if (onStop) {
      const stop = stops[i];
      capTitle.textContent = stop.title;
      capDesc.textContent = stop.description;
      capFacts.replaceChildren(
        ...(stop.facts ?? []).map((f) => {
          const li = document.createElement('li');
          li.textContent = f;
          return li;
        }),
      );
      capLink.href = stop.href;
      (capLink.querySelector('span') as HTMLElement).textContent = stop.linkLabel;
    }
    updateLoading();
  }

  function frame(now: number) {
    const dt = Math.min(0.05, (now - last) / 1000);
    last = now;
    const goal = scrollT();
    hp = reduceMotion ? scrollHero() : hp + (scrollHero() - hp) * (1 - Math.exp(-dt * 8));
    renderHero(hp);
    const prev = t;
    t = reduceMotion ? goal : t + (goal - t) * (1 - Math.exp(-dt * 5));
    // Velocity in scene units per second, softened, drives the glitch and the extra warp.
    const raw = (t - prev) / Math.max(dt, 1e-3);
    vel += (raw - vel) * 0.15;

    mouse.x += (mouse.tx - mouse.x) * 0.05;
    mouse.y += (mouse.ty - mouse.y) * 0.05;

    const camZ = CAM_START - SPACING * t;
    camera.position.set(mouse.x * 0.12, -mouse.y * 0.08, camZ);
    camera.lookAt(mouse.x * 0.06, -mouse.y * 0.04, camZ - 10);

    // Light from the moment the hero lifts away (a dark gap there read as a blank screen);
    // dark again only for the closing section.
    const dark = smooth(N + 0.25, N + 0.75, t);
    bg.copy(LIGHT).lerp(DARK, dark);
    (scene.fog as THREE.Fog).color.copy(bg);

    panels.forEach((p) => {
      const dist = camZ - p.z;
      // Visible only as the camera approaches it, so the next one doesn't show through behind.
      // The first has nothing in front of it: it shows from the start, so the hero lifts away
      // onto it rather than onto an empty screen.
      const far = p === panels[0] ? 1 : 1 - smooth(11, 16, dist);
      const show = smooth(0.8, 3.5, dist) * far;
      p.mat.opacity = show;
      p.backMat.opacity = show;
      if (p.model) {
        // The model replaces the picture: it grows in, and turns slowly all the while. Its size
        // allows for perspective: whatever end turns towards the camera is nearer, so it looks
        // bigger, and still has to fit.
        const D = CAM_START;
        const a = layout.w / 2;
        const b = layout.h / 2;
        const fitW = (a * D) / (D + a) / p.reach;
        const fitH = (b * D) / (p.halfHeight * D + b * p.reach);
        const fit = Math.min(fitW, fitH) * 0.94;
        p.model.visible = show > 0.01 && dist < 48;
        p.model.scale.setScalar(Math.max(1e-3, show) * fit);
        // With reduced motion it stands still, at an angle where nothing hides behind the car.
        p.model.rotation.y = reduceMotion ? (p.model.children[0].children.length > 1 ? 0.3 : 0.6) : now * 0.0004;
        p.model.position.set(layout.x, layout.y, p.z);
        p.mesh.visible = false;
        return;
      }
      // Still downloading its model: nothing to show but the loading message.
      if (p.loading) {
        p.mesh.visible = false;
        return;
      }
      // Fit the picture into the free area, keeping its proportions.
      const pw = Math.min(layout.w, layout.h * p.aspect);
      p.mesh.scale.set(pw, pw / p.aspect, 1);
      p.mesh.position.set(layout.x, layout.y + (1 - show) * 0.3, p.z);
      p.mesh.visible = show > 0.01 && dist < 48;
    });

    const i = Math.round(t) - 1;
    setActive(i);
    indexEl.classList.toggle('is-on', t > 0.4 && t < N + 0.6);
    cta.classList.toggle('is-on', t > N + 0.55);

    post.uniforms.uTime.value = now / 1000;
    post.uniforms.uVel.value = reduceMotion ? 0 : Math.max(-0.2, Math.min(0.2, vel * 0.06));
    post.uniforms.uWarp.value = 0.04;

    renderer.setRenderTarget(target);
    renderer.render(scene, camera);
    renderer.setRenderTarget(null);
    renderer.render(postScene, postCamera);
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
</script>
