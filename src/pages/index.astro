---
import BaseLayout from '../layouts/BaseLayout.astro';

// The same scene, further from reality at each step: a photoreal render, a low-poly one, the
// wireframe. Scroll wipes from the photo through each in turn.
const gapLayers = [
  { src: '/images/me-and-fortuna-sim.jpg', label: 'Simulation' },
  { src: '/images/me-and-fortuna-lowpoly.jpg', label: 'Low poly' },
  { src: '/images/me-and-fortuna-wireframe.jpg', label: 'Wireframe' },
];

const stops = [
  {
    title: 'Research.',
    description:
      'How well results transfer between simulation and the real world, how to make a system more robust once that gap is measured, and how to reuse real driving data to make simulation more realistic.',
    href: '/publications/',
    linkLabel: 'Explore the research',
    image: '/images/reality-gap.png',
    imageWidth: 2667,
    imageHeight: 2662,
    imageAlt: "Diagram showing the gap between an autonomous driving system's simulated behavior and its real behavior on the same road",
    contain: true,
  },
  {
    title: 'Fortuna.',
    description:
      'A full-size, street-legal Volkswagen Passat used for camera- and LiDAR-based autonomous-driving research, which I brought back into operation after a period of inactivity.',
    href: '/fortuna/',
    linkLabel: 'Meet Fortuna',
    image: '/images/fortuna-profile.png',
    imageWidth: 775,
    imageHeight: 435,
    imageAlt: "Fortuna, fortiss's modified Passat GTE, with its roof-mounted camera and LiDAR sensor rack",
  },
  {
    title: 'Teaching.',
    description:
      'A practicum course on testing autonomous-driving systems, and the student projects I have supervised or co-supervised around it.',
    href: '/teaching/',
    linkLabel: 'See the projects',
    image: '/images/matthias-andrea-me.png',
    imageWidth: 1400,
    imageHeight: 1050,
    imageAlt: 'Matthias Weil, Andrea Stocco, and Stefano Carlo Lambertenghi next to Fortuna',
  },
  {
    title: 'Demos.',
    description: 'Perturb a driving camera feed, drive a reconstructed Munich street, and see the reality gap across four execution levels.',
    href: '/demos/',
    linkLabel: 'Try the demos',
    image: '/images/whatido.png',
    imageWidth: 2400,
    imageHeight: 1104,
    imageAlt: 'Diagram of the sim-to-real testing approach: a scenario runs through both physics and perception, is measured against real behavior, and mitigations feed back into the system',
    contain: true,
  },
  {
    title: 'About.',
    description: 'Where I grew up, how I ended up here, and what I do outside research.',
    href: '/about/',
    linkLabel: 'Read more',
    image: '/images/me.png',
    imageWidth: 600,
    imageHeight: 601,
    imageAlt: 'Stefano Carlo Lambertenghi',
    contain: true,
    inset: true,
    secondaryLink: { label: 'Open the CV', href: '/cv/' },
  },
  {
    title: 'Take a spin.',
    description: 'I scanned Fortuna and my motorcycle into 3D models. Take either for a spin, no research question required.',
    href: '/garage/',
    linkLabel: 'Open it up',
    is3D: true,
  },
];
---

<BaseLayout>
  <div class="hero-track" id="hero-track">
  <section class="hero">
    <div class="hero-visual" id="gap-scrubber">
      <img
        src="/images/me-and-fortuna.jpg"
        alt="Stefano Carlo Lambertenghi standing next to Fortuna"
        width="1400"
        height="1050"
        loading="eager"
      />
      {gapLayers.map((layer) => (
        <div class="gap-layer" aria-hidden="true">
          <img src={layer.src} alt="" width="1400" height="1050" loading="eager" decoding="async" draggable="false" />
        </div>
      ))}
      <div class="gap-edge" id="gap-edge" aria-hidden="true">
        <span class="gap-label">
          Gap
          <svg viewBox="0 0 100 12" preserveAspectRatio="none"><path d="M2 6h96" /></svg>
        </span>
      </div>
      <span class="gap-tag gap-tag-real" aria-hidden="true">Reality</span>
      <span class="gap-tag gap-tag-sim" id="gap-stage" aria-hidden="true">{gapLayers[0].label}</span>
    </div>
    <div class="hero-layout container-wide">
      <div class="hero-copy">
        <h1 class="hero-title">
          <span class="hero-title-line">Stefano Carlo</span> <em class="hero-title-line">Lambertenghi.</em>
        </h1>
        <p class="hero-intro">
          I like taking systems apart to see why they break, then putting them back together
          better. Fortuna, the research vehicle on the right, is the biggest thing I have taken
          apart so far.
        </p>
        <p class="hero-intro">
          Researcher at fortiss, doctoral candidate at TUM, and technical lead for Fortuna, our
          autonomous-driving research vehicle.
        </p>
      </div>
      <p class="hero-cue" aria-hidden="true">
        <span>Scroll to cross the gap</span>
        <i><b id="hero-cue-fill"></b></i>
      </p>
    </div>
  </section>
  <div class="hero-runway" id="hero-runway" aria-hidden="true"></div>
  </div>

  <section class="route" id="route" aria-label="Explore the site">
    <svg class="route-road" id="route-road" aria-hidden="true">
      <defs>
        <mask id="route-travelled" maskUnits="userSpaceOnUse">
          <path id="route-mask-path" />
        </mask>
      </defs>
      <path class="route-kerb" id="route-kerb" />
      <path class="route-asphalt" id="route-asphalt" />
      <path class="route-lane" id="route-lane" />
      <path class="route-lane-lit" id="route-lane-lit" mask="url(#route-travelled)" />
      <path class="route-finish" id="route-finish" />
    </svg>
    <div class="route-car" id="route-car" aria-hidden="true">
      <svg viewBox="0 0 24 48" width="24" height="48">
        <rect class="route-car-body" x="2" y="1" width="20" height="46" rx="6" />
        <path class="route-car-glass" d="M5 31h14l-2 7H7z" />
        <path class="route-car-glass" d="M6 12h12l1-6H5z" />
        <path class="route-car-rack" d="M5 16h14M5 26h14" />
        <circle class="route-car-lidar" cx="12" cy="21" r="3" />
      </svg>
    </div>

    <div class="container-wide route-stops">
      {stops.map((stop) => (
        <article class="route-stop" data-stop>
          <span class="route-sign" aria-hidden="true"></span>
          <div
            class:list={['route-visual', { 'route-visual-3d': stop.is3D, 'route-visual-contain': stop.contain, 'route-visual-inset': stop.inset }]}
            style={stop.is3D ? undefined : `--visual-ratio: ${stop.imageWidth} / ${stop.imageHeight};`}
          >
            {stop.is3D ? (
              <div class="route-3d" id="home-3d-frame">
                <canvas id="home-3d-preview" aria-label="Rotating 3D models of Fortuna and a motorcycle"></canvas>
              </div>
            ) : (
              <img src={stop.image} alt={stop.imageAlt} width={stop.imageWidth} height={stop.imageHeight} loading="lazy" />
            )}
          </div>
          <div class="route-copy">
            <h2>{stop.title}</h2>
            <p>{stop.description}</p>
            <div class="route-links">
              <a class="text-link" href={stop.href}>
                {stop.linkLabel} <span aria-hidden="true">↗︎</span>
              </a>
              {stop.secondaryLink && (
                <a class="text-link" href={stop.secondaryLink.href}>
                  {stop.secondaryLink.label} <span aria-hidden="true">↗︎</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // --- Hero: from the photo to the simulator, one wipe per step, carried by the scroll ---

  const scrubber = document.getElementById('gap-scrubber');
  const track = document.getElementById('hero-track');
  const runway = document.getElementById('hero-runway');
  const hero = track?.querySelector('.hero') as HTMLElement | null;
  if (scrubber && track && runway && hero) {
    const layers = [...scrubber.querySelectorAll<HTMLElement>('.gap-layer')];
    const edge = document.getElementById('gap-edge') as HTMLElement;
    const stage = document.getElementById('gap-stage') as HTMLElement;
    const cueFill = document.getElementById('hero-cue-fill');
    const labels = layers.map((_, i) => ['Simulation', 'Low poly', 'Wireframe'][i]);
    // Where in the runway each wipe runs, with a pause on every image between them.
    const WIPES = [
      [0.06, 0.3],
      [0.38, 0.62],
      [0.7, 0.94],
    ];
    const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
    const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    let stickyTop = 0;

    // Pinned with its bottom on the viewport's bottom when the hero is taller than the screen.
    function measure() {
      stickyTop = Math.min(0, window.innerHeight - hero!.offsetHeight);
      hero!.style.top = `${stickyTop}px`;
      render();
    }

    function render() {
      const p = clamp01((stickyTop - track!.getBoundingClientRect().top) / Math.max(1, runway!.offsetHeight));
      if (cueFill) cueFill.style.width = `${p * 100}%`;
      let wiping = -1;
      let shown = 0;
      WIPES.forEach(([a, b], k) => {
        const t = ease(clamp01((p - a) / (b - a)));
        layers[k]?.style.setProperty('--x', `${(1 - t) * 100}%`);
        if (t > 0 && t < 1) wiping = k;
        if (t >= 0.5) shown = k;
        if (k === 0 && t === 0) shown = -1;
        if (t > 0 && t < 1) edge.style.setProperty('--x', `${(1 - t) * 100}%`);
      });
      edge.classList.toggle('is-wiping', wiping !== -1);
      stage.textContent = labels[Math.max(0, shown)];
      scrubber!.classList.toggle('is-simulated', shown >= 0);
    }

    let frame = 0;
    const request = () => {
      if (!frame) frame = requestAnimationFrame(() => ((frame = 0), render()));
    };

    // Without the renders, the hero stays a plain photo.
    Promise.all(layers.map((layer) => (layer.querySelector('img') as HTMLImageElement).decode()))
      .then(() => {
        scrubber.classList.add('is-ready');
        measure();
        new ResizeObserver(measure).observe(hero);
        window.addEventListener('resize', measure);
        window.addEventListener('scroll', request, { passive: true });
      })
      .catch(() => {});
  }

  // --- The route: a road through the stops, and Fortuna driving it with the scroll ---

  const route = document.getElementById('route');
  if (route && !reduceMotion.matches) {
    const paths = ['route-kerb', 'route-asphalt', 'route-lane', 'route-lane-lit', 'route-mask-path'].map(
      (id) => document.getElementById(id) as unknown as SVGPathElement,
    );
    const road = document.getElementById('route-road') as unknown as SVGSVGElement;
    const asphalt = paths[1];
    const maskPath = paths[4];
    const finish = document.getElementById('route-finish') as unknown as SVGPathElement;
    const car = document.getElementById('route-car') as HTMLElement;
    const stopEls = [...route.querySelectorAll<HTMLElement>('[data-stop]')];
    const signs = stopEls.map((el) => el.querySelector('.route-sign') as HTMLElement);

    let total = 0;
    let endY = 0;
    let signY: number[] = [];
    let lut: { len: number; y: number }[] = [];
    let carLen = -1;
    let frame = 0;
    let last = 0;

    // A smooth road through the stop markers, wherever the layout put them.
    function build() {
      const box = route!.getBoundingClientRect();
      const w = route!.clientWidth;
      const h = route!.clientHeight;
      if (!w || !h) return;
      road.setAttribute('viewBox', `0 0 ${w} ${h}`);
      const pts = signs.map((sign) => {
        const r = sign.getBoundingClientRect();
        return [r.left + r.width / 2 - box.left, r.top + r.height / 2 - box.top];
      });
      signY = pts.map((p) => p[1]);
      endY = h - 48;
      const all = [[pts[0][0], 0], ...pts, [pts[pts.length - 1][0], endY]];
      let d = `M${all[0][0]},${all[0][1]}`;
      for (let i = 1; i < all.length; i++) {
        const [x0, y0] = all[i - 1];
        const [x1, y1] = all[i];
        const mid = (y0 + y1) / 2;
        d += `C${x0},${mid} ${x1},${mid} ${x1},${y1}`;
      }
      for (const path of paths) path.setAttribute('d', d);
      const [fx] = all[all.length - 1];
      const half = w < 700 ? 8 : 13;
      finish.setAttribute('d', `M${fx - half},${endY}H${fx + half}`);
      total = asphalt.getTotalLength();
      maskPath.style.strokeDasharray = `${total}`;
      lut = [];
      for (let len = 0; len <= total; len += 6) lut.push({ len, y: asphalt.getPointAtLength(len).y });
      lut.push({ len: total, y: endY });
      if (carLen > total) carLen = total;
      request();
    }

    function lengthAtY(y: number) {
      if (y <= 0) return 0;
      if (y >= endY) return total;
      let lo = 0;
      let hi = lut.length - 1;
      while (hi - lo > 1) {
        const mid = (lo + hi) >> 1;
        if (lut[mid].y < y) lo = mid;
        else hi = mid;
      }
      const a = lut[lo];
      const b = lut[hi];
      return a.len + ((y - a.y) / Math.max(1e-6, b.y - a.y)) * (b.len - a.len);
    }

    function tick(now: number) {
      frame = 0;
      if (!total) return;
      const dt = Math.min(0.05, (now - (last || now)) / 1000);
      last = now;
      const box = route!.getBoundingClientRect();
      const target = lengthAtY(window.innerHeight * 0.6 - box.top);
      carLen = carLen < 0 ? target : carLen + (target - carLen) * (1 - Math.exp(-dt * 7));
      const p = asphalt.getPointAtLength(carLen);
      const q = asphalt.getPointAtLength(Math.min(total, carLen + 4));
      const angle = q.x === p.x && q.y === p.y ? 0 : (Math.atan2(q.y - p.y, q.x - p.x) * 180) / Math.PI - 90;
      car.style.transform = `translate(${p.x}px, ${p.y}px) rotate(${angle}deg)`;
      maskPath.style.strokeDashoffset = `${total - carLen}`;
      stopEls.forEach((el, i) => {
        if (p.y >= signY[i] - 6) el.classList.add('is-reached');
      });
      if (Math.abs(target - carLen) > 0.5) request();
      else last = 0;
    }

    function request() {
      if (!frame) frame = requestAnimationFrame(tick);
    }

    route.classList.add('is-live');
    new ResizeObserver(build).observe(route);
    window.addEventListener('scroll', request, { passive: true });
  }

  // --- "Take a spin" preview: the scanned vehicles, turning ---

  const canvas = document.getElementById('home-3d-preview') as HTMLCanvasElement | null;
  const frame = document.getElementById('home-3d-frame') as HTMLElement | null;

  if (canvas && frame) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
    const viewDir = new THREE.Vector3(3.4, 1.7, 4.6).normalize();
    camera.position.copy(viewDir).multiplyScalar(6);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    scene.add(new THREE.HemisphereLight('#ffffff', '#1b1f1c', 1.1));
    const key = new THREE.DirectionalLight('#fff6e8', 2.2);
    key.position.set(4, 6, 3);
    scene.add(key);
    const rim = new THREE.DirectionalLight('#f05a28', 0.6);
    rim.position.set(-4, 2, -4);
    scene.add(rim);

    let model: THREE.Object3D | null = null;
    let modelRadius = 0;

    function fitCamera() {
      if (!modelRadius) return;
      const vFov = THREE.MathUtils.degToRad(camera.fov);
      const hFov = 2 * Math.atan(Math.tan(vFov / 2) * camera.aspect);
      const margin = 1.2;
      const distance = Math.max(modelRadius / Math.sin(vFov / 2), modelRadius / Math.sin(hFov / 2)) * margin;
      camera.position.copy(viewDir).multiplyScalar(distance);
      camera.lookAt(0, 0, 0);
      camera.updateProjectionMatrix();
    }

    function loadModel() {
      const dracoLoader = new DRACOLoader();
      dracoLoader.setDecoderPath('/draco/');
      const loader = new GLTFLoader();
      loader.setDRACOLoader(dracoLoader);
      // Fortuna and the GS side by side on one turntable, at their real sizes.
      Promise.all([loader.loadAsync('/models/fortuna.glb'), loader.loadAsync('/models/gs.glb')]).then(([car, bike]) => {
        const turntable = new THREE.Group();
        const onGround = (o: THREE.Object3D, x: number) => {
          const box = new THREE.Box3().setFromObject(o);
          const centre = box.getCenter(new THREE.Vector3());
          o.position.set(x - centre.x, -box.min.y, -centre.z);
          turntable.add(o);
        };
        onGround(car.scene, -1.1);
        onGround(bike.scene, 1.6);
        const box = new THREE.Box3().setFromObject(turntable);
        const centre = box.getCenter(new THREE.Vector3());
        turntable.children.forEach((c) => c.position.sub(centre));
        const sphere = new THREE.Sphere();
        new THREE.Box3().setFromObject(turntable).getBoundingSphere(sphere);
        modelRadius = sphere.radius;
        model = turntable;
        scene.add(model);
        fitCamera();
        requestRender();
      });
    }

    function resize() {
      const w = frame!.clientWidth;
      const h = frame!.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      fitCamera();
      requestRender();
    }

    // Spin only while on screen; under reduced motion, draw a still frame.
    let visible = false;
    let frameId = 0;

    function tick() {
      frameId = 0;
      if (model && !reduceMotion.matches) model.rotation.y += 0.005;
      renderer.render(scene, camera);
      if (visible && !reduceMotion.matches) requestRender();
    }

    function requestRender() {
      if (!frameId) frameId = requestAnimationFrame(tick);
    }

    // Fetch the scan only once the preview is about to scroll into view.
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        loadModel();
      },
      { rootMargin: '600px 0px' },
    ).observe(frame);

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) requestRender();
    }).observe(frame);
    reduceMotion.addEventListener('change', requestRender);

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(frame);
    resize();
  }
</script>
