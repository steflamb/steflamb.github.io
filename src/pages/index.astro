---
import BaseLayout from '../layouts/BaseLayout.astro';

const menuBlocks = [
  {
    kicker: 'The reality gap',
    title: 'Research.',
    description:
      'How well results transfer between simulation and the real world, how to make a system more robust once that gap is measured, and how to reuse real driving data to make simulation more realistic.',
    href: '/publications/',
    linkLabel: 'Explore the research',
    image: '/images/reality-gap.png',
    imageWidth: 2667,
    imageHeight: 2662,
    imageAlt: "Diagram showing the gap between an autonomous driving system's simulated behavior and its real behavior on the same road",
    contain: true,
    transparent: true,
  },
  {
    kicker: 'The research platform',
    title: 'Fortuna.',
    description:
      'A full-size, street-legal Volkswagen Passat used for camera- and LiDAR-based autonomous-driving research, which I brought back into operation after a period of inactivity.',
    href: '/fortuna/',
    linkLabel: 'Meet Fortuna',
    image: '/images/fortuna-profile.png',
    imageWidth: 775,
    imageHeight: 435,
    imageAlt: "Fortuna, fortiss's modified Passat GTE, with its roof-mounted camera and LiDAR sensor rack",
  },
  {
    kicker: 'Students and courses',
    title: 'Teaching.',
    description:
      'A practicum course on testing autonomous-driving systems, and the student projects I have supervised or co-supervised around it.',
    href: '/teaching/',
    linkLabel: 'See the projects',
    image: '/images/matthias-andrea-me.png',
    imageWidth: 1400,
    imageHeight: 1050,
    imageAlt: 'Matthias Weil, Andrea Stocco, and Stefano Carlo Lambertenghi next to Fortuna',
  },
  {
    kicker: 'Seeing it work',
    title: 'Demos.',
    description: 'Perturb a driving camera feed, drive a reconstructed Munich street, and see the reality gap across four execution levels.',
    href: '/demos/',
    linkLabel: 'Try the demos',
    image: '/images/whatido.png',
    imageWidth: 2400,
    imageHeight: 1104,
    imageAlt: 'Diagram of the sim-to-real testing approach: a scenario runs through both physics and perception, is measured against real behavior, and mitigations feed back into the system',
    contain: true,
    transparent: true,
  },
  {
    kicker: 'The longer version',
    title: 'About.',
    description: 'Where I grew up, how I ended up here, and what I do outside research.',
    href: '/about/',
    linkLabel: 'Read more',
    image: '/images/me.png',
    imageWidth: 600,
    imageHeight: 601,
    imageAlt: 'Stefano Carlo Lambertenghi',
    contain: true,
    transparent: true,
    inset: true,
    secondaryLink: { label: 'Open the CV', href: '/cv/' },
  },
  {
    kicker: 'Just for fun',
    title: 'Take a spin.',
    description: 'I scanned Fortuna and my motorcycle into 3D models. Take either for a spin, no research question required.',
    href: '/garage/',
    linkLabel: 'Open it up',
    is3D: true,
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="hero-visual" id="gap-scrubber">
      <img
        src="/images/me-and-fortuna.jpg"
        alt="Stefano Carlo Lambertenghi standing next to Fortuna"
        width="1400"
        height="1050"
        loading="eager"
      />
      <div class="gap-sim" aria-hidden="true">
        <img id="gap-sim-image" src="/images/me-and-fortuna-sim.jpg" alt="" width="1400" height="1050" loading="eager" decoding="async" draggable="false" />
        <span class="gap-tag gap-tag-sim">Simulation</span>
      </div>
      <div class="gap-wire" aria-hidden="true">
        <img id="gap-wire-image" src="/images/me-and-fortuna-wireframe.jpg" alt="" width="1400" height="1050" loading="eager" decoding="async" draggable="false" />
      </div>
      <span class="gap-tag gap-tag-real" aria-hidden="true">Reality</span>
      <div
        class="gap-divider"
        id="gap-divider"
        role="slider"
        tabindex="0"
        aria-label="Compare the 3D scan of Fortuna with the photo"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="100"
        aria-valuetext="Photo only"
      >
        <span class="gap-label" aria-hidden="true">
          Gap
          <svg viewBox="0 0 100 12" preserveAspectRatio="none"><path d="M2 6h96" /></svg>
        </span>
        <span class="gap-knob" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18"><path d="M9 6 3 12l6 6M15 6l6 6-6 6" /></svg>
        </span>
      </div>
    </div>
    <div class="hero-layout container-wide">
      <div class="hero-copy">
        <p class="eyebrow">fortiss · Technical University of Munich</p>
        <h1 class="hero-title">
          <span class="hero-title-line">Stefano Carlo</span> <em class="hero-title-line">Lambertenghi.</em>
        </h1>
        <p class="hero-intro">
          I like taking systems apart to see why they break, then putting them back together
          better. Fortuna, the research vehicle on the right, is the biggest thing I have taken
          apart so far.
        </p>
        <p class="hero-intro">
          Researcher at fortiss, doctoral candidate at TUM, and technical lead for Fortuna, our
          autonomous-driving research vehicle.
        </p>
      </div>
    </div>
  </section>

  <section class="mini-feature-list" aria-label="Explore the site">
    <div class="container-wide">
      {menuBlocks.map((block) => (
        <article class="mini-feature" data-reveal>
          <div
            class:list={['mini-feature-visual', { 'mini-feature-visual-3d': block.is3D, 'mini-feature-visual-contain': block.contain, 'mini-feature-visual-transparent': block.transparent, 'mini-feature-visual-inset': block.inset }]}
            style={block.is3D ? undefined : `--visual-ratio: ${block.imageWidth} / ${block.imageHeight};`}
          >
            {block.is3D ? (
              <div class="video-frame" id="home-3d-frame">
                <canvas id="home-3d-preview" aria-label="Rotating 3D models of Fortuna and a motorcycle"></canvas>
              </div>
            ) : (
              <img
                src={block.image}
                alt={block.imageAlt}
                width={block.imageWidth}
                height={block.imageHeight}
                loading="lazy"
              />
            )}
          </div>
          <div class="mini-feature-copy">
            <p class="feature-kicker">{block.kicker}</p>
            <h2>{block.title}</h2>
            <p>{block.description}</p>
            <div class="mini-feature-links">
              <a class="text-link" href={block.href}>
                {block.linkLabel} <span aria-hidden="true">↗︎</span>
              </a>
              {block.secondaryLink && (
                <a class="text-link" href={block.secondaryLink.href}>
                  {block.secondaryLink.label} <span aria-hidden="true">↗︎</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/addons/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'three/addons/loaders/DRACOLoader.js';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // --- Hero: the same scene, simulated and real ---

  // #gap-sim-image and #gap-wire-image are renders of the simulated scene, framed identically
  // to the photo; the wireframe shows only inside the gap band that rides the divider.
  const REST_SPLIT = 50;
  const PHOTO = { width: 1400, height: 1050, focusX: 0.24 };
  // Right edge of the person in the frame (px in the 1400px photo). The photoreal render
  // stops there; dragging further stretches the wireframe band over him instead.
  const FIGURE_RIGHT = 420;
  const BAND = { min: 52, share: 0.09, max: 88 };

  const scrubber = document.getElementById('gap-scrubber') as HTMLElement | null;
  const simImage = document.getElementById('gap-sim-image') as HTMLImageElement | null;
  const wireImage = document.getElementById('gap-wire-image') as HTMLImageElement | null;
  const divider = document.getElementById('gap-divider') as HTMLElement | null;

  if (scrubber && simImage && divider) {
    let split = 100;
    let halfBand = 3;
    let figureEdge = 0;
    let tween = 0;

    // Mirror the img's object-fit: cover crop to find the figure's edge in the panel.
    function measure() {
      const w = scrubber!.clientWidth;
      const h = scrubber!.clientHeight;
      if (!w || !h) return;
      const scale = Math.max(w / PHOTO.width, h / PHOTO.height);
      const cropX = (PHOTO.width * scale - w) * PHOTO.focusX;
      figureEdge = ((FIGURE_RIGHT * scale - cropX) / w) * 100;
      halfBand = (Math.max(BAND.min, Math.min(BAND.max, w * BAND.share)) / 2 / w) * 100;
      divider!.setAttribute('aria-valuemin', String(Math.round(halfBand)));
      setSplit(split);
    }

    // `split` is the centre of the gap band. The band's right edge, where the photoreal
    // render begins, never passes the figure; past that point the band only widens.
    function setSplit(value: number) {
      split = Math.max(halfBand, Math.min(100, value));
      const left = split - halfBand;
      const right = Math.max(split + halfBand, figureEdge);
      scrubber!.style.setProperty('--gap-left', `${left}%`);
      scrubber!.style.setProperty('--gap-right', `${right}%`);
      scrubber!.style.setProperty('--gap-knob', `${((split - left) / (right - left)) * 100}%`);
      divider!.setAttribute('aria-valuenow', String(Math.round(split)));
      divider!.setAttribute('aria-valuetext', left >= 100 ? 'Photo only' : `${Math.round(Math.max(0, 100 - right))}% simulation`);
    }

    function stopTween() {
      cancelAnimationFrame(tween);
      tween = 0;
    }

    function sweepTo(target: number, duration: number) {
      stopTween();
      const from = split;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        setSplit(from + (target - from) * (1 - Math.pow(2, -10 * t)));
        tween = t < 1 ? requestAnimationFrame(step) : 0;
      };
      tween = requestAnimationFrame(step);
    }

    function splitFromPointer(event: PointerEvent) {
      const rect = scrubber!.getBoundingClientRect();
      setSplit(((event.clientX - rect.left) / rect.width) * 100);
    }

    let dragging = false;
    scrubber.addEventListener('pointerdown', (event) => {
      if (!scrubber!.classList.contains('is-ready') || event.button !== 0) return;
      event.preventDefault();
      dragging = true;
      stopTween();
      scrubber!.setPointerCapture(event.pointerId);
      scrubber!.classList.add('is-dragging');
      splitFromPointer(event);
    });
    scrubber.addEventListener('pointermove', (event) => {
      if (dragging) splitFromPointer(event);
    });
    const endDrag = () => {
      dragging = false;
      scrubber!.classList.remove('is-dragging');
    };
    scrubber.addEventListener('pointerup', endDrag);
    scrubber.addEventListener('pointercancel', endDrag);

    divider.addEventListener('keydown', (event) => {
      const steps: Record<string, number> = {
        ArrowLeft: -5,
        ArrowDown: -5,
        ArrowRight: 5,
        ArrowUp: 5,
        PageDown: -20,
        PageUp: 20,
      };
      if (event.key in steps) setSplit(split + steps[event.key]);
      else if (event.key === 'Home') setSplit(0);
      else if (event.key === 'End') setSplit(100);
      else return;
      stopTween();
      event.preventDefault();
    });

    // Without the render, the hero stays a plain photo.
    Promise.all([simImage.decode(), wireImage?.decode()])
      .then(() => {
        scrubber!.classList.add('is-ready');
        measure();
        new ResizeObserver(measure).observe(scrubber!);
        if (reduceMotion.matches) setSplit(REST_SPLIT);
        else sweepTo(REST_SPLIT, 1400);
      })
      .catch(() => {});
  }

  // --- "Take a spin" preview: the scanned vehicles, turning ---

  const canvas = document.getElementById('home-3d-preview') as HTMLCanvasElement | null;
  const frame = document.getElementById('home-3d-frame') as HTMLElement | null;

  if (canvas && frame) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 100);
    const viewDir = new THREE.Vector3(3.4, 1.7, 4.6).normalize();
    camera.position.copy(viewDir).multiplyScalar(6);
    camera.lookAt(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

    scene.add(new THREE.HemisphereLight('#ffffff', '#1b1f1c', 1.1));
    const key = new THREE.DirectionalLight('#fff6e8', 2.2);
    key.position.set(4, 6, 3);
    scene.add(key);
    const rim = new THREE.DirectionalLight('#ff6034', 0.6);
    rim.position.set(-4, 2, -4);
    scene.add(rim);

    let model: THREE.Object3D | null = null;
    let modelRadius = 0;

    function fitCamera() {
      if (!modelRadius) return;
      const vFov = THREE.MathUtils.degToRad(camera.fov);
      const hFov = 2 * Math.atan(Math.tan(vFov / 2) * camera.aspect);
      const margin = 1.2;
      const distance = Math.max(modelRadius / Math.sin(vFov / 2), modelRadius / Math.sin(hFov / 2)) * margin;
      camera.position.copy(viewDir).multiplyScalar(distance);
      camera.lookAt(0, 0, 0);
      camera.updateProjectionMatrix();
    }

    function loadModel() {
      const dracoLoader = new DRACOLoader();
      dracoLoader.setDecoderPath('/draco/');
      const loader = new GLTFLoader();
      loader.setDRACOLoader(dracoLoader);
      // Fortuna and the GS side by side on one turntable, at their real sizes.
      Promise.all([loader.loadAsync('/models/fortuna.glb'), loader.loadAsync('/models/gs.glb')]).then(([car, bike]) => {
        const turntable = new THREE.Group();
        const onGround = (o: THREE.Object3D, x: number) => {
          const box = new THREE.Box3().setFromObject(o);
          const centre = box.getCenter(new THREE.Vector3());
          o.position.set(x - centre.x, -box.min.y, -centre.z);
          turntable.add(o);
        };
        onGround(car.scene, -1.1);
        onGround(bike.scene, 1.6);
        const box = new THREE.Box3().setFromObject(turntable);
        const centre = box.getCenter(new THREE.Vector3());
        turntable.children.forEach((c) => c.position.sub(centre));
        const sphere = new THREE.Sphere();
        new THREE.Box3().setFromObject(turntable).getBoundingSphere(sphere);
        modelRadius = sphere.radius;
        model = turntable;
        scene.add(model);
        fitCamera();
        requestRender();
      });
    }

    function resize() {
      const w = frame!.clientWidth;
      const h = frame!.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      fitCamera();
      requestRender();
    }

    // Spin only while on screen; under reduced motion, draw a still frame.
    let visible = false;
    let frameId = 0;

    function tick() {
      frameId = 0;
      if (model && !reduceMotion.matches) model.rotation.y += 0.005;
      renderer.render(scene, camera);
      if (visible && !reduceMotion.matches) requestRender();
    }

    function requestRender() {
      if (!frameId) frameId = requestAnimationFrame(tick);
    }

    // Fetch the scan only once the preview is about to scroll into view.
    new IntersectionObserver(
      ([entry], observer) => {
        if (!entry.isIntersecting) return;
        observer.disconnect();
        loadModel();
      },
      { rootMargin: '600px 0px' },
    ).observe(frame);

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible) requestRender();
    }).observe(frame);
    reduceMotion.addEventListener('change', requestRender);

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(frame);
    resize();
  }
</script>
