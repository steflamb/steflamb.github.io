---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publications } from '../data/site';

const featuredPublications = publications.slice(0, 4);
---

<BaseLayout>
  <section class="hero">
    <div class="hero-layout container-wide">
      <div class="hero-copy">
        <p class="eyebrow">fortiss · Technical University of Munich</p>
        <h1 class="hero-title">
          Stefano Carlo <em>Lambertenghi.</em>
        </h1>
        <p class="hero-intro">
          Researcher at fortiss, doctoral candidate at TUM, and technical lead for Fortuna, our
          autonomous-driving research vehicle.
        </p>
        <p class="hero-intro">
          I work on testing autonomous-driving systems, in particular the differences between
          simulation and real-world execution, using simulation, machine learning, and
          experiments with real vehicles.
        </p>
        <div class="hero-actions">
          <a class="button" href="/fortuna/">Meet Fortuna</a>
          <a class="button-secondary" href="/research/">Explore the research</a>
        </div>
      </div>

      <div class="hero-visual" aria-label="Fortuna, the fortiss research vehicle">
        <div class="fortuna-photo">
          <img
            src="/images/home-hero.png"
            alt="Fortuna split down the middle: the real vehicle on the left, its digital twin model on the right"
            width="1400"
            height="1225"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="work-heading">
    <div class="container-wide">
      <div class="section-heading" data-reveal>
        <p class="eyebrow">What I work on</p>
        <div>
          <h2 id="work-heading" class="display-title">
            Simulation and real-world <em>testing.</em>
          </h2>
          <p class="section-lede">
            Testing autonomous-driving systems only in the real world is expensive and difficult,
            so we use simulation instead. My research looks at how well results from simulation
            transfer to a real vehicle, how that gap can be measured, and how real driving data
            can be brought back into simulation for further testing.
          </p>
        </div>
      </div>

      <div class="pillar-grid">
        <a class="pillar-card" href="/fortuna/" data-reveal>
          <span class="pillar-number">01 / PLATFORM</span>
          <span class="pillar-symbol" aria-hidden="true">F.</span>
          <h3>Fortuna</h3>
          <p>A full-size, street-legal research vehicle used for camera and LiDAR testing on public roads.</p>
          <span class="pillar-arrow" aria-hidden="true">↗︎</span>
        </a>
        <a class="pillar-card" href="/research/" data-reveal>
          <span class="pillar-number">02 / METHOD</span>
          <span class="pillar-symbol" aria-hidden="true">S↔R</span>
          <h3>Simulation to reality</h3>
          <p>Testing, reconstruction, perturbation, and validation across multiple levels of fidelity.</p>
          <span class="pillar-arrow" aria-hidden="true">↗︎</span>
        </a>
        <a class="pillar-card" href="/publications/" data-reveal>
          <span class="pillar-number">03 / EVIDENCE</span>
          <span class="pillar-symbol" aria-hidden="true">Σ</span>
          <h3>Research in the open</h3>
          <p>Peer-reviewed papers, executable tools, and replication packages.</p>
          <span class="pillar-arrow" aria-hidden="true">↗︎</span>
        </a>
      </div>
    </div>
  </section>

  <section class="fortuna-feature" aria-labelledby="fortuna-heading">
    <div class="fortuna-feature-visual">
      <figure class="fortuna-photo">
        <img
          src="/images/fortuna-profile.png"
          alt="Fortuna, fortiss's modified Passat GTE, with its roof-mounted camera and LiDAR sensor rack"
          width="775"
          height="435"
          loading="lazy"
        />
        <figcaption class="video-frame-caption">(I am horrible at cropping images.)</figcaption>
      </figure>
    </div>
    <div class="fortuna-feature-copy">
      <div class="fortuna-feature-lead">
        <p class="feature-kicker">The research platform</p>
        <h2 id="fortuna-heading">Meet <em>Fortuna.</em></h2>
        <p class="feature-description">
          A 2018 Volkswagen Passat Variant GTE turned into a working experimental platform for
          camera- and LiDAR-based autonomous driving, hardware-in-the-loop testing, and
          public-road research.
        </p>
      </div>
      <div>
        <div class="feature-metrics" aria-label="Recent Fortuna study metrics">
          <div class="feature-metric"><strong>72</strong><span>camera + LiDAR perturbations</span></div>
          <div class="feature-metric"><strong>740+</strong><span>test executions</span></div>
          <div class="feature-metric"><strong>48h+</strong><span>physical driving in one study</span></div>
          <div class="feature-metric"><strong>3</strong><span>testing modalities compared</span></div>
        </div>
        <a class="feature-source" href="https://arxiv.org/abs/2607.04953" target="_blank" rel="noreferrer">
          Source: ASE 2026 study ↗︎
        </a>
        <a class="text-link" href="/fortuna/">Read Fortuna’s story <span aria-hidden="true">↗︎</span></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="papers-heading">
    <div class="container-wide publication-preview">
      <div class="publication-preview-copy" data-reveal>
        <p class="eyebrow">Selected work</p>
        <h2 id="papers-heading" class="display-title">Publications.</h2>
        <p class="section-lede">
          Papers on the reality gap, robustness testing, failure forecasting, and reconstructing
          real drives in simulation.
        </p>
        <a class="text-link" href="/publications/" style="margin-top: 2rem;">
          All publications <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="publication-mini-list">
        {featuredPublications.map((publication) => (
          <a class="publication-mini" href={publication.paper} target="_blank" rel="noreferrer" data-reveal>
            <span class="pub-year">{publication.year}</span>
            <span>
              <span class="pub-venue">{publication.venue}</span>
              <h3>{publication.title}</h3>
            </span>
            <span class="pub-arrow" aria-hidden="true">↗︎</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="quote-band">
    <div class="container-wide" data-reveal>
      <p class="quote-statement">
        A robust model does not automatically make a robust <em>system.</em>
      </p>
    </div>
  </section>
</BaseLayout>
