---
import BareLayout from '../layouts/BareLayout.astro';
import { profileLinks, publications } from '../data/site';

const cam2simPaper = publications.find((p) => p.title.startsWith('Cam2Sim'))!;
const realityGapPaper = publications.find((p) => p.title.startsWith('A Multi-Modality Evaluation'))!;
const perturbationBenchmarkPaper = publications.find((p) => p.title.startsWith('Benchmarking Image Perturbations'))!;
const perturbationDriveJournalPaper = publications.find((p) => p.title.startsWith('PerturbationDrive:'))!;
const forecastingPaper = publications.find((p) => p.title.startsWith('Misbehavior Forecasting'))!;
const qualityMetricsPaper = publications.find((p) => p.title.startsWith('Assessing Quality Metrics'))!;

const paperLink = (p: (typeof publications)[number]) => ({
  meta: `${p.venue} · ${p.year}`,
  label: p.title,
  href: p.paper,
});


const themes = [
  {
    number: '01',
    title: 'Reality-gap measurement',
    copy: 'Measure which actuation, perception, and behavioral differences matter when a test moves between virtual and physical environments.',
    finding: 'Vehicle-in-the-loop testing reduced the actuation gap, and mixed-reality testing reduced the perception gap, compared with simulation alone.',
    links: [paperLink(realityGapPaper)],
  },
  {
    number: '02',
    title: 'Robustness under perturbation',
    copy: 'Stress camera and LiDAR pipelines, then follow the effect beyond model accuracy into timing, planning, control, and system behavior.',
    finding: 'Offline robustness was only weakly predictive of closed-loop failures on the real vehicle; training on perturbed data improved robustness under adverse conditions.',
    links: [paperLink(perturbationBenchmarkPaper), paperLink(perturbationDriveJournalPaper)],
  },
  {
    number: '03',
    title: 'Focused failure discovery',
    copy: 'Use near misses and predicted future states to spend the testing budget where failures are more likely to surface.',
    finding: 'Focusing the search around forecasted near misses found failures using a smaller testing budget than an unfocused search.',
    links: [paperLink(forecastingPaper)],
  },
  {
    number: '04',
    title: 'Real-to-simulation reconstruction',
    copy: 'Turn recorded road scenes into replayable simulations that preserve the geometry, trajectory, and visual character of the original drive.',
    finding: "It's not a full replacement for the real environment, but it lets us reuse real drives for closed-loop testing.",
    links: [paperLink(cam2simPaper), paperLink(qualityMetricsPaper)],
  },
  {
    number: '05',
    title: 'Execution environments',
    copy: 'The interfaces and tooling that let the same test run in simulation, hardware-in-the-loop, or on a physical vehicle, without rewriting it each time.',
    links: [paperLink(realityGapPaper)],
  },
  {
    number: '06',
    title: 'Research platforms',
    copy: 'Fortuna, the small-scale platform, and the tools around them are maintained so other students and researchers can keep using them, not just demo them once.',
    links: [
      { meta: 'Vehicle', label: 'Fortuna, the research platform', href: '#fortuna' },
      { meta: 'Students', label: 'Teaching and student projects', href: 'https://steflamb.github.io/teaching/' },
    ],
  },
];
---

<BareLayout
  title="Portfolio — Stefano Carlo Lambertenghi"
  description="A single-page portfolio: research on the reality gap and robustness, selected publications, and Fortuna, fortiss's full-scale autonomous-driving research vehicle."
>
  <!-- ============ CHAPTER 01 — ABOUT ============ -->
  <div id="about">
    <section class="page-hero page-hero-light">
      <div class="page-hero-inner research-hero-grid container-wide">
        <div>
          <p class="eyebrow">01 — Who I am</p>
          <h1 class="page-title">Stefano Carlo <em>Lambertenghi.</em></h1>
          <p class="page-hero-copy">
            I like taking systems apart to see why they break, then putting them back together
            better. Fortuna, the research vehicle, is the biggest thing I have taken apart so far.
          </p>
          <p class="page-hero-copy">
            Researcher at fortiss, doctoral candidate at TUM, and technical lead for Fortuna, our
            autonomous-driving research vehicle.
          </p>
        </div>
        <div class="diagram-plate research-hero-image-small">
          <img
            src="/images/me-and-fortuna.jpg"
            alt="Stefano Carlo Lambertenghi standing next to Fortuna"
            width="1400"
            height="1050"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="about-heading">
      <div class="container-wide">
        <div class="about-copy" data-reveal>
          <p class="eyebrow">The short version</p>
          <h2 id="about-heading">Background.</h2>
          <p>
            I'm Stefano, an Italian computer scientist and researcher currently living in Munich. I
            grew up in Sondrio, a small town in the Italian Alps, and studied computer science in
            Verona, Italy, before moving to Lugano, Switzerland, to study artificial intelligence at
            USI.
          </p>
          <p>
            While at USI, I met my current PhD supervisor, Andrea Stocco, at Formula USI, a
            hackathon he organized around the Donkey Car platform. That little car ended up being
            more important than I expected. When Andrea later offered a PhD position working on
            autonomous driving and testing, I followed him to Germany. We still use the same Donkey
            Car platform in our research today.
          </p>
          <p>
            Before moving to Munich, my main project at IDSIA was my Master's thesis on autonomous
            nano-drones, which I continued for another year as an intern. I worked on fitting a
            relative-localization neural network onto a 40-gram quadrotor, allowing it to track
            another drone in real time using a single onboard camera and less than 100 mW of power.
            The work eventually became a paper at{' '}
            <a href="https://arxiv.org/abs/2303.01940" target="_blank" rel="noreferrer">IEEE ICRA 2023</a>.
          </p>
          <p>
            In 2023, I joined fortiss and the Technical University of Munich for my PhD. The robots
            became considerably larger. Today most of my work revolves around autonomous driving
            and, in particular, understanding what happens when systems tested in simulation are
            deployed in the real world.
          </p>
          <p>
            That has made my PhD much more hands-on than I originally expected. Alongside
            experimental design and research papers, I spend a lot of time working with ROS,
            sensors, vehicle interfaces, computers, cables, and whatever has decided not to work
            that morning. I am also the technical lead for Fortuna, our full-size autonomous
            research vehicle.
          </p>
          <p>
            There is probably a common thread through all of this. I like working on systems where
            software eventually has to interact with something physical. I'm interested in machine
            learning and simulation, but mostly in what happens when you actually deploy them and
            discover which assumptions were wrong.
          </p>
          <p>
            Outside research, I simply enjoy playing with hardware and building things. Fortuna's
            recovery started as work and gradually became a bit of a hobby. Some of the less
            serious things I have built around it ended up in the{' '}
            <a href="https://steflamb.github.io/garage/" target="_blank" rel="noreferrer">Just for fun</a> section.
          </p>
          <p>
            Growing up in the Alps also means I have been skiing for as long as I can remember. When
            there is no snow, I enjoy windsurfing. I also like travelling by motorcycle with my
            girlfriend, Francesca. Moving to Munich gave me a sufficiently good excuse to buy a BMW
            GS, which has since become our preferred way of disappearing somewhere for a few days.
          </p>

          <dl class="about-details">
            <div><dt>Current</dt><dd>Researcher at fortiss · Doctoral researcher at TUM</dd></div>
            <div><dt>Focus</dt><dd>Testing and validation of autonomous systems</dd></div>
            <div><dt>Methods</dt><dd>Simulation, mixed reality, field experiments, empirical software engineering</dd></div>
            <div><dt>Platforms</dt><dd>Fortuna (full-size) and a small-scale Donkey Car research vehicle</dd></div>
          </dl>

          <div class="hero-actions">
            <a class="button button-dark" href="mailto:lambertenghi@fortiss.org">Email me</a>
            <a class="button button-dark" href="https://github.com/steflamb" target="_blank" rel="noreferrer">GitHub</a>
            <a class="button button-dark" href="https://steflamb.github.io/cv/" target="_blank" rel="noreferrer">View CV</a>
          </div>
        </div>
      </div>
    </section>

  </div>

  <!-- ============ CHAPTER 02 — RESEARCH ============ -->
  <div id="research">
    <section class="page-hero page-hero-light">
      <div class="page-hero-inner research-hero-grid container-wide">
        <div>
          <p class="eyebrow">02 — Research / simulation ↔ reality</p>
          <h1 class="page-title">Research.</h1>
          <p class="page-hero-copy">
            I study how well results transfer between simulation and the real world, how to make an
            autonomous-driving system more robust once that gap is measured, and how to reuse real
            driving data to make simulation more realistic.
          </p>
        </div>
        <div class="diagram-plate research-hero-image-small">
          <img
            src="/images/reality-gap.jpg"
            alt="Diagram showing the gap between an autonomous driving system's simulated behavior and its real behavior on the same road"
            width="2260"
            height="1995"
            loading="eager"
          />
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="themes-heading">
      <div class="container-wide">
        <div class="section-heading theme-heading-centered" data-reveal>
          <p class="eyebrow">Research themes</p>
          <div>
            <h2 id="themes-heading" class="display-title">Six research themes.</h2>
          </div>
        </div>

        <div class="theme-grid">
          {themes.map((theme) => (
            <article class="theme-card" data-reveal>
              <span class="theme-number">{theme.number}</span>
              <h3>{theme.title}</h3>
              <p>{theme.copy}</p>
              {theme.finding && (
                <p class="theme-finding"><strong>Found:</strong> {theme.finding}</p>
              )}
              <div class="theme-papers" aria-label={`Related work on ${theme.title}`}>
                {theme.links.map((link) => (
                  <a class="theme-paper" href={link.href} target={link.href.startsWith('/') || link.href.startsWith('#') ? undefined : '_blank'} rel={link.href.startsWith('/') || link.href.startsWith('#') ? undefined : 'noreferrer'}>
                    <span class="theme-paper-meta">{link.meta}</span>
                    <span class="theme-paper-title">{link.label} <span aria-hidden="true">↗︎</span></span>
                  </a>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="demos-heading">
      <div class="container-wide">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">Seeing it work</p>
          <div>
            <h2 id="demos-heading" class="display-title">Demos.</h2>
            <p class="section-lede">
              Papers describe the method. These recordings show what it actually looks like.
            </p>
          </div>
        </div>

        <div class="demo-showcase-list">
          <div class="demo-showcase" data-reveal>
            <a
              class="video-frame watch-link"
              href="https://www.youtube.com/watch?v=KmZ74l1__lI"
              target="_blank"
              rel="noreferrer"
              aria-label="Watch the Cam2Sim demo video on YouTube"
            >
              <img src="https://img.youtube.com/vi/KmZ74l1__lI/hqdefault.jpg" alt="Cam2Sim demo video thumbnail" loading="lazy" />
              <span class="play-badge"><span class="play-icon" aria-hidden="true">▶</span> Watch demo ↗︎</span>
            </a>
            <div class="demo-showcase-copy">
              <p class="feature-kicker">Cam2Sim</p>
              <h3>Real drives, replayed in simulation.</h3>
              <p>
                Cam2Sim started from a practical problem. We had many hours of real driving
                recordings, but once an experiment was finished we could only replay the recorded
                sensor data. We wanted to turn these recordings into environments in which the
                driving system could interact again. Cam2Sim reconstructs the recorded environment
                in CARLA and uses Gaussian Splatting for the camera view. The reconstruction is not
                a complete replacement for the real environment, but it allows us to reuse real
                experiments for closed-loop simulation.
              </p>
              <a class="text-link" href={cam2simPaper.paper} target="_blank" rel="noreferrer">
                Read the paper <span aria-hidden="true">↗︎</span>
              </a>
            </div>
          </div>

          <div class="demo-showcase" data-reveal>
            <a
              class="video-frame watch-link"
              href="https://www.youtube.com/watch?v=-YGdyNXgKb8"
              target="_blank"
              rel="noreferrer"
              aria-label="Watch the ASE 2025 demo video on YouTube"
            >
              <img src="https://img.youtube.com/vi/-YGdyNXgKb8/hqdefault.jpg" alt="ASE 2025 demo video thumbnail" loading="lazy" />
              <span class="play-badge"><span class="play-icon" aria-hidden="true">▶</span> Watch demo ↗︎</span>
            </a>
            <div class="demo-showcase-copy">
              <p class="feature-kicker">ASE 2025</p>
              <h3>The same reality gap, across three execution levels.</h3>
              <p>
                An open-source small-scale vehicle and its Unity digital twin, compared against
                Fortuna at full scale, across simulation, vehicle-in-the-loop, and mixed-reality
                testing.
              </p>
              <a class="text-link" href={realityGapPaper.paper} target="_blank" rel="noreferrer">
                Read the paper <span aria-hidden="true">↗︎</span>
              </a>
            </div>
          </div>

          <div class="demo-showcase" data-reveal>
            <a
              class="video-frame watch-link"
              href="https://steflamb.github.io/videos/perturbationdrive-demo.mp4"
              target="_blank"
              rel="noreferrer"
              aria-label="Watch the PerturbationDrive demo video"
            >
              <img src="/images/perturbationdrive-poster.jpg" alt="PerturbationDrive demo video thumbnail" loading="lazy" />
              <span class="play-badge"><span class="play-icon" aria-hidden="true">▶</span> Watch demo ↗︎</span>
            </a>
            <div class="demo-showcase-copy">
              <p class="feature-kicker">PerturbationDrive</p>
              <h3>The same perturbation, any simulator.</h3>
              <p>
                PerturbationDrive generates camera perturbations—like rain, or a corrupted
                feed—and applies them through a simulator adapter, so the same scenario runs
                unchanged across Udacity's simulator, a small-scale digital twin, or a full driving
                stack. This recording walks through the scenario generator and simulator adapter
                behind the ICST 2025 benchmark.
              </p>
              <a class="text-link" href={perturbationBenchmarkPaper.paper} target="_blank" rel="noreferrer">
                Read the paper <span aria-hidden="true">↗︎</span>
              </a>
            </div>
          </div>

          <div class="demo-showcase" data-reveal>
            <a
              class="video-frame watch-link"
              href="https://steflamb.github.io/videos/foresee-demo.mp4"
              target="_blank"
              rel="noreferrer"
              aria-label="Watch the Foresee demo video"
            >
              <img src="/images/foresee-poster.jpg" alt="Foresee demo video thumbnail" loading="lazy" />
              <span class="play-badge"><span class="play-icon" aria-hidden="true">▶</span> Watch demo ↗︎</span>
            </a>
            <div class="demo-showcase-copy">
              <p class="feature-kicker">Foresee</p>
              <h3>Forecasting near misses to focus fuzzing.</h3>
              <p>
                Foresee monitors nearby agents, classifies and ranks the riskiest ones, then clips
                and fuzzes the scenario around them—so testing time goes where failures are most
                likely to surface.
              </p>
              <a class="text-link" href={forecastingPaper.paper} target="_blank" rel="noreferrer">
                Read the paper <span aria-hidden="true">↗︎</span>
              </a>
            </div>
          </div>

          <div class="demo-showcase" data-reveal>
            <a
              class="video-frame watch-link"
              href="https://steflamb.github.io/videos/icst-final-demo.mp4"
              target="_blank"
              rel="noreferrer"
              aria-label="Watch the ICST 2024 talk recording"
            >
              <img src="/images/icst-final-poster.jpg" alt="ICST 2024 talk recording thumbnail" loading="lazy" />
              <span class="play-badge"><span class="play-icon" aria-hidden="true">▶</span> Watch demo ↗︎</span>
            </a>
            <div class="demo-showcase-copy">
              <p class="feature-kicker">ICST 2024</p>
              <h3>Do image-quality metrics track what actually matters?</h3>
              <p>
                A recording of the ICST 2024 talk on assessing quality metrics for neural
                reality-gap input mitigation—testing whether standard image-quality metrics track
                how neural image translation affects a driving system's perception and control.
              </p>
              <a class="text-link" href={qualityMetricsPaper.paper} target="_blank" rel="noreferrer">
                Read the paper <span aria-hidden="true">↗︎</span>
              </a>
            </div>
          </div>

          <div class="demo-showcase" data-reveal>
            <a
              class="video-frame watch-link"
              href="https://www.youtube.com/watch?v=pUGL1qu3Z1k"
              target="_blank"
              rel="noreferrer"
              aria-label="Watch the nano-drone relative localization demo video on YouTube"
            >
              <img src="https://img.youtube.com/vi/pUGL1qu3Z1k/hqdefault.jpg" alt="Nano-drone relative localization demo video thumbnail" loading="lazy" />
              <span class="play-badge"><span class="play-icon" aria-hidden="true">▶</span> Watch demo ↗︎</span>
            </a>
            <div class="demo-showcase-copy">
              <p class="feature-kicker">Before the reality gap</p>
              <h3>Fitting a neural network onto a 40-gram nano-drone.</h3>
              <p>
                Before autonomous cars, I worked on autonomous nano-drones. At the Dalle Molle
                Institute for Artificial Intelligence (IDSIA) in Lugano, I helped fit a
                relative-localization neural network onto a 40-gram nano-quadrotor: a single onboard
                camera and under 100 mW of power, enough to track a peer drone in real time
                (IEEE ICRA 2023). The platform changed; the question didn't: what has to be true for a
                learned model to work outside the lab it was trained in?
              </p>
              <a class="text-link" href="https://arxiv.org/abs/2303.01940" target="_blank" rel="noreferrer">
                Read the paper <span aria-hidden="true">↗︎</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-signal" aria-labelledby="open-heading">
      <div class="container-wide two-column-story">
        <aside class="story-aside" data-reveal>
          <p class="eyebrow">Research in the open</p>
        </aside>
        <div class="story-copy" data-reveal>
          <h2 id="open-heading" class="sr-only">Open research</h2>
          <p>
            A result is more valuable when someone else can interrogate it. The work is accompanied
            wherever possible by <strong>code, datasets, replication packages, and executable
            examples</strong>—from PerturbationDrive to Cam2Sim and vehicle-level artifacts.
          </p>
          <div class="hero-actions">
            <a class="button button-dark" href={profileLinks.researchGroup} target="_blank" rel="noreferrer">
              Browse open-source work
            </a>
            <a class="button button-dark" href="#publications">Read the papers</a>
          </div>
        </div>
      </div>
    </section>
  </div>

  <!-- ============ CHAPTER 03 — PUBLICATIONS ============ -->
  <div id="publications">
    <section class="page-hero page-hero-light publications-hero">
      <div class="page-hero-inner research-hero-grid container-wide">
        <div>
          <p class="eyebrow">03 — 2023–2026</p>
          <h1 class="page-title">Selected publications.</h1>
          <p class="page-hero-copy">
            Peer-reviewed papers, executable tools, and replication packages on the reality gap,
            robustness under perturbation, and reusing real driving data for simulation. A complete
            list is available on DBLP.
          </p>
          <div class="hero-actions">
            <a class="button-secondary" href={profileLinks.dblp} target="_blank" rel="noreferrer">
              DBLP profile
            </a>
          </div>
        </div>
        <div class="diagram-plate research-hero-image-full">
          <img
            src="/images/whatido.png"
            alt="Diagram of the sim-to-real testing approach: a scenario runs through both physics and perception, is measured against real behavior, and mitigations feed back into the system"
            width="2400"
            height="1104"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="section" aria-label="Selected publications">
      <div class="container-wide">
        <ol class="publications-list">
          {publications.map((publication) => (
            <li class="publication-row" data-reveal>
              <span class="publication-row-year">{publication.year}</span>
              <span class="publication-row-venue">{publication.venue}</span>
              <article class="publication-row-content">
                <h2>{publication.title}</h2>
                <p class="publication-authors">{publication.authors}</p>
                <p class="publication-summary">{publication.summary}</p>
                {publication.note && <p class="publication-note">{publication.note}</p>}
              </article>
              <div class="publication-links">
                <a href={publication.paper} target="_blank" rel="noreferrer">Paper ↗︎</a>
                {publication.code && (
                  <a href={publication.code} target="_blank" rel="noreferrer">Artifact ↗︎</a>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </div>

  <!-- ============ CHAPTER 04 — FORTUNA ============ -->
  <div id="fortuna">
    <section class="page-hero">
      <div class="page-hero-inner fortuna-hero-grid container-wide">
        <div>
          <p class="eyebrow">04 — Fortuna / full-scale research platform</p>
          <h1 class="page-title">A street-legal <em>research vehicle.</em></h1>
        </div>
        <div>
          <div class="fortuna-photo">
            <img
              src="/images/fortuna-profile.png"
              alt="Fortuna, fortiss's modified Passat GTE, with its roof-mounted camera and LiDAR sensor rack"
              width="775"
              height="435"
              loading="lazy"
            />
          </div>
          <div class="page-hero-copy">
            <p>
              When I started working with Fortuna in 2023, the vehicle had been inactive for more
              than a year. I took responsibility for bringing it back into operation. This involved
              reconstructing parts of the existing architecture and operating procedures, restoring
              the software and hardware components needed for autonomous driving, and gradually
              making the vehicle usable for research again.
            </p>
            <p>
              Today I lead the technical work around the vehicle. We use it for research on
              autonomous-driving testing, simulation, and real-world validation. Several students
              and researchers contribute to the platform and use it for their own work.
            </p>
            <div class="page-hero-meta">
              <span class="tag">2018 VW Passat Variant GTE</span>
              <span class="tag">Cameras + 3 LiDARs</span>
              <span class="tag">Drive-by-wire</span>
              <span class="tag">ROS</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="metrics-strip" aria-label="Fortuna platform summary">
      <div class="metric-card"><strong>2023</strong><span>Recovery and reintegration began</span></div>
      <div class="metric-card"><strong>48h+</strong><span>Real-world driving in the 2026 perturbation study</span></div>
      <div class="metric-card"><strong>Multiple</strong><span>Modular and end-to-end ADS architectures</span></div>
      <div class="metric-card"><strong>2</strong><span>Vehicle scales—a full-size Fortuna and a small-scale Donkey Car</span></div>
    </div>

    <section class="section section-dark" aria-labelledby="drive-heading">
      <div class="container-wide">
        <div class="section-heading" data-reveal>
          <p class="eyebrow eyebrow-light">Inside the vehicle</p>
          <div>
            <h2 id="drive-heading" class="display-title">Two ways to drive the same <em>car.</em></h2>
            <p class="section-lede">
              The driving stack can be an end-to-end model or a modular perception-planning-control
              pipeline. Bring your own laptop or PC, up to 1000 W, connect it over Ethernet, and
              start driving.
            </p>
          </div>
        </div>
        <div class="video-grid">
          <figure data-reveal>
            <a
              class="video-frame watch-link"
              href="https://steflamb.github.io/videos/fortuna-drive.mp4"
              target="_blank"
              rel="noreferrer"
              aria-label="Watch dashcam footage from inside Fortuna running an end-to-end driving model"
            >
              <img src="/images/fortuna-drive-poster.jpg" alt="End-to-end driving model dashcam footage thumbnail" loading="lazy" />
              <span class="play-badge"><span class="play-icon" aria-hidden="true">▶</span> Watch clip ↗︎</span>
            </a>
            <figcaption class="video-frame-caption">
              End-to-end model — camera in, steering and throttle out.
            </figcaption>
          </figure>
          <figure data-reveal>
            <a
              class="video-frame watch-link"
              href="https://steflamb.github.io/videos/fortuna-modular.mp4"
              target="_blank"
              rel="noreferrer"
              aria-label="Watch dashcam footage from inside Fortuna running a modular perception-planning-control pipeline"
            >
              <img src="/images/modular-poster.jpg" alt="Modular pipeline dashcam footage thumbnail" loading="lazy" />
              <span class="play-badge"><span class="play-icon" aria-hidden="true">▶</span> Watch clip ↗︎</span>
            </a>
            <figcaption class="video-frame-caption">
              Modular pipeline — perception, planning, and control as separate stages.
            </figcaption>
          </figure>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="platform-story-heading">
      <div class="container-wide story-centered" data-reveal>
        <p class="eyebrow">The platform</p>
        <h2 id="platform-story-heading" class="sr-only">The Fortuna platform</h2>
        <p>
          Fortuna is fortiss's full-size autonomous-driving research vehicle: a retrofitted,
          street-legal Volkswagen Passat Variant GTE with five cameras, three LiDARs providing
          360° coverage, precise localization, onboard compute, and real-time access to steering
          and acceleration through the vehicle gateway.
        </p>
        <p>
          We use it to run the same research question across offline models, hardware-in-the-loop
          setups, and a complete moving vehicle, then compare where the answer changes.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="breakdown-heading">
      <div class="container-wide">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">Inherited, recovered, changed</p>
          <div>
            <h2 id="breakdown-heading" class="display-title">What I actually did.</h2>
          </div>
        </div>
        <div class="theme-grid breakdown-grid">
          <article class="theme-card breakdown-card" data-reveal>
            <span class="theme-number">01</span>
            <h3>Inherited</h3>
            <p>
              Drive-by-wire actuation and control, the camera and LiDAR hardware, and the Apollo
              integration with GPS/IMU and the CAN bus—built for Providentia between 2016 and 2021.
            </p>
          </article>
          <article class="theme-card breakdown-card" data-reveal>
            <span class="theme-number">02</span>
            <h3>Recovered</h3>
            <p>
              In 2023, after more than a year of inactivity: reassessed every subsystem, restored
              communication paths, and made the vehicle inspectable and operable again.
            </p>
          </article>
          <article class="theme-card breakdown-card" data-reveal>
            <span class="theme-number">03</span>
            <h3>Changed since 2023</h3>
            <p>
              A ROS bridge alongside Apollo so any laptop or PC can drive the car over Ethernet,
              modular and end-to-end driving stacks, simulation integration, hardware-in-the-loop
              infrastructure, and the small-scale Donkey Car platform.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="timeline-heading">
      <div class="container-wide">
        <div class="section-heading" data-reveal>
          <p class="eyebrow">Recovery → research</p>
          <div>
            <h2 id="timeline-heading" class="display-title">From recovery to research.</h2>
            <p class="section-lede">
              Fortuna wasn't built for me. It was fortiss's automated-driving prototype for
              Providentia—then the project ended, and the car sat unused.
            </p>
          </div>
        </div>

        <ol class="timeline">
          <li class="timeline-item" data-reveal>
            <p class="timeline-year">2016–21</p><span class="timeline-dot" aria-hidden="true"></span>
            <div class="timeline-content">
              <h3>Built for Providentia</h3>
              <p>
                As fortiss's 5G-connected automated-vehicle prototype, Fortuna gathered data
                alongside roadside sensor infrastructure for Providentia, a project researching
                connected, automated driving on Germany's A9 digital motorway test bed near Munich.
                When the project ended in 2021, so did the car's job.
              </p>
            </div>
          </li>
          <li class="timeline-item" data-reveal>
            <p class="timeline-year">2023</p><span class="timeline-dot" aria-hidden="true"></span>
            <div class="timeline-content">
              <h3>Understand and recover</h3>
              <p>
                I assessed each inactive subsystem, restored communication paths, and made the
                vehicle inspectable and operable again.
              </p>
            </div>
          </li>
          <li class="timeline-item" data-reveal>
            <p class="timeline-year">2024–25</p><span class="timeline-dot" aria-hidden="true"></span>
            <div class="timeline-content">
              <h3>Rebuild it modular</h3>
              <p>
                Rather than restore the original single-purpose setup, I rebuilt Fortuna as a
                modular, ROS-based platform: the driving stack can simply be swapped, and so can
                the compute behind it—any laptop or PC up to 1000 W, connected over Ethernet. With
                students joining the project, we integrated modular and end-to-end driving stacks,
                sensor pipelines, and simulation.
              </p>
            </div>
          </li>
          <li class="timeline-item" data-reveal>
            <p class="timeline-year">2026</p><span class="timeline-dot" aria-hidden="true"></span>
            <div class="timeline-content">
              <h3>Test at full scale</h3>
              <p>
                For our ASE 2026 study, I compared 72 camera and LiDAR perturbations across offline
                analysis, hardware-in-the-loop execution, and closed-loop driving on Fortuna: more
                than 740 experiments and over 48 hours of autonomous driving.
              </p>
            </div>
          </li>
          <li class="timeline-item" data-reveal>
            <p class="timeline-year">NEXT</p><span class="timeline-dot" aria-hidden="true"></span>
            <div class="timeline-content">
              <h3>Turn fieldwork into shared infrastructure</h3>
              <p>
                I keep connecting physical drives to reproducible scenarios, open tools, student
                projects, and research questions the next team can build on.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <section class="architecture-panel" aria-labelledby="architecture-heading">
      <div class="container-wide">
        <div class="architecture-copy architecture-copy-wide" data-reveal>
          <p class="eyebrow">System anatomy</p>
          <h2 id="architecture-heading">Sensors, compute, and control.</h2>
          <ol class="architecture-key">
            <li><span>01</span> Cameras for visual perception and end-to-end driving</li>
            <li><span>02</span> Three LiDARs for 360° geometry, obstacles, and modular stacks</li>
            <li><span>03</span> RTK localization and onboard ROS compute</li>
            <li><span>04</span> Real-time drive-by-wire actuation and control</li>
          </ol>
        </div>
        <div class="fortuna-photo architecture-photo-wide" data-reveal>
          <img
            src="/images/fortuna-sensors-compute.png"
            alt="Fortuna's sensors (3x360 LiDAR, IMU/GNSS, 5x cameras, and drive-by-wire control) mapped to their onboard compute: an Nvidia Drive PX2 for cameras, i7/GTX1050Ti PCs for LiDAR and localization, and a dSpace MicroAutoBox II for control"
            width="1600"
            height="554"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="section section-dark" aria-labelledby="hw-logic-heading">
      <div class="container-wide architecture-layout">
        <div class="architecture-copy" data-reveal>
          <p class="eyebrow eyebrow-light">Hardware and logic</p>
          <h2 id="hw-logic-heading">Hardware and distributed computing pipeline.</h2>
          <p>
            The original platform ran on Apollo alone. I expanded it into a distributed system:
            camera and LiDAR drivers publish over ROS from an Nvidia Drive PX2 and a dedicated PC,
            Apollo still owns GPS/IMU, the CAN bus, and the real-time control interface that talks
            to the dSpace MicroAutoBox II, and everything meets over Ethernet. A bridge machine
            runs the ROS master alongside an Apollo/ROS adapter, so a separate "intelligence" node
            (the system under test, plus whatever extra tooling a given experiment needs) can
            subscribe to sensor data and publish control commands without touching Apollo directly.
          </p>
        </div>
        <div class="diagram-plate">
          <img
            src="/images/fortuna-hw-scheme.jpg"
            alt="Hardware and software architecture diagram: camera and LiDAR drivers on an Nvidia Drive PX2 and PC1 publish over ROS; GPS/IMU, CAN bus, and control drivers run inside Apollo on PC1 and send control commands to a dSpace MicroAutoBox II; all machines connect over Ethernet to PC2, which runs the ROS master and an Apollo/ROS adapter, exposing data and control to an Intelligence node running the system under test and extra auxiliary modules"
            width="1600"
            height="900"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="donkey-heading">
      <div class="container-wide architecture-layout">
        <div class="architecture-copy" data-reveal>
          <p class="eyebrow">The small-scale platform</p>
          <h2 id="donkey-heading">Donkey Car, Fortuna's <em>little brother.</em></h2>
          <p>
            Fortuna has a smaller sibling: a 1/16-scale Donkey Car with its own small-scale lab
            and a mixed-reality framework built around a digital twin of that lab. For our ASE
            2025 study, we used it to compare simulation, vehicle-in-the-loop, and mixed-reality
            testing against real driving—vehicle-in-the-loop reduced the actuation gap, and
            mixed-reality testing reduced the perception gap, compared to simulation alone.
          </p>
          <a class="text-link" href={realityGapPaper.paper} target="_blank" rel="noreferrer" style="margin-top: 1.5rem;">
            Read the ASE 2025 paper <span aria-hidden="true">↗︎</span>
          </a>
        </div>
        <div class="donkey-photo fortuna-photo" data-reveal>
          <img
            src="/images/donkey-car-crop.png"
            alt="The Donkey Car, a 1/16-scale research vehicle with an onboard camera and compute stack"
            width="464"
            height="431"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <section class="section section-dark" aria-labelledby="garage-teaser-heading">
      <div class="container-wide demo-showcase">
        <a class="video-frame watch-link" href="https://steflamb.github.io/garage/" target="_blank" rel="noreferrer" aria-label="Open the interactive 3D model of Fortuna">
          <img src="/images/fortuna-profile.png" alt="Fortuna, fortiss's modified Passat GTE" loading="lazy" />
          <span class="play-badge"><span class="play-icon" aria-hidden="true">⟲</span> Open the 3D model ↗︎</span>
        </a>
        <div class="demo-showcase-copy">
