---
// The paper a demo comes from, set apart from the demo itself.
import type { publications } from '../data/site';

interface Props {
  papers: (typeof publications)[number][];
}

const { papers } = Astro.props;
---

<aside class="paper-source" aria-label={papers.length > 1 ? 'Source papers' : 'Source paper'}>
  <p class="paper-source-label">{papers.length > 1 ? 'From the papers' : 'From the paper'}</p>
  {papers.map((paper) => (
    <div class="paper-source-item">
      <p class="paper-source-title">{paper.title}</p>
      <p class="paper-source-meta">{paper.venue} · {paper.year}</p>
      <p class="paper-source-links">
        <a href={paper.paper} target="_blank" rel="noreferrer">Paper <span aria-hidden="true">↗︎</span></a>
        {paper.code && (
          <a href={paper.code} target="_blank" rel="noreferrer">Code and data <span aria-hidden="true">↗︎</span></a>
        )}
      </p>
    </div>
  ))}
</aside>

<style>
  .paper-source {
    display: grid;
    gap: 1rem;
    margin-top: 1.6rem;
    padding: 1.1rem 1.2rem;
    border-left: 1px solid var(--ink);
    background: var(--paper-bright);
  }

  .paper-source-label {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .paper-source-item + .paper-source-item {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .paper-source-title {
    color: var(--ink);
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .paper-source-meta {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .paper-source-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .paper-source-links a {
    color: var(--ink);
    text-decoration-color: var(--signal);
    text-underline-offset: 0.25em;
  }

  .paper-source-links a:hover {
    color: var(--signal-ink);
  }
</style>
