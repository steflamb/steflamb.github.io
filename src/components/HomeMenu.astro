---
// The home page's top bar and full-screen menu, shared by every page.
import { navItems, profileLinks } from '../data/site';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<header class="hm-top" data-hm-top>
  <a class="hm-brand" href="/" aria-label="Stefano Carlo Lambertenghi, home">S. C. Lambertenghi</a>
  <div class="hm-right">
    <a
      class="hm-email"
      href="#"
      data-email-user={profileLinks.emailUser}
      data-email-domain={profileLinks.emailDomain}>Let's talk</a
    >
    <button type="button" class="hm-toggle" aria-expanded="false" aria-controls="hm-menu">Menu ☰</button>
  </div>
</header>

<nav class="hm-menu" id="hm-menu" aria-label="Primary" hidden>
  <ol>
    {
      navItems.map((item, i) => (
        <li>
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            <span>{String(i + 1).padStart(2, '0')}</span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ol>
  <ul class="hm-social">
    <li><a href={profileLinks.github} target="_blank" rel="noreferrer">&gt; GitHub</a></li>
    <li><a href={profileLinks.linkedin} target="_blank" rel="noreferrer">&gt; LinkedIn</a></li>
    <li><a href={profileLinks.scholar} target="_blank" rel="noreferrer">&gt; Scholar</a></li>
  </ul>
</nav>

<style is:global>
  .hm-top {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.4rem clamp(1rem, 2.5vw, 2rem);
    color: #fff;
    /* Difference blending keeps the bar legible over both light and dark pages. */
    mix-blend-mode: difference;
    pointer-events: none;
    font-family: 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    line-height: 1.55;
    text-transform: uppercase;
  }
  .hm-top a,
  .hm-top button {
    pointer-events: auto;
    color: inherit;
    text-decoration: none;
  }
  .hm-top button {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }
  .hm-right {
    display: flex;
    gap: 1.6rem;
  }
  .hm-top a:hover,
  .hm-top button:hover {
    opacity: 0.6;
  }
  .hm-menu {
    position: fixed;
    inset: 0;
    z-index: 90;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    overflow-y: auto;
    padding: 4.5rem clamp(1rem, 6vw, 6rem) 2rem;
    background: #06090c;
    color: #fff;
    font-family: 'IBM Plex Mono', ui-monospace, 'SFMono-Regular', Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .hm-menu[hidden] {
    display: none;
  }
  /* Centred when it fits, scrollable from the top when it does not. */
  .hm-menu > :first-child {
    margin-top: auto;
  }
  .hm-menu > :last-child {
    margin-bottom: auto;
  }
  .hm-menu ol,
  .hm-menu ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hm-menu a {
    color: inherit;
    text-decoration: none;
  }
  .hm-menu ol a {
    display: inline-block;
    padding: 0.25rem 0;
    font-size: clamp(1.2rem, min(4vw, 5.4vh), 2.6rem);
    letter-spacing: 0.02em;
  }
  .hm-menu ol a[aria-current='page'] {
    color: #ffcf33;
  }
  .hm-menu ol a span {
    margin-right: 1rem;
    font-size: 0.72rem;
    vertical-align: 0.9em;
    opacity: 0.5;
  }
  .hm-menu a:hover {
    opacity: 0.6;
  }
  .hm-social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2rem;
  }
  /* The bar stays reachable over the open menu. */
  body.hm-open .hm-top {
    mix-blend-mode: normal;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-hm-top]');
  const toggle = bar?.querySelector<HTMLButtonElement>('.hm-toggle');
  const menu = document.getElementById('hm-menu');
  const email = bar?.querySelector<HTMLAnchorElement>('.hm-email');
  const regions = document.querySelectorAll<HTMLElement>('main, .site-footer');

  if (email?.dataset.emailUser && email.dataset.emailDomain) email.href = `mailto:${email.dataset.emailUser}@${email.dataset.emailDomain}`;

  function setMenu(open: boolean, returnFocus = false) {
    if (!menu || !toggle) return;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.textContent = open ? 'Close ✕' : 'Menu ☰';
    document.body.classList.toggle('hm-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    regions.forEach((r) => (r.inert = open));
    if (open) menu.querySelector<HTMLAnchorElement>('a')?.focus();
    else if (returnFocus) toggle.focus();
  }
  toggle?.addEventListener('click', () => setMenu(menu?.hidden ?? false));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) {
      e.preventDefault();
      setMenu(false, true);
    }
  });
</script>
