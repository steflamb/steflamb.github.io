---
// PerturbationDrive's image perturbations, applied live to a chase camera following the
// 3D scan of Fortuna around a test track.
import { PERTURBATIONS } from './perturbations';

const groups = [...new Set(PERTURBATIONS.map((p) => p.group))].map((group) => ({
  group,
  items: PERTURBATIONS.filter((p) => p.group === group),
}));
---

<div class="demo-showcase lab-showcase" id="perturbation-lab">
  <div class="lab-stage">
    <canvas id="lab-canvas" aria-hidden="true"></canvas>
    <div class="lab-hud" id="lab-hud" data-playing="true" aria-hidden="true">
      <span class="lab-corner" data-corner="tl"></span>
      <span class="lab-corner" data-corner="tr"></span>
      <span class="lab-corner" data-corner="bl"></span>
      <span class="lab-corner" data-corner="br"></span>
      <p class="lab-readout" id="lab-readout">dynamic_rain_filter(scale=2)</p>
      <p class="lab-rec"><i></i><span id="lab-rec">REC</span> · CHASE CAM</p>
      <p class="lab-meter" id="lab-meter" data-scale="2">
        <span>SCALE</span>
        {[0, 1, 2, 3, 4].map((n) => <i data-n={n}></i>)}
      </p>
      <p class="lab-tc" id="lab-tc">00:00:00 · F 00000</p>
    </div>
    <p class="lab-loading" id="lab-loading">Loading the scan…</p>
    <p class="lab-fallback" id="lab-fallback" hidden>
      This demo needs WebGL, which your browser has turned off.
    </p>
  </div>

  <div class="demo-showcase-copy">
    <slot />

    <form class="lab-controls" id="lab-controls" aria-describedby="lab-note">
      <div class="lab-group">
        <label class="lab-label" for="lab-perturbation">
          Perturbation <span>{PERTURBATIONS.length} from the library</span>
        </label>
        <div class="lab-picker">
          <button type="button" class="lab-step" data-step="-1" aria-label="Previous perturbation">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <select id="lab-perturbation" name="perturbation">
            {groups.map(({ group, items }) => (
              <optgroup label={group}>
                {items.map((p) => (
                  <option value={p.id} selected={p.id === 'dynamic_rain_filter'}>
                    {p.label}{p.overlay ? ' *' : ''}
                  </option>
                ))}
              </optgroup>
            ))}
          </select>
          <button type="button" class="lab-step" data-step="1" aria-label="Next perturbation">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      </div>

      <div class="lab-row">
        <fieldset class="lab-group">
          <legend class="lab-label">Scale</legend>
          <div class="lab-options lab-scale">
            {[0, 1, 2, 3, 4].map((scale) => (
              <label><input type="radio" name="scale" value={scale} checked={scale === 2} /> <span><b style={`--h: ${(scale + 1) * 18}%`}></b>{scale}</span></label>
            ))}
          </div>
        </fieldset>
        <button type="button" class="lab-play" id="lab-play" aria-pressed="true">Pause</button>
      </div>

      <p class="lab-note" id="lab-note">
        Re-implemented as WebGL shaders from{' '}
        <a href="https://github.com/ast-fortiss-tum/perturbation-drive" target="_blank" rel="noreferrer">perturbationfuncs.py</a>,
        with its parameters for each scale. * Weather and light are rendered from the scene, with
        its depth and motion, instead of the library's recorded masks. Perturbations that need a
        trained model (attention regions, adversarial, generative) are not included.
      </p>
      <p class="sr-only" id="lab-status" aria-live="polite"></p>
    </form>

    <slot name="link" />
  </div>
</div>

<style>
  .lab-showcase {
    align-items: start;
  }

  .lab-stage {
    position: relative;
    overflow: hidden;
    aspect-ratio: 5 / 4;
    background: var(--ink);
  }

  .lab-stage canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The camera under test, framed like a monitor on a test bench. */
  .lab-hud {
    position: absolute;
    inset: 0;
    pointer-events: none;
    color: #ffcf33;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .lab-hud p {
    position: absolute;
    margin: 0;
    padding: 0.35rem 0.55rem;
    background: rgba(15, 23, 32, 0.78);
  }

  .lab-corner {
    position: absolute;
    width: 1.4rem;
    height: 1.4rem;
    border: 0 solid rgba(250, 250, 248, 0.85);
  }

  .lab-corner[data-corner='tl'] { top: 0.6rem; left: 0.6rem; border-width: 2px 0 0 2px; }
  .lab-corner[data-corner='tr'] { top: 0.6rem; right: 0.6rem; border-width: 2px 2px 0 0; }
  .lab-corner[data-corner='bl'] { bottom: 0.6rem; left: 0.6rem; border-width: 0 0 2px 2px; }
  .lab-corner[data-corner='br'] { right: 0.6rem; bottom: 0.6rem; border-width: 0 2px 2px 0; }

  .lab-readout {
    bottom: 1.2rem;
    left: 1.2rem;
    max-width: calc(100% - 12rem);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
  }

  .lab-rec {
    top: 1.2rem;
    left: 1.2rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--paper-bright);
  }

  .lab-rec i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #e5484d;
  }

  .lab-hud[data-playing='true'] .lab-rec i {
    animation: lab-blink 1.2s steps(1, end) infinite;
  }

  .lab-hud[data-playing='false'] .lab-rec i {
    background: var(--muted-dark);
  }

  @keyframes lab-blink {
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lab-hud[data-playing='true'] .lab-rec i {
      animation: none;
    }
  }

  .lab-meter {
    right: 1.2rem;
    bottom: 1.2rem;
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 1.9rem;
  }

  .lab-meter span {
    margin-right: 0.35rem;
    align-self: center;
    color: var(--paper-bright);
  }

  .lab-meter i {
    width: 0.4rem;
    background: rgba(250, 250, 248, 0.25);
  }

  .lab-meter i[data-n='0'] { height: 20%; }
  .lab-meter i[data-n='1'] { height: 40%; }
  .lab-meter i[data-n='2'] { height: 60%; }
  .lab-meter i[data-n='3'] { height: 80%; }
  .lab-meter i[data-n='4'] { height: 100%; }

  .lab-meter[data-scale='0'] i[data-n='0'],
  .lab-meter[data-scale='1'] i:is([data-n='0'], [data-n='1']),
  .lab-meter[data-scale='2'] i:is([data-n='0'], [data-n='1'], [data-n='2']),
  .lab-meter[data-scale='3'] i:not([data-n='4']),
  .lab-meter[data-scale='4'] i {
    background: #ffcf33;
  }

  .lab-tc {
    top: 1.2rem;
    right: 1.2rem;
    color: var(--paper-bright);
    font-variant-numeric: tabular-nums;
  }

  .lab-loading {
    position: absolute;
    left: 50%;
    top: 50%;
    padding: 0.4rem 0.6rem;
    background: rgba(15, 23, 32, 0.82);
    color: var(--paper-bright);
    font-family: var(--mono);
    font-size: 0.75rem;
    transform: translate(-50%, -50%);
  }

  .lab-loading[hidden] {
    display: none;
  }

  @media (max-width: 54rem) {
    .lab-stage {
      aspect-ratio: 1;
      width: min(100%, 58svh);
      margin-inline: auto;
    }

    .lab-controls {
      margin-top: 0;
    }

    /* The scale control right below says the same; the call gets the full width. */
    .lab-meter {
      display: none;
    }

    .lab-readout {
      max-width: calc(100% - 2.4rem);
    }
  }

  .lab-fallback {
    position: absolute;
    inset: auto 1rem 1rem;
    color: var(--muted-dark);
  }

  .lab-controls {
    display: grid;
    gap: 1.3rem;
    margin-top: 1.6rem;
  }

  .lab-group {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .lab-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6.5rem;
    gap: 0.8rem;
    align-items: end;
  }

  .lab-label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    margin-bottom: 0.6rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .lab-picker {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr) 2.75rem;
    gap: 0.4rem;
  }

  .lab-picker select,
  .lab-step,
  .lab-play,
  .lab-options span {
    min-height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
  }

  .lab-picker select {
    min-width: 0;
    padding: 0 0.75rem;
    background: var(--paper-bright);
    cursor: pointer;
  }

  .lab-step {
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .lab-step svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .lab-play {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper-bright);
    font-weight: 600;
    cursor: pointer;
  }

  .lab-play[aria-pressed='true'] {
    background: transparent;
    border-color: var(--line);
    color: var(--ink);
  }

  .lab-options {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.3rem;
  }

  .lab-options label {
    position: relative;
    cursor: pointer;
  }

  .lab-options input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .lab-options span {
    display: grid;
    place-items: center;
    font-family: var(--mono);
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .lab-options input:checked + span {
    border-color: var(--ink);
    background: var(--ink);
    color: #ffcf33;
  }

  /* Scale as a level meter: each step a taller bar, lit up to the chosen one. */
  .lab-scale span {
    position: relative;
    align-content: end;
    min-height: 3.6rem;
    padding-bottom: 0.3rem;
    font-size: 0.8rem;
  }

  .lab-scale b {
    position: absolute;
    right: 28%;
    bottom: 1.6rem;
    left: 28%;
    height: calc(var(--h) * 0.55);
    background: var(--line);
    transition: background-color 150ms ease;
  }

  .lab-scale label:has(~ label input:checked) b {
    background: var(--ink);
  }

  .lab-scale input:checked + span b {
    background: #ffcf33;
  }

  .lab-step:hover,
  .lab-picker select:hover,
  .lab-options label:hover span,
  .lab-play[aria-pressed='true']:hover {
    border-color: var(--ink);
  }

  .lab-picker select:focus-visible,
  .lab-step:focus-visible,
  .lab-play:focus-visible,
  .lab-options input:focus-visible + span {
    outline: 3px solid var(--signal);
    outline-offset: 3px;
  }

  .lab-note {
    font-size: 0.8rem !important;
  }

  .lab-note a {
    color: var(--ink);
    text-underline-offset: 0.2em;
  }
</style>

<script>
  import { onDemoStart } from './demo-start';
  const lab = document.getElementById('perturbation-lab');
  const stage = lab?.querySelector('.lab-stage') as HTMLElement | null;
  const canvas = document.getElementById('lab-canvas') as HTMLCanvasElement | null;
  const form = document.getElementById('lab-controls') as HTMLFormElement | null;

  function webglAvailable() {
    try {
      const probe = document.createElement('canvas');
      return !!(probe.getContext('webgl2') || probe.getContext('webgl'));
    } catch {
      return false;
    }
  }

  if (lab && stage && canvas && form) {
    if (!webglAvailable()) {
      form.hidden = true;
      document.getElementById('lab-loading')!.hidden = true;
      document.getElementById('lab-fallback')!.hidden = false;
    } else {
      // Fetch three.js and the scan only when the lab is about to be used.
      onDemoStart(lab, stage, (requested) => {
        import('./concept-lab').then(({ startPerturbationLab }) =>
          startPerturbationLab({ stage, canvas, form, autoplay: requested }),
        );
      });
    }
  }
</script>
