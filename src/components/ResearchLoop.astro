---
import { publications } from '../data/site';

const cam2simRepo = publications.find((p) => p.title.startsWith('Cam2Sim'))!.code!;
const perturbationStudyPaper = publications.find((p) => p.title.startsWith('Real-World Perturbation Testing'))!;
const perturbationBenchmarkPaper = publications.find((p) => p.title.startsWith('Benchmarking Image Perturbations'))!;
const forecastingPaper = publications.find((p) => p.title.startsWith('Misbehavior Forecasting'))!;

const steps = [
  {
    index: '01',
    title: 'Deploy & observe',
    copy: 'Run the complete stack on the physical vehicle and see how it behaves.',
    videos: [
      {
        src: '/videos/fortuna-drive.mp4',
        poster: '/images/fortuna-drive-poster.jpg',
        label: 'Dashcam footage from inside Fortuna during a closed-loop test drive in Munich',
      },
    ],
  },
  {
    index: '02',
    title: 'Reconstruct',
    copy: 'Bring the real scenario back into simulation.',
    link: { href: cam2simRepo, label: 'Cam2Sim on GitHub' },
    videos: [
      {
        src: '/videos/cam2sim-demo.mp4',
        poster: '/images/demo-comparison-poster.jpg',
        label: 'Side-by-side comparison of a Cam2Sim CARLA reconstruction and the same scenario rendered through Gaussian Splatting',
        caption: 'Left: the CARLA reconstruction. Right: rendered through Gaussian Splatting.',
        wide: true,
      },
    ],
  },
  {
    index: '03',
    title: 'Stress',
    copy: 'Perturb inputs and focus testing around near misses.',
    link: { href: forecastingPaper.paper, label: 'Read the ICSE 2026 paper' },
    videos: [
      {
        src: '/videos/perturbationdrive-demo.mp4',
        poster: '/images/perturbationdrive-poster.jpg',
        label: 'Talk recording demonstrating PerturbationDrive, a tool that injects camera perturbations such as rain across multiple simulators',
        caption: 'PerturbationDrive: the same perturbation, applied across any simulator.',
      },
      {
        src: '/videos/foresee-demo.mp4',
        poster: '/images/foresee-poster.jpg',
        label: 'Talk recording explaining Foresee, a misbehavior-forecasting pipeline that monitors, classifies, ranks, clips, and fuzzes near-miss scenarios',
        caption: 'Foresee: forecasting near misses to focus fuzzing where failures are most likely.',
      },
    ],
    links: [
      { href: perturbationBenchmarkPaper.paper, label: 'ICST 2025 paper' },
      { href: forecastingPaper.paper, label: 'ICSE 2026 paper' },
      { href: perturbationStudyPaper.paper, label: 'ASE 2026 paper' },
    ],
  },
  {
    index: '04',
    title: 'Deploy',
    copy: 'Redeploy on the vehicle, and the loop starts again.',
  },
];
---

<ol class="research-loop" aria-label="Research loop">
  {steps.map((step) => (
    <li data-reveal>
      <div class="loop-row">
        <div class="loop-index">{step.index}</div>
        <div>
          <h3>{step.title}</h3>
          <p>{step.copy}</p>
        </div>
        {step.link && (
          <a class="loop-arrow" href={step.link.href} target="_blank" rel="noreferrer" aria-label={step.link.label}>→</a>
        )}
      </div>
      {(step.videos || step.placeholder) && (
        <div class="loop-media">
          {step.videos && (
            <div class:list={['loop-video-list', { 'loop-video-grid': step.videos.length > 1 }]}>
              {step.videos.map((video) => (
                <div>
                  <div class="video-frame" style={video.wide ? 'aspect-ratio: 1600 / 502;' : undefined}>
                    <video
                      src={video.src}
                      poster={video.poster}
                      controls
                      muted
                      playsinline
                      preload="none"
                      style={video.wide ? 'object-fit: contain;' : undefined}
                      aria-label={video.label}
                    ></video>
                  </div>
                  {video.caption && <p class="video-frame-caption">{video.caption}</p>}
                </div>
              ))}
            </div>
          )}
          {step.placeholder && (
            <div class="loop-media-placeholder" aria-hidden="true">
              <span>{step.placeholder}</span>
            </div>
          )}
          {step.links && (
            <p class="video-frame-caption loop-links">
              {step.links.map((l, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={l.href} target="_blank" rel="noreferrer">{l.label} ↗</a>
                </>
              ))}
            </p>
          )}
        </div>
      )}
    </li>
  ))}
</ol>
