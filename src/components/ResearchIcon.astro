---
// The research icons. Measure and Mitigate are redrawn from the hero diagram (whatido.png);
// Understand and Infrastructure are drawn to match: thick rounded strokes, no fill.
interface Props {
  name: 'measure' | 'understand' | 'mitigate' | 'infrastructure';
  class?: string;
}
const { name, class: className } = Astro.props;
---

<svg
  class:list={['research-icon', className]}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="4.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'measure' && (
    <g transform="rotate(-30 24 24)">
      <rect x="4" y="15" width="40" height="18" rx="2.5" />
      <path d="M11 33v-5M17 33v-8M23 33v-5M29 33v-8M35 33v-5" stroke-width="3.5" />
    </g>
  )}
  {name === 'understand' && (
    <>
      <circle cx="20" cy="20" r="12" />
      <path d="M29 29l12 12" />
    </>
  )}
  {name === 'mitigate' && (
    <>
      <path d="M41 7L28 20M28 10v10h10" />
      <path d="M7 41l13-13M10 28h10v10" />
    </>
  )}
  {name === 'infrastructure' && (
    <>
      <path d="M24 7l17 8.5L24 24 7 15.5z" />
      <path d="M7 24l17 8.5L41 24" />
      <path d="M7 32.5L24 41l17-8.5" />
    </>
  )}
</svg>
