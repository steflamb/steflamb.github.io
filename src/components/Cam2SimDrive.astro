---
// Cam2Sim, interactive: drive a simple simulator on the recorded street while the
// Gaussian-splat reconstruction renders the car's camera view beside it.
---

<div class="demo-showcase c2s" id="cam2sim-drive">
  <div class="c2s-stage" id="c2s-stage" tabindex="0" aria-describedby="c2s-hint">
    <div class="c2s-panes">
      <figure class="c2s-pane">
        <canvas id="c2s-sim" aria-hidden="true"></canvas>
        <figcaption>Simulator</figcaption>
        <small class="c2s-attribution">
          Map data ©{' '}
          <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap contributors</a>
        </small>
      </figure>
      <figure class="c2s-pane" id="c2s-splat-pane">
        <canvas id="c2s-splat" aria-hidden="true"></canvas>
        <figcaption>Generated camera</figcaption>
      </figure>
      <div class="c2s-touch" aria-hidden="true">
        <button type="button" tabindex="-1" data-control="left">
          <svg viewBox="0 0 24 24" width="20" height="20"><path d="M15 5l-7 7 7 7" /></svg>
        </button>
        <button type="button" tabindex="-1" data-control="back">
          <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 9l7 7 7-7" /></svg>
        </button>
        <button type="button" tabindex="-1" data-control="forward">
          <svg viewBox="0 0 24 24" width="20" height="20"><path d="M5 15l7-7 7 7" /></svg>
        </button>
        <button type="button" tabindex="-1" data-control="right">
          <svg viewBox="0 0 24 24" width="20" height="20"><path d="M9 5l7 7-7 7" /></svg>
        </button>
      </div>
      <p class="c2s-link" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="14" height="14"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        <span>Gaussian splats</span>
      </p>
    </div>

    <div class="c2s-route" aria-hidden="true">
      <span class="c2s-route-name">Guerickestraße</span>
      <div class="c2s-route-track" id="c2s-route-track">
        <i class="c2s-route-car" id="c2s-route-car"></i>
      </div>
      <span class="c2s-route-m" id="c2s-route-m">— m</span>
    </div>

    <div class="c2s-start" id="c2s-start">
      <p class="c2s-start-title">Guerickestraße, rebuilt in three splat segments</p>
      <button type="button" class="c2s-load" id="c2s-load">Load the drive</button>
      <p>About 8–16 MB per segment, loaded one at a time as you drive.</p>
    </div>

  </div>

  <div class="demo-showcase-copy c2s-copy">
    <div>
      <slot />
    </div>
    <div class="c2s-controls">
      <p class="c2s-status" id="c2s-status" aria-live="polite">Not loaded yet.</p>
      <button type="button" class="c2s-auto" id="c2s-autopilot" aria-pressed="false" disabled>Autopilot</button>
      <p class="c2s-hint" id="c2s-hint">
        Click the scene, then drive with the arrow keys or WASD. On a phone, use the buttons.
        The car stays near the recorded path, where the reconstruction has views to draw from.
        The small inset is the nearest recorded camera frame.
      </p>
      <slot name="link" />
    </div>
  </div>
</div>

<style>
  .c2s {
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .c2s-stage {
    position: relative;
    display: grid;
    background: var(--ink);
    outline: none;
  }

  .c2s-stage:focus-visible {
    outline: 3px solid var(--signal);
    outline-offset: 4px;
  }

  .c2s-panes {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }

  .c2s-pane {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #1a1d1b;
  }

  .c2s-pane canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  .c2s-pane figcaption {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    display: flex;
    gap: 0.5rem;
    padding: 0.35rem 0.55rem;
    background: rgba(15, 23, 32, 0.82);
    color: var(--paper-bright);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  #c2s-splat-pane figcaption {
    color: #ffcf33;
  }

  .c2s-attribution {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 0.2rem 0.45rem;
    background: rgba(250, 250, 248, 0.85);
    color: var(--ink);
    font-size: 0.6875rem;
  }

  .c2s-attribution a {
    color: inherit;
  }

  .c2s-pane :global(.c2s-recorded) {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    width: 30%;
    height: auto;
    border: 2px solid rgba(250, 250, 248, 0.7);
  }

  /* The pipeline step between the two views: the simulator pose goes in, splats render it. */
  .c2s-link {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    padding: 0.4rem 0.65rem;
    border: 1px solid #ffcf33;
    background: var(--ink);
    color: #ffcf33;
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    transform: translate(-50%, -50%);
  }

  .c2s-link svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Where the car is along the recorded street, and which reconstruction segment draws it. */
  .c2s-route {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) 4.5rem;
    align-items: center;
    gap: 0.9rem;
    padding: 0.7rem 0.9rem;
    color: var(--paper-bright);
    font-family: var(--mono);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .c2s-route-name {
    text-transform: uppercase;
  }

  .c2s-route-m {
    color: #ffcf33;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .c2s-route-track {
    position: relative;
    height: 1.25rem;
    border-bottom: 1px solid rgba(250, 250, 248, 0.35);
  }

  .c2s-route-track :global(.c2s-seg) {
    position: absolute;
    height: 3px;
    background: rgba(250, 250, 248, 0.18);
    transition: background-color 200ms ease;
  }

  .c2s-route-track :global(.c2s-seg[data-state='loaded']) {
    background: rgba(250, 250, 248, 0.6);
  }

  .c2s-route-track :global(.c2s-seg[data-state='active']) {
    background: #ffcf33;
  }

  .c2s-route-track :global(.c2s-seg span) {
    position: absolute;
    bottom: 4px;
    left: 0;
    color: var(--muted-dark);
    font-size: 0.5625rem;
  }

  .c2s-route-track :global(.c2s-seg[data-state='active'] span) {
    color: #ffcf33;
  }

  .c2s-route-car {
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--paper-bright);
    box-shadow: 0 0 0 2px var(--ink);
    transform: translateX(-50%);
  }

  .c2s-start {
    position: absolute;
    z-index: 3;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.8rem;
    background: rgba(15, 23, 32, 0.72);
    color: var(--paper-bright);
    text-align: center;
  }

  .c2s-start[hidden] {
    display: none;
  }

  .c2s-start p {
    max-width: 30rem;
    padding-inline: 1rem;
    color: #c9ced3;
    font-size: 0.85rem;
  }

  .c2s-stage:has(.c2s-start:not([hidden])) .c2s-link {
    display: none;
  }


  .c2s-start .c2s-start-title {
    margin-bottom: 0.4rem;
    color: var(--paper-bright);
    font-family: var(--display);
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    font-weight: 600;
    line-height: 1.05;
  }

  .c2s-load,
  .c2s-auto {
    min-height: 2.75rem;
    padding: 0 1.2rem;
    border: 1px solid var(--ink);
    border-radius: 0;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .c2s-load {
    border-color: #ffcf33;
    background: #ffcf33;
    color: var(--ink);
  }

  .c2s-auto {
    background: var(--ink);
    color: var(--paper-bright);
  }

  .c2s-auto[aria-pressed='true'] {
    background: transparent;
    color: var(--ink);
  }

  .c2s-auto:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .c2s-load:focus-visible,
  .c2s-auto:focus-visible {
    outline: 3px solid var(--signal);
    outline-offset: 3px;
  }

  .c2s-copy {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
  }

  .c2s-copy > * {
    min-width: 0;
  }

  .c2s-controls {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }

  .c2s-status {
    color: var(--ink) !important;
    font-family: var(--mono);
    font-size: 0.75rem !important;
  }

  .c2s-hint {
    font-size: 0.8rem !important;
  }

  .c2s-touch {
    display: none;
  }

  @media (hover: none) and (pointer: coarse) {
    .c2s-touch {
      position: absolute;
      right: 0.6rem;
      bottom: 0.6rem;
      left: 0.6rem;
      display: flex;
      justify-content: space-between;
      pointer-events: none;
    }

    .c2s-touch button {
      display: grid;
      width: 3rem;
      height: 3rem;
      place-items: center;
      border: 1px solid rgba(250, 250, 248, 0.5);
      border-radius: 50%;
      background: rgba(15, 23, 32, 0.6);
      color: var(--paper-bright);
      pointer-events: auto;
      touch-action: none;
    }

    .c2s-touch svg {
      fill: none;
      stroke: currentColor;
      stroke-width: 2;
      stroke-linecap: round;
    }
  }

  @media (max-width: 54rem) {
    .c2s-panes {
      grid-template-columns: 1fr;
    }

    .c2s-panes {
      width: min(100%, 27svh * 16 / 9);
      margin-inline: auto;
    }

    .c2s-pane {
      aspect-ratio: 16 / 9;
    }

    /* Stacked, the pipeline step gets its own strip between the two views. */
    .c2s-panes {
      gap: 2.2rem;
    }

    .c2s-link {
      padding: 0.25rem 0.55rem;
      font-size: 0.625rem;
    }

    .c2s-link svg {
      transform: rotate(90deg);
    }

    .c2s-pane :global(.c2s-recorded) {
      top: 0.8rem;
      bottom: auto;
      width: 28%;
    }

    .c2s-route {
      grid-template-columns: minmax(0, 1fr) 4rem;
    }

    .c2s-route-name {
      display: none;
    }

    .c2s-copy {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const root = document.getElementById('c2s-stage');
  const load = document.getElementById('c2s-load') as HTMLButtonElement | null;
  const status = document.getElementById('c2s-status');
  const autopilot = document.getElementById('c2s-autopilot') as HTMLButtonElement | null;

  function webglAvailable() {
    try {
      const probe = document.createElement('canvas');
      return !!probe.getContext('webgl2');
    } catch {
      return false;
    }
  }

  if (root && load && status && autopilot) {
    if (!webglAvailable()) {
      load.disabled = true;
      status.textContent = 'This demo needs WebGL 2, which your browser has turned off.';
    }
    load.addEventListener('click', async () => {
      load.disabled = true;
      load.textContent = 'Loading…';
      if (window.matchMedia('(max-width: 54rem), (pointer: coarse)').matches) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        root.closest('.demo-showcase')?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      }
      status.textContent = 'Loading the renderer…';
      try {
        const { startCam2SimDrive } = await import('./cam2sim-drive');
        // The nearest recorded camera frame, shown as an inset for comparison.
        const recorded = document.createElement('img');
        recorded.className = 'c2s-recorded';
        recorded.alt = '';
        recorded.width = 800;
        recorded.height = 458;
        await startCam2SimDrive({
          root,
          simCanvas: document.getElementById('c2s-sim') as HTMLCanvasElement,
          splatCanvas: document.getElementById('c2s-splat') as HTMLCanvasElement,
          recorded,
          status,
          autopilot,
          // The visitor pressed Load, so start driving straight away.
          autoplay: true,
        });
        document.getElementById('c2s-splat-pane')!.append(recorded);
        document.getElementById('c2s-start')!.hidden = true;
        autopilot.disabled = false;
        root.focus({ preventScroll: true });
      } catch (error) {
        console.error(error);
        status.textContent = 'The drive could not be loaded. Try reloading the page.';
        load.disabled = false;
        load.textContent = 'Try again';
      }
    });
  }
</script>
