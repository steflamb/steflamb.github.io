---
import { navItems, profileLinks } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-main container-wide">
    <div class="footer-statement">
      <p class="eyebrow eyebrow-light">Get in touch</p>
      <p class="footer-heading">Questions about the research, the vehicle, or working together?</p>
      <a class="text-link text-link-light" href={profileLinks.email}>
        Send me an email <span aria-hidden="true">↗︎</span>
      </a>
    </div>

    <div class="footer-directory">
      <div>
        <p class="footer-label">Explore</p>
        <ul>
          {navItems.slice(1, 5).map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="footer-label">Elsewhere</p>
        <ul>
          <li><a href={profileLinks.github} target="_blank" rel="noreferrer">GitHub ↗︎</a></li>
          <li><a href={profileLinks.dblp} target="_blank" rel="noreferrer">DBLP ↗︎</a></li>
          <li><a href={profileLinks.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗︎</a></li>
        </ul>
      </div>
    </div>
  </div>
  <div class="footer-meta container-wide">
    <p>© {year} Stefano Carlo Lambertenghi</p>
    <p>Designed around the work, built without tracking.</p>
  </div>
</footer>
